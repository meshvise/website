---
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';
import LiveTable from './LiveTable.astro';
import TrendBackground from './bg/TrendBackground.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="relative overflow-hidden bg-surface border-b border-line isolate">
  <TrendBackground />
  <div class="wrap relative pt-20 pb-14 md:pt-28 md:pb-20">
    <h1 class="t-hero max-w-[26ch]">{t(lang, 'home.hero.title')}</h1>
    <p class="t-lede mt-6">{t(lang, 'home.hero.subtitle')}</p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <a href={href(lang, 'demo')} class="btn btn-primary btn-lg">{t(lang, 'common.cta_demo')}</a>
      <a href={href(lang, 'why', 'calc')} class="btn btn-outline btn-lg">{t(lang, 'common.cta_calc')}</a>
    </div>
  </div>
</section>

<section class="wrap py-14 md:py-20">
  <p class="t-small mb-3">{t(lang, 'home.live.caption')}</p>
  <LiveTable lang={lang} />
</section>
