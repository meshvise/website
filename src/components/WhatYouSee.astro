---
/**
 * Ce que vous gérez avec Meshvise.
 *
 * Six fonctionnalités, chacune illustrée par une figure animée. Les
 * captures d'écran du produit sont sur la page Produit : l'accueil donne
 * envie, la page Produit montre l'outil. Une capture de formulaire d'alarme
 * prouve que le formulaire existe ; une broche qui dérive pendant trente
 * jours puis franchit son seuil dit pourquoi on en a besoin.
 *
 * Cinq figures viennent de la série préparée sur `/preview-motion/`, une a
 * été faite pour cette section, faute de scénario qui parle de tableaux de
 * bord :
 *
 *   acquisition    V-05  treize protocoles, un seul moteur
 *   historisation  V-06  la chaîne de la donnée, gardée pendant la coupure
 *   alarmes        V-01  la broche qui franchit le seuil ISO 10816
 *   tableaux       V-07  un tableau de bord livré qui se remplit
 *   indicateurs    V-02  le talon nocturne de l'air comprimé, en euros
 *   traçabilité    V-04  la salve d'alarmes et les deux révisions qui la bornent
 *
 * V-03, la valeur figée, est écartée : elle promet que le produit repère une
 * source qui se tait, ce que l'audit du 2026-09-15 contredit encore.
 *
 * Ce qui n'est pas écrit ici l'est volontairement, d'après le même registre :
 * aucune commande vers le procédé (AUD-001), aucune garantie sur la qualité
 * des mesures, ni TRS, ni « disponibilité » (sans horaires d'ouverture c'est
 * un taux de marche), ni années d'historique.
 *
 * La forme : la liste à gauche, la figure à droite, sans avance automatique.
 * Les six phrases restent toutes lisibles sans cliquer ; la page porte déjà
 * un carrousel (les métiers), un troisième mouvement ferait un accueil qui
 * ne tient jamais en place. Choisir une fonctionnalité rejoue sa figure
 * depuis le début : une figure jouée pendant qu'elle était cachée arriverait
 * sinon déjà finie. Sous 1024 px, chaque figure suit sa phrase et
 * `observe.ts` la rejoue quand elle entre dans l'écran.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import { t, type Lang } from '../i18n';

import ProtocolEngineStrip from './motion/ProtocolEngineStrip.astro';
import DataChainStrip from './motion/DataChainStrip.astro';
import SpindleWearStrip from './motion/SpindleWearStrip.astro';
import DashboardStrip from './motion/DashboardStrip.astro';
import AirLeakStrip from './motion/AirLeakStrip.astro';
import TightThresholdStrip from './motion/TightThresholdStrip.astro';

interface Props {
  lang: Lang;
}

/** Indexées par identifiant : réordonner le dictionnaire ne décale pas les figures. */
const FIGURES = {
  acquisition: ProtocolEngineStrip,
  historisation: DataChainStrip,
  alarmes: SpindleWearStrip,
  tableaux: DashboardStrip,
  indicateurs: AirLeakStrip,
  revisions: TightThresholdStrip,
} as const;

const { lang } = Astro.props;
const dict = (lang === 'fr' ? fr : en).home.see;
const features = dict.features as {
  id: keyof typeof FIGURES;
  title: string;
  body: string;
}[];
---

<section id="fonctionnalites" class="section bg-surface border-y border-line">
  <div class="wrap">
    <div class="section-head">
      <h2 class="t-page">{t(lang, 'home.see.title')}</h2>
    </div>

    <div class="feat" data-feat aria-label={dict.aria} role="group">
      {features.map((f, i) => {
        const Figure = FIGURES[f.id];
        return (
          <div class="item" style={`--row: ${i + 1}`}>
            <div class:list={['text', i === 0 && 'is-on']}>
              <h3 class="name">
                <button
                  type="button"
                  class="pick"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-controls={`feat-fig-${i}`}
                >
                  {f.title}
                </button>
              </h3>
              <p class="body">{f.body}</p>
            </div>
            <div id={`feat-fig-${i}`} class:list={['shot', i === 0 && 'is-on']}>
              {f.id === 'revisions' ? <Figure lang={lang} revisions /> : <Figure lang={lang} />}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  /**
   * Le HTML arrive dans son état de départ, la première fonctionnalité
   * sélectionnée : le script ne fait que déplacer la sélection, et rejouer
   * la figure qu'il découvre.
   */
  const calme = window.matchMedia('(prefers-reduced-motion: reduce)');

  function rejouer(el: HTMLElement) {
    if (calme.matches || typeof el.getAnimations !== 'function') return;
    for (const animation of el.getAnimations({ subtree: true })) {
      animation.currentTime = 0;
      animation.play();
    }
  }

  document.querySelectorAll<HTMLElement>('[data-feat]').forEach((feat) => {
    const boutons = Array.from(feat.querySelectorAll<HTMLButtonElement>('.pick'));
    const textes = Array.from(feat.querySelectorAll<HTMLElement>('.text'));
    const figures = Array.from(feat.querySelectorAll<HTMLElement>('.shot'));

    function montrer(i: number) {
      boutons.forEach((b, n) => b.setAttribute('aria-pressed', n === i ? 'true' : 'false'));
      textes.forEach((el, n) => el.classList.toggle('is-on', n === i));
      figures.forEach((el, n) => el.classList.toggle('is-on', n === i));
      rejouer(figures[i]);
    }

    boutons.forEach((b, i) => b.addEventListener('click', () => montrer(i)));
  });
</script>

<style>
  .feat { margin-top: 0.5rem; }

  .name {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .pick {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: left;
  }
  .body {
    margin: 0.3rem 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  /* Sous 1024 px : chaque figure suit sa phrase, rien à choisir. */
  @media (max-width: 1023px) {
    .item + .item { margin-top: 3rem; }
    .shot { margin-top: 1.5rem; }
    .pick { cursor: default; }
  }

  /* À partir de 1024 px : la liste à gauche, la figure à droite. Les items
     s'effacent de la grille pour que textes et figures en soient enfants
     directs : chaque texte prend sa ligne, les six figures s'empilent dans
     la même zone de la seconde colonne, et la scène prend la hauteur de la
     plus haute sans jamais sauter. */
  @media (min-width: 1024px) {
    .feat {
      display: grid;
      grid-template-columns: minmax(0, 4.5fr) minmax(0, 7.5fr);
      grid-template-rows: repeat(6, auto) 1fr;
      column-gap: 4.5rem;
    }
    .item { display: contents; }

    .text {
      grid-column: 1;
      grid-row: var(--row);
      position: relative;
      padding: 0.8rem 0 0.8rem 1.25rem;
      border-left: 2px solid var(--color-line);
      transition: border-color 180ms ease;
    }
    .text:hover { border-left-color: var(--color-line-strong); }
    .text.is-on { border-left-color: var(--color-accent); }

    /* Toute la ligne est cliquable, le bouton reste la cible du clavier et
       des lecteurs d'écran. */
    .pick { cursor: pointer; }
    .pick::after {
      content: '';
      position: absolute;
      inset: 0;
    }
    .pick:focus-visible { outline: none; }
    .text:has(.pick:focus-visible) {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
      border-radius: 2px;
    }

    .text:not(.is-on) .name { color: var(--color-ink-2); }
    .text:not(.is-on) .body { color: var(--color-muted); }

    .shot {
      grid-column: 2;
      grid-row: 1 / -1;
      /* Les figures n'ont pas la même hauteur : chacune se centre sur la
         liste, l'écart se partage au lieu de s'accumuler sous elle. */
      align-self: center;
      visibility: hidden;
    }
    .shot.is-on { visibility: visible; }
  }

  @media (prefers-reduced-motion: reduce) {
    .text { transition: none; }
  }
</style>
