---
/**
 * Une capture du produit dans son cadre : une fenêtre d'application nue,
 * trois pastilles et rien d'autre (ni barre d'adresse, ni onglets : c'est
 * l'écran qui doit se voir). Le même cadre sur l'accueil et sur la page
 * Produit, pour que les captures se reconnaissent d'une page à l'autre.
 *
 * Sans `shot`, le cadre réserve la place : un emplacement neutre au format
 * 16:10 des captures, qui dit ce qui viendra, pour que la page ne bouge pas
 * le jour où l'image arrive.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  shot?: ImageMetadata;
  alt: string;
  /** Texte de l'emplacement réservé, quand il n'y a pas encore de capture. */
  pending?: string;
  sizes?: string;
  eager?: boolean;
}

const {
  shot,
  alt,
  pending = '',
  sizes = '(max-width: 1023px) 100vw, 720px',
  eager = false,
} = Astro.props;
---

<figure class="fenetre">
  <div class="barre" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  {shot ? (
    <Image
      src={shot}
      alt={alt}
      class="capture"
      widths={[720, 1280, 1920]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <div class="attente" role="img" aria-label={alt}>
      <svg class="icone" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <rect x="5" y="9" width="38" height="30" rx="4" />
        <path d="M5 16 H43" />
        <path d="M13 32 L20 24 L26 29 L35 20" />
      </svg>
      <p>{pending}</p>
    </div>
  )}
</figure>

<style>
  .fenetre {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    box-shadow:
      0 2px 4px rgb(22 27 35 / 0.06),
      0 30px 60px -30px rgb(22 27 35 / 0.35);
  }
  .barre {
    display: flex;
    gap: 7px;
    align-items: center;
    height: 2.25rem;
    padding-inline: 1rem;
    background: var(--color-n-100);
    border-bottom: 1px solid var(--color-line);
  }
  .barre span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-n-300);
  }
  .capture { display: block; width: 100%; height: auto; }

  .attente {
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 1rem;
    border: 2px dashed var(--color-n-300);
    border-radius: 8px;
    color: var(--color-n-500);
  }
  .attente p { margin: 0; font-size: 1rem; font-weight: 500; text-align: center; padding-inline: 1rem; }
  .icone {
    width: 3rem;
    height: 3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
