---
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';

interface Props {
  lang: Lang;
  title?: string;
  body?: string;
}

const { lang, title = t(lang, 'home.final.title'), body = t(lang, 'home.final.body') } = Astro.props;
---

<section class="section dark-block relative overflow-hidden">
  <!-- Une courbe en négatif, en bas à droite, comme un écran de salle de contrôle -->
  <svg class="absolute right-0 bottom-0 w-[60%] h-[70%] -z-10 pointer-events-none" viewBox="0 0 800 300" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 240 C80 230 120 180 200 190 S320 120 400 140 S520 200 600 180 S720 90 800 110 L800 300 L0 300 Z" fill="var(--color-n-0)" opacity="0.035"/>
    <path d="M0 240 C80 230 120 180 200 190 S320 120 400 140 S520 200 600 180 S720 90 800 110" fill="none" stroke="var(--color-info)" stroke-width="2" opacity="0.35"/>
  </svg>
  <div class="wrap relative grid md:grid-cols-12 gap-8 items-end">
    <div class="md:col-span-8">
      <h2 class="t-page">{title}</h2>
      <p class="t-lede mt-4">{body}</p>
    </div>
    <div class="md:col-span-4 md:justify-self-end">
      <a href={href(lang, 'demo')} class="btn btn-primary btn-lg">{t(lang, 'common.cta_demo')}</a>
    </div>
  </div>
</section>
