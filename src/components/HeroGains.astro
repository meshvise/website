---
/**
 * L'accroche de l'accueil : un gain nommé, et la ligne qui le rend vrai.
 *
 * « Réactivité », « compréhension », « connaissance » sont les mots de
 * n'importe quelle plaquette de supervision. Seuls, ils n'engagent personne.
 * Chacun arrive donc avec sa preuve, tirée d'une fonction livrée, ce qu'un
 * concurrent qui ne l'a pas ne peut pas écrire.
 *
 * Deux piles superposées, les mots et les preuves, avancent sur les mêmes
 * retards : une seule horloge, aucun script. Sous `prefers-reduced-motion`
 * les cinq paires se lisent l'une sous l'autre, sans mouvement.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const gains = (lang === 'fr' ? fr : en).home.hero.gains as { word: string; proof: string }[];
---

<div class="hg">
  <h1 class="t-hero">
    <span class="hg-lead">{t(lang, 'home.hero.title')}</span>
    <span class="hg-stack hg-words">
      {gains.map((g) => <span class="hg-item">{g.word}</span>)}
    </span>
  </h1>
  <p class="hg-stack hg-proofs">
    {gains.map((g) => <span class="hg-item">{g.proof}</span>)}
  </p>
</div>

<style>
  /* Largeur en rem et non en ch : le ch se mesure sur la police du bloc,
     16 px, alors que l'accroche est à 64 px. Le bloc faisait 405 px, deux des
     cinq gains passaient sur deux lignes et débordaient. */
  .hg { max-width: 44rem; }
  .hg h1 { margin: 0; }
  .hg-lead { display: block; }
  .hg-words { color: var(--color-accent); display: block; }

  .hg-proofs {
    margin-top: 0.7rem;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-ink-2);
    max-width: 52ch;
  }

  /* Une pile : tous les éléments dans la même cellule de grille, un seul
     visible. La grille prend d'elle-même la hauteur du plus grand, donc rien
     ne déborde quand un gain passe sur deux lignes. */
  .hg-stack { display: grid; }
  .hg-item { grid-area: 1 / 1; }

  @media (prefers-reduced-motion: no-preference) {
    .hg-item {
      opacity: 0;
      transform: translateY(0.22em);
      animation: hg-roll 20s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }
    /* Retard négatif sur le premier : à l'affichage il a déjà passé sa phase
       d'entrée, donc le premier gain est lisible d'emblée. Une opacité posée
       en dur ne suffirait pas, une animation l'emporte toujours sur elle. */
    .hg-item:nth-child(1) { animation-delay: -0.4s; }
    .hg-item:nth-child(2) { animation-delay: 3.6s; }
    .hg-item:nth-child(3) { animation-delay: 7.6s; }
    .hg-item:nth-child(4) { animation-delay: 11.6s; }
    .hg-item:nth-child(5) { animation-delay: 15.6s; }

    @keyframes hg-roll {
      0%   { opacity: 0; transform: translateY(0.22em); }
      2%   { opacity: 1; transform: translateY(0); }
      18%  { opacity: 1; transform: translateY(0); }
      20%  { opacity: 0; transform: translateY(-0.22em); }
      100% { opacity: 0; transform: translateY(-0.22em); }
    }
  }

  /* Sans mouvement, la pile redevient une liste : les cinq gains se lisent. */
  @media (prefers-reduced-motion: reduce) {
    .hg-stack { display: block; }
    .hg-item { display: block; }
    .hg-proofs .hg-item { margin-bottom: 0.35rem; }
  }

</style>
