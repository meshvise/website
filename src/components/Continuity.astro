---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const items = ['data', 'stack'] as const;
---

<section id="continuity" class="section bg-surface border-y border-line">
  <div class="wrap grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-5">
      <h2 class="t-page">{t(lang, 'home.continuity.title')}</h2>
      <p class="t-lede mt-5">{t(lang, 'home.continuity.intro')}</p>
      <p class="t-body mt-5 text-[14px]">{t(lang, 'home.continuity.outro')}</p>
    </div>
    <dl class="lg:col-span-7 border-t border-line">
      {items.map((k) => (
        <div class="grid sm:grid-cols-12 gap-x-6 gap-y-1 py-5 border-b border-line">
          <dt class="sm:col-span-4 text-[16px] font-medium text-ink">{t(lang, `home.continuity.${k}.title`)}</dt>
          <dd class="sm:col-span-8 t-body">{t(lang, `home.continuity.${k}.body`)}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
