---
/**
 * « Par où commencer » : quatre entrées, de la plus légère à la plus
 * engagée. Chaque carte est un lien entier, et le seul de la carte : le
 * visiteur clique où il veut, sans chercher le mot souligné. Aucun prix
 * ici, il vit sur la page Tarifs, vers laquelle le lien du bas renvoie.
 *
 * L'exploitation déléguée a sa carte comme les trois autres, mais elle
 * mène à sa colonne de la page Tarifs, qui dit qu'elle n'est pas encore
 * livrable : la carte n'en promet pas davantage que « sur demande ».
 */
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cards = [
  { key: 'demo', to: href(lang, 'demo') },
  { key: 'trial', to: href(lang, 'trial') },
  { key: 'onprem', to: href(lang, 'pricing') },
  { key: 'managed', to: href(lang, 'pricing', 'exploitation-deleguee') },
] as const;
---

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 class="t-page">{t(lang, 'home.pricing_brief.title')}</h2>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map((c) => (
        <li class="flex">
          <a href={c.to} class="start">
            <h3 class="start-name">{t(lang, `home.pricing_brief.${c.key}.name`)}</h3>
            <p class="start-price">{t(lang, `home.pricing_brief.${c.key}.price`)}</p>
            <p class="start-note">{t(lang, `home.pricing_brief.${c.key}.note`)}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-[15px]"><a href={href(lang, 'pricing')} class="link">{t(lang, 'home.pricing_brief.link')}</a></p>
  </div>
</section>

<style>
  /* Le panneau du site, rendu cliquable : au survol, le filet se renforce,
     l'ombre se lève et le titre prend l'accent, comme la liste des guides. */
  .start {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .start:hover {
    border-color: var(--color-line-strong);
    box-shadow: var(--shadow-card);
  }
  /* La règle globale arrondit le contour à 4 px : sur une carte, il doit
     suivre le bord. */
  .start:focus-visible {
    outline-offset: 3px;
    border-radius: var(--radius-lg);
  }

  .start-name {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-ink);
    transition: color 160ms ease;
  }
  .start:hover .start-name,
  .start:focus-visible .start-name { color: var(--color-accent); }

  /* Le sous-titre dit la forme de l'offre, pas son prix : en mono, à la
     place qu'occupe le tarif sur la page Tarifs. */
  .start-price {
    margin-top: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-2);
  }
  .start-note {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
</style>
