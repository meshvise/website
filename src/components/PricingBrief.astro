---
/**
 * « Par où commencer » : quatre entrées, de la plus légère à la plus
 * engagée. Chaque carte est un lien entier, et le seul de la carte : le
 * visiteur clique où il veut, sans chercher le mot souligné. Aucun prix
 * ici, il vit sur la page Tarifs, vers laquelle le lien du bas renvoie.
 *
 * Chaque carte porte une vignette dessinée, dans le trait des planches de
 * l'accueil : une fenêtre de navigateur pour la démonstration, une machine
 * reliée au boîtier Meshvise pour l'essai, une usine qui abrite son serveur
 * pour la licence sur site, un serveur veillé à distance pour l'exploitation
 * déléguée. Le mouvement part quand la section entre dans l'écran : la
 * courbe se trace, les données circulent, les voyants battent. Sans script
 * ou sous `prefers-reduced-motion`, les vignettes sont posées dans leur état
 * final, immobiles.
 *
 * L'exploitation déléguée a sa carte comme les trois autres, mais elle
 * mène à sa colonne de la page Tarifs, qui dit qu'elle n'est pas encore
 * livrable : la carte n'en promet pas davantage que « sur demande ».
 */
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cards = [
  { key: 'demo', to: href(lang, 'demo') },
  { key: 'trial', to: href(lang, 'trial') },
  { key: 'onprem', to: href(lang, 'pricing') },
  { key: 'managed', to: href(lang, 'pricing', 'exploitation-deleguee') },
] as const;

// Le tracé de la démonstration : une journée de production, vue de loin.
const courbe = Array.from({ length: 29 }, (_, i) => {
  const x = 96 + i * 4.9;
  const v = Math.sin(i * 0.42) * 9 + Math.sin(i * 1.1) * 4 + (i > 8 && i < 22 ? -10 : 0);
  return `${x.toFixed(1)},${(112 + v).toFixed(1)}`;
}).join(' ');

// Le battement de l'exploitation déléguée.
const pouls = 'M104 96 H132 L138 84 L146 110 L153 74 L160 104 L165 96 H188';
---

<section class="section" data-start>
  <div class="wrap">
    <div class="section-head">
      <h2 class="t-page">{t(lang, 'home.pricing_brief.title')}</h2>
    </div>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map((c) => (
        <li class="flex">
          <a href={c.to} class="start">
            <div class="vignette" aria-hidden="true">
              <svg viewBox="0 0 280 160" focusable="false">
                {c.key === 'demo' && (
                  <g>
                    <rect class="v-cadre" x="40" y="20" width="200" height="124" rx="9" />
                    <path class="v-barre" d="M40 29 a9 9 0 0 1 9 -9 h182 a9 9 0 0 1 9 9 v9 h-200 z" />
                    <circle class="v-gris" cx="53" cy="29" r="2.6" />
                    <circle class="v-gris" cx="62" cy="29" r="2.6" />
                    <circle class="v-gris" cx="71" cy="29" r="2.6" />
                    <rect class="v-adresse" x="86" y="24.5" width="112" height="9" rx="4.5" />
                    <rect class="v-pale" x="48" y="46" width="36" height="90" rx="4" />
                    <rect class="v-trait" x="54" y="54" width="22" height="4" rx="2" />
                    <rect class="v-trait" x="54" y="64" width="18" height="4" rx="2" />
                    <rect class="v-trait" x="54" y="74" width="22" height="4" rx="2" />
                    <rect class="v-tuile" x="92" y="46" width="66" height="30" rx="4" />
                    <rect class="v-tuile" x="164" y="46" width="68" height="30" rx="4" />
                    <rect class="v-encre" x="99" y="58" width="30" height="10" rx="2" />
                    <rect class="v-vert" x="171" y="58" width="22" height="10" rx="2" />
                    <rect class="v-tuile" x="92" y="82" width="140" height="54" rx="4" />
                    <polyline class="v-courbe" pathLength="1" points={courbe} />
                    <g class="v-curseur">
                      <circle class="v-clic" cx="205" cy="104" r="9" />
                      <path class="v-fleche" d="M204 102 l0 17 l4.5 -4.5 l3.5 7.5 l3 -1.5 l-3.5 -7.2 l6.3 0 z" />
                    </g>
                  </g>
                )}

                {c.key === 'trial' && (
                  <g>
                    <rect class="v-sol" x="14" y="130" width="252" height="3" rx="1.5" />
                    <rect class="v-corps" x="24" y="52" width="92" height="76" rx="6" />
                    <rect class="v-vitre" x="32" y="62" width="50" height="40" rx="3" />
                    <rect class="v-gris-plein" x="52" y="68" width="10" height="16" rx="2" />
                    <rect class="v-gris-plein" x="48" y="90" width="18" height="5" rx="1.5" />
                    <rect class="v-encre" x="88" y="62" width="20" height="26" rx="2" />
                    <rect class="v-laiton" x="92" y="68" width="12" height="3" rx="1.5" />
                    <rect class="v-laiton" x="92" y="75" width="8" height="3" rx="1.5" />
                    <rect class="v-gris-plein" x="30" y="112" width="80" height="8" rx="2" />
                    <path class="v-cable" d="M116 100 H182" />
                    <circle class="v-donnee" cx="116" cy="100" r="3.6" style="--d: 0s" />
                    <circle class="v-donnee" cx="116" cy="100" r="3.6" style="--d: 0.45s" />
                    <circle class="v-donnee" cx="116" cy="100" r="3.6" style="--d: 0.9s" />
                    <rect class="v-boitier" x="182" y="74" width="80" height="54" rx="9" />
                    <rect class="v-marque" x="196" y="89" width="22" height="22" rx="5" />
                    <circle class="v-marque-c" cx="207" cy="100" r="5.5" />
                    <circle class="v-voyant" cx="246" cy="88" r="3.4" />
                    <rect class="v-fente" x="228" y="104" width="24" height="3" rx="1.5" />
                    <rect class="v-fente" x="228" y="111" width="24" height="3" rx="1.5" />
                  </g>
                )}

                {c.key === 'onprem' && (
                  <g>
                    <rect class="v-sol" x="14" y="132" width="252" height="3" rx="1.5" />
                    <path class="v-corps" d="M34 132 V70 L74 48 V70 L114 48 V70 L154 48 V70 L194 48 V132 Z" />
                    <rect class="v-vitre" x="46" y="86" width="22" height="16" rx="2" />
                    <rect class="v-vitre" x="78" y="86" width="22" height="16" rx="2" />
                    <rect class="v-vitre" x="110" y="86" width="22" height="16" rx="2" />
                    <rect class="v-baie" x="148" y="80" width="36" height="52" rx="4" />
                    <rect class="v-fente" x="154" y="90" width="24" height="3" rx="1.5" />
                    <rect class="v-fente" x="154" y="99" width="24" height="3" rx="1.5" />
                    <rect class="v-fente" x="154" y="108" width="24" height="3" rx="1.5" />
                    <circle class="v-voyant" cx="157" cy="122" r="2.8" style="--d: 0s" />
                    <circle class="v-voyant" cx="166" cy="122" r="2.8" style="--d: 0.4s" />
                    <circle class="v-voyant" cx="175" cy="122" r="2.8" style="--d: 0.8s" />
                    <g class="v-cle">
                      <circle class="v-pastille" cx="226" cy="64" r="24" />
                      <circle class="v-cle-t" cx="217" cy="64" r="7" />
                      <path class="v-cle-t" d="M224 64 H240 M234 64 V71 M239 64 V69" />
                    </g>
                  </g>
                )}

                {c.key === 'managed' && (
                  <g>
                    <rect class="v-baie" x="44" y="52" width="58" height="80" rx="6" />
                    <rect class="v-fente" x="52" y="64" width="42" height="3" rx="1.5" />
                    <rect class="v-fente" x="52" y="74" width="42" height="3" rx="1.5" />
                    <rect class="v-fente" x="52" y="84" width="42" height="3" rx="1.5" />
                    <circle class="v-voyant" cx="56" cy="118" r="3" style="--d: 0s" />
                    <circle class="v-voyant" cx="66" cy="118" r="3" style="--d: 0.5s" />
                    <path class="v-pouls" pathLength="1" d={pouls} />
                    <path class="v-epaules" d="M196 134 C196 110 210 100 222 100 C234 100 248 110 248 134 Z" />
                    <circle class="v-tete" cx="222" cy="78" r="17" />
                    <path class="v-casque" d="M203 80 A19 19 0 0 1 241 80" />
                    <rect class="v-oreille" x="199" y="76" width="7" height="13" rx="3" />
                    <rect class="v-oreille" x="238" y="76" width="7" height="13" rx="3" />
                    <path class="v-micro" d="M241 88 C241 96 234 98 228 98" />
                  </g>
                )}
              </svg>
            </div>
            <div class="start-texte">
              <span class="start-badge">{t(lang, `home.pricing_brief.${c.key}.price`)}</span>
              <h3 class="start-name">{t(lang, `home.pricing_brief.${c.key}.name`)}</h3>
              <p class="start-note">{t(lang, `home.pricing_brief.${c.key}.note`)}</p>
              <span class="start-cta">
                {t(lang, `home.pricing_brief.${c.key}.cta`)}
                <span class="start-fleche" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-[15px]"><a href={href(lang, 'pricing')} class="link">{t(lang, 'home.pricing_brief.link')}</a></p>
  </div>
</section>

<script>
  /**
   * Le mouvement des vignettes part quand la section entre dans l'écran,
   * une fois. Sans ce script, elles restent dans leur état final.
   */
  const calme = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-start]').forEach((section) => {
    if (calme.matches || !('IntersectionObserver' in window)) return;
    const obs = new IntersectionObserver(
      (entrees) => {
        if (entrees.some((e) => e.isIntersecting)) {
          section.setAttribute('data-vu', '');
          obs.disconnect();
        }
      },
      { threshold: 0.3 }
    );
    obs.observe(section);
  });
</script>

<style>
  /* Le panneau du site, rendu cliquable : au survol, le filet se renforce,
     l'ombre se lève, la carte monte d'un cran et la flèche avance. */
  .start {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }
  .start:hover {
    border-color: var(--color-line-strong);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }
  /* La règle globale arrondit le contour à 4 px : sur une carte, il doit
     suivre le bord. */
  .start:focus-visible {
    outline-offset: 3px;
    border-radius: var(--radius-lg);
  }

  .vignette {
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-line);
    padding: 0.5rem 0.75rem 0.25rem;
  }
  .vignette svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .start-texte {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.35rem 1.5rem 1.5rem;
  }

  /* La forme de l'offre, en étiquette au-dessus du titre : elle se lit en
     premier et ne concurrence pas le nom. En police de texte, pas en mono :
     ce n'est ni une valeur ni un identifiant. */
  .start-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-accent-bg);
    color: var(--color-accent-strong);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }
  .start-name {
    margin-top: 0.8rem;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
    transition: color 160ms ease;
  }
  .start:hover .start-name,
  .start:focus-visible .start-name { color: var(--color-accent); }

  .start-note {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .start-cta {
    margin-top: auto;
    padding-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-accent);
  }
  .start-fleche { transition: transform 160ms ease; }
  .start:hover .start-fleche { transform: translateX(4px); }

  /* ── Les vignettes ─────────────────────────────────────────────────── */
  /* Astro ne pose pas son attribut de portée sur les éléments SVG rendus
     dans une expression conditionnelle : leurs règles passent donc par
     `:global()`, sous la vignette, qui elle est bien portée. */
  .vignette :global(.v-cadre) { fill: var(--color-surface); stroke: var(--color-n-300); stroke-width: 1.4; }
  .vignette :global(.v-barre) { fill: var(--color-n-100); }
  .vignette :global(.v-gris) { fill: var(--color-n-300); }
  .vignette :global(.v-adresse) { fill: var(--color-surface); stroke: var(--color-n-200); }
  .vignette :global(.v-pale) { fill: var(--color-n-100); }
  .vignette :global(.v-trait) { fill: var(--color-n-300); }
  .vignette :global(.v-tuile) { fill: var(--color-canvas); stroke: var(--color-n-200); }
  .vignette :global(.v-encre) { fill: var(--color-ink); }
  .vignette :global(.v-vert) { fill: var(--color-normal); }
  .vignette :global(.v-courbe) {
    fill: none;
    stroke: var(--color-brass);
    stroke-width: 2.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .vignette :global(.v-clic) { fill: var(--color-accent); opacity: 0; }
  .vignette :global(.v-fleche) { fill: var(--color-ink); stroke: #fff; stroke-width: 1.2; stroke-linejoin: round; }

  .vignette :global(.v-sol) { fill: var(--color-n-200); }
  .vignette :global(.v-corps) { fill: var(--color-n-100); stroke: var(--color-n-400); stroke-width: 1.4; stroke-linejoin: round; }
  .vignette :global(.v-vitre) { fill: var(--color-surface); stroke: var(--color-n-300); }
  .vignette :global(.v-gris-plein) { fill: var(--color-n-300); }
  .vignette :global(.v-laiton) { fill: var(--color-brass-light); }
  .vignette :global(.v-cable) {
    fill: none;
    stroke: var(--color-n-400);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 2 5;
  }
  .vignette :global(.v-donnee) { fill: var(--color-brass); opacity: 0; }
  .vignette :global(.v-boitier) { fill: var(--color-ink); }
  .vignette :global(.v-marque) { fill: none; stroke: #fff; stroke-width: 2.2; }
  .vignette :global(.v-marque-c) { fill: none; stroke: var(--color-accent-soft); stroke-width: 2.2; }
  .vignette :global(.v-voyant) { fill: var(--color-normal); }
  .vignette :global(.v-fente) { fill: var(--color-n-600); }

  .vignette :global(.v-baie) { fill: var(--color-ink); }
  .vignette :global(.v-pastille) { fill: var(--color-accent); }
  .vignette :global(.v-cle-t) { fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round; }

  .vignette :global(.v-pouls) {
    fill: none;
    stroke: var(--color-brass);
    stroke-width: 2.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .vignette :global(.v-epaules) { fill: var(--color-accent); }
  .vignette :global(.v-tete) { fill: var(--color-n-200); }
  .vignette :global(.v-casque) { fill: none; stroke: var(--color-ink); stroke-width: 3; stroke-linecap: round; }
  .vignette :global(.v-oreille) { fill: var(--color-ink); }
  .vignette :global(.v-micro) { fill: none; stroke: var(--color-ink); stroke-width: 2.2; stroke-linecap: round; }

  .vignette :global(.v-cle), .vignette :global(.v-curseur) {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Le mouvement, quand la section est vue. Les tracés se posent une fois,
     les voyants et les données continuent doucement : ce sont des machines
     qui tournent. */
  @media (prefers-reduced-motion: no-preference) {
    [data-vu] .vignette :global(.v-courbe) {
      stroke-dasharray: 1;
      animation: v-trace 1.6s ease-out both 0.2s;
    }
    [data-vu] .vignette :global(.v-clic) { animation: v-clic 0.6s ease-out both 1.9s; }
    [data-vu] .vignette :global(.v-curseur) { animation: v-appui 0.3s ease-in-out both 1.8s; }
    [data-vu] .vignette :global(.v-donnee) { animation: v-flux 1.35s linear infinite var(--d); }
    [data-vu] .vignette :global(.v-voyant) { animation: v-battre 1.8s ease-in-out infinite var(--d, 0s); }
    [data-vu] .vignette :global(.v-cle) { animation: v-pop 0.5s cubic-bezier(0.22, 1, 0.36, 1) both 0.5s; }
    [data-vu] .vignette :global(.v-pouls) {
      stroke-dasharray: 1;
      animation: v-trace 1.8s linear infinite 0.3s;
    }
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes v-trace {
      from { stroke-dashoffset: 1; }
      to { stroke-dashoffset: 0; }
    }
    @keyframes v-clic {
      0% { opacity: 0.45; transform: scale(0.3); transform-box: fill-box; transform-origin: center; }
      100% { opacity: 0; transform: scale(2.2); transform-box: fill-box; transform-origin: center; }
    }
    @keyframes v-appui {
      50% { transform: scale(0.88); }
    }
    @keyframes v-flux {
      0% { opacity: 0; transform: translateX(0); }
      15% { opacity: 1; }
      85% { opacity: 1; }
      100% { opacity: 0; transform: translateX(66px); }
    }
    @keyframes v-battre {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }
    @keyframes v-pop {
      from { opacity: 0; transform: scale(0.4) rotate(-20deg); }
      to { opacity: 1; transform: scale(1) rotate(0); }
    }
  }
</style>
