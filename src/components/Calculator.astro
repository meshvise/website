---
/**
 * Calculateur du coût de l'inaction. Cinq gisements présentés comme les
 * lignes d'un relevé, tous visibles, chacun avec ses champs et son
 * sous-total. Aucune valeur par défaut. Formules : argumentaire-valeur.md.
 */
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const groups = [
  { id: 'downtime', fields: ['f1', 'f2', 'f3'] },
  { id: 'oncall',   fields: ['f1', 'f2', 'f3'] },
  { id: 'manual',   fields: ['f1', 'f2', 'f3'] },
  { id: 'audit',    fields: ['f1', 'f2', 'f3'] },
  { id: 'energy',   fields: ['f1', 'f2'] },
] as const;
---

<section id="calc" class="section bg-surface border-y border-line scroll-mt-14">
  <div class="wrap">
    <div class="section-head">
      <h2 class="t-page">{t(lang, 'why.calc.title')}</h2>
      <p class="t-lede">{t(lang, 'why.calc.intro')}</p>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-start" data-calc data-lang={lang}>
      <div class="lg:col-span-8 border-t border-line">
        {groups.map((g) => (
          <div class="grid md:grid-cols-12 gap-x-10 gap-y-5 py-8 border-b border-line">
            <div class="md:col-span-4">
              <h3 class="text-[17px] font-medium text-ink">{t(lang, `why.calc.${g.id}.label`)}</h3>
              <p class="t-body mt-1.5 text-[14px]">{t(lang, `why.calc.${g.id}.help`)}</p>
            </div>
            <div class="md:col-span-8">
              <div class={`grid gap-3 ${g.fields.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}`}>
                {g.fields.map((f) => (
                  <div>
                    <label for={`calc-${g.id}-${f}`} class="field-label text-[12.5px]">{t(lang, `why.calc.${g.id}.${f}`)}</label>
                    <input id={`calc-${g.id}-${f}`} type="number" inputmode="decimal" min="0" step="any" data-calc-input data-tab={g.id} data-field={f} class="field mono" />
                  </div>
                ))}
              </div>
              <div class="mt-3 flex items-baseline justify-between text-[13px]">
                <span class="text-muted">{t(lang, `why.calc.${g.id}.result`)}</span>
                <span class="metric text-[17px]" data-calc-result={g.id}>–</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <aside class="lg:col-span-4 dark-block rounded-lg p-7 relative overflow-hidden lg:sticky lg:top-20">
        <div class="t-small">{t(lang, 'why.calc.total_label')}</div>
        <div class="mono text-[36px] font-medium mt-1 leading-none text-crit-bg" data-calc-total>–</div>
        <div class="t-small mt-1" data-calc-total-unit hidden>{t(lang, 'why.calc.per_year')}</div>
        <p class="t-small mt-5" data-calc-empty>{t(lang, 'why.calc.empty')}</p>
        <div class="mt-6 pt-5 border-t border-n-700">
          <a href={href(lang, 'pricing')} class="t-small underline underline-offset-4 hover:no-underline">{t(lang, 'why.calc.compare')}</a>
        </div>
      </aside>
    </div>

    <p class="t-small mt-8 max-w-2xl">{t(lang, 'why.calc.rule')}</p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) {
    const locale = root.dataset.lang === 'en' ? 'en-GB' : 'fr-FR';
    const fmt = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const v = (tab: string, f: string): number | null => {
      const el = root.querySelector<HTMLInputElement>(`[data-calc-input][data-tab="${tab}"][data-field="${f}"]`);
      if (!el || el.value.trim() === '') return null;
      const n = Number(el.value); return Number.isFinite(n) && n >= 0 ? n : null;
    };
    const all = (tab: string, fields: string[]): number[] | null => {
      const out: number[] = [];
      for (const f of fields) { const n = v(tab, f); if (n === null) return null; out.push(n); }
      return out;
    };
    const formulas: Record<string, () => number | null> = {
      downtime: () => { const a = all('downtime', ['f1','f2','f3']); return a ? a[0] * a[1] * a[2] * 12 : null; },
      oncall:   () => { const a = all('oncall',   ['f1','f2','f3']); return a ? a[0] * a[1] * a[2] * 12 : null; },
      manual:   () => { const a = all('manual',   ['f1','f2','f3']); return a ? a[0] * (a[1] / 60) * a[2] * 250 : null; },
      audit:    () => { const a = all('audit',    ['f1','f2','f3']); return a ? a[0] * a[1] * a[2] : null; },
      energy:   () => { const a = all('energy',   ['f1','f2']);      return a ? a[0] * (a[1] / 100) * 12 : null; },
    };
    const totalEl = root.querySelector<HTMLElement>('[data-calc-total]')!;
    const totalUnit = root.querySelector<HTMLElement>('[data-calc-total-unit]')!;
    const emptyEl = root.querySelector<HTMLElement>('[data-calc-empty]')!;
    const recompute = () => {
      let total = 0, any = false;
      for (const [tab, fn] of Object.entries(formulas)) {
        const r = fn();
        const out = root.querySelector<HTMLElement>(`[data-calc-result="${tab}"]`)!;
        if (r === null) out.textContent = '–'; else { out.textContent = fmt.format(r); total += r; any = true; }
      }
      if (!any || total <= 0) { totalEl.textContent = '–'; totalUnit.hidden = true; emptyEl.hidden = false; return; }
      totalEl.textContent = fmt.format(total);
      totalUnit.hidden = false; emptyEl.hidden = true;
    };
    root.querySelectorAll<HTMLInputElement>('[data-calc-input]').forEach((i) => i.addEventListener('input', recompute));
    recompute();
  }
</script>
