---
/**
 * V-02 · Fuite d'air comprimé. Registre dépouillé.
 *
 * Ici le chiffre ne suit pas le crayon, il l'additionne : le montant se
 * compose de zéro à 13 900 € pendant que la semaine se trace, parce que
 * c'est exactement ce que fait une facture, un mètre cube après l'autre.
 *
 * Une semaine de débit, deux niveaux, l'écart entre les deux, et aucun mot
 * dans le dessin : les étiquettes des niveaux, la somme de l'écart et les
 * jours de la semaine ont été retirés le 2026-09-22. Le chiffre du dessus
 * dit ce que coûte l'écart ; cinq bosses puis un plat disent la semaine.
 *
 * Valeurs du jeu de démonstration : rythme d'atelier du seed (lundi au
 * vendredi, 06:00 à 20:00, creux de pause à 12:30), profil `airflow`
 * (base 430 m³/h, veille 45), scénario `air-leak` (`floor` à 255 m³/h sur
 * le débit, `floor` à 24 kW au sous-compteur dont la veille vaut 4,5 kW).
 * Le plancher du seed module, il n'est pas plat.
 */
import { mt as t, type Lang } from './text';
import Stat from './Stat.astro';
import type { Ligne } from './Stat.astro';
import { toPoints, polylineLength, thousands } from './frame';
import './strip.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ent = (v: number) => thousands(v, lang);

// ── Les chiffres du scénario ───────────────────────────────────────────
const HEURES = 168;
const VEILLE = 45; // profil `airflow`, valeur de veille
const PLANCHER = 255; // scénario `air-leak`, plancher observé
const KW_FUITE = 24 - 4.5; // plancher au sous-compteur moins sa veille
const H_AN = (HEURES - 5 * 14) * 52; // 98 h hors production par semaine
const TARIF = 0.14; // euro par kWh, contrat industriel
const COUT = Math.round((KW_FUITE * H_AN * TARIF) / 100) * 100;

// Le montant se compose au même rythme que la semaine se trace.
const lignes: Ligne[] = Array.from({ length: 31 }, (_, i) => ({
  valeur: ent(Math.round((COUT * i) / 30 / 100) * 100),
  ton: i === 30 ? 'warn' : 'ink',
}));

// ── La bande ───────────────────────────────────────────────────────────
const W = 720;
const H = 244;
const X0 = 6;
const X1 = 714;
const Y0 = 16;
const Y1 = 230;
const V_MAX = 500;

const x = (h: number) => X0 + (h / HEURES) * (X1 - X0);
const y = (v: number) => Y1 - (v / V_MAX) * (Y1 - Y0);

/** Le débit heure par heure, formule du seed. */
const debit = (h: number) => {
  const jour = Math.floor(h / 24);
  const heure = h % 24;
  const oscill = Math.sin(h * 2.399) * 16 + Math.sin(h * 0.817) * 10 + Math.sin(h * 1.213) * 6;
  let v = VEILLE + oscill * 0.12;
  if (jour < 5 && heure >= 6 && heure < 20) {
    const p = (heure - 6) / 14;
    const rampe = Math.min(1, (p * 14) / 0.75, ((1 - p) * 14) / 0.75);
    const pause = 1 - 0.35 * Math.exp(-Math.pow((heure - 12.5) / 0.55, 2));
    v = 430 * rampe * pause + oscill;
  }
  const modulation = PLANCHER * (1 + Math.sin(h * 3.117) * 0.045 + Math.sin(h * 1.913) * 0.025);
  return Math.max(v, modulation);
};

const pts: Array<[number, number]> = Array.from({ length: HEURES + 1 }, (_, h) => [
  x(h),
  y(debit(h)),
]);
const trace = toPoints(pts);
const longueur = polylineLength(pts);

const yPlancher = y(PLANCHER);
const yVeille = y(VEILLE);
---

<figure class="mvf mvs" role="img" aria-label={t(lang, 'motion.strip.alt')}>
  <Stat lignes={lignes} unite="€/an" phrase={t(lang, 'motion.strip.caption')} />

  <svg viewBox={`0 0 ${W} ${H}`} class="mvs-svg" aria-hidden="true" focusable="false">
    <!-- L'écart entre les deux niveaux. Il s'ouvre du haut vers le bas,
         dans le sens où on le découvre : on part du plancher constaté et on
         descend vers ce qu'on aurait dû lire. -->
    <rect
      class="mvs-gap als-gap mvs-a"
      style="animation-name: als-gap"
      x={X0}
      y={yPlancher}
      width={X1 - X0}
      height={yVeille - yPlancher}
    />

    <polyline
      class="mvs-trace mvs-a mvs-lin"
      style={`animation-name: mvs-draw; --len: ${longueur.toFixed(0)}; stroke-dasharray: var(--len)`}
      points={trace}
    />

    <g class="mvs-a" style="animation-name: als-floor">
      <line class="mvs-limit" x1={X0} y1={yPlancher} x2={X1} y2={yPlancher} />
    </g>

    <g class="mvs-a" style="animation-name: als-idle">
      <line class="mvs-ref" x1={X0} y1={yVeille} x2={X1} y2={yVeille} />
    </g>
  </svg>
</figure>

<script>
  import { observerLesFigures } from './observe';

  observerLesFigures();
</script>

<style>
  /* L'écart est l'argument de la figure : plus appuyé que dans les autres. */
  .als-gap { fill-opacity: 0.18; }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes als-floor {
      0%, 20% { opacity: 0; transform: translateX(26px); }
      36%, 100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes als-idle {
      0%, 38% { opacity: 0; }
      50%, 100% { opacity: 1; }
    }
    @keyframes als-gap {
      0%, 48% { transform: scaleY(0); }
      70%, 100% { transform: scaleY(1); }
    }
  }
</style>
