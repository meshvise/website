---
/**
 * Les six figures dans la composition qu'elles sont censées servir : texte
 * d'un côté, figure de l'autre, une section par scénario.
 *
 * Ce gabarit sert les deux pages d'aperçu, française et anglaise, pour que
 * juger le rendu anglais ne demande pas de maintenir une deuxième page.
 * Le texte vit sous la clé `motion.` : quand les figures descendront dans
 * les vraies pages, il descendra avec elles.
 *
 * Les six figures de l'ancien registre (grille d'enregistreur, cartouche,
 * bandeau d'acte, caméra) ne sont plus montrées ici. Elles restent dans le
 * dépôt avec `motion.css`, `frame.ts`, `Head` et `Cartouche` : tant que le
 * nouveau registre n'est pas descendu dans les vraies pages, on ne jette
 * rien.
 */
import { mt as t, type Lang } from './text';
import SpindleWearStrip from './SpindleWearStrip.astro';
import AirLeakStrip from './AirLeakStrip.astro';
import MeterDropoutStrip from './MeterDropoutStrip.astro';
import TightThresholdStrip from './TightThresholdStrip.astro';
import ProtocolEngineStrip from './ProtocolEngineStrip.astro';
import DataChainStrip from './DataChainStrip.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const sections = [
  { cle: 'spindleStrip', figure: SpindleWearStrip },
  { cle: 'strip', figure: AirLeakStrip },
  { cle: 'meterStrip', figure: MeterDropoutStrip },
  { cle: 'thresholdStrip', figure: TightThresholdStrip },
  { cle: 'engineStrip', figure: ProtocolEngineStrip },
  { cle: 'chainStrip', figure: DataChainStrip },
] as const;
---

<section class="section">
  <div class="wrap">
    <h1 class="t-page">{t(lang, 'motion.preview.title')}</h1>
    <p class="t-lede mt-6">{t(lang, 'motion.preview.lede')}</p>
  </div>
</section>

{
  sections.map(({ cle, figure: Figure }, i) => (
    <section
      class="section"
      style={i % 2 === 1
        ? 'background: var(--color-surface); border-block: 1px solid var(--color-line);'
        : undefined}
    >
      <div class="wrap">
        <p class="mono text-[11px] tracking-[0.09em] text-n-400">
          {t(lang, `motion.${cle}.section`)}
        </p>
        <div class="grid lg:grid-cols-12 gap-12 items-center mt-8">
          <div class={`lg:col-span-5 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
            <h2 class="t-page">{t(lang, `motion.${cle}.title`)}</h2>
            <p class="t-lede mt-6">{t(lang, `motion.${cle}.lede`)}</p>
            <p class="t-body mt-5">{t(lang, `motion.${cle}.p1`)}</p>
            <p class="t-body mt-5">{t(lang, `motion.${cle}.p2`)}</p>
          </div>
          <div class={`lg:col-span-7 ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
            <Figure lang={lang} />
          </div>
        </div>
      </div>
    </section>
  ))
}
