---
/**
 * Usure de broche : le premier des six scénarios inscrits dans les trente
 * jours d'historique du parc de Bellecombe, déroulé comme une séquence.
 *
 * L'animation ne décore pas, elle raconte un parcours complet : une dérive
 * que personne ne voit, un seuil normalisé, le franchissement, l'alarme,
 * l'intervention avant la casse. Chaque valeur affichée est celle du
 * scénario, et le tracé est calculé à la construction, pas dessiné à vue.
 *
 * Le mouvement se joue en boucle sur une seule durée : chaque élément
 * porte ses temps en pourcentage de ce cycle, ce qui garde la séquence
 * synchronisée sans script. Sous `prefers-reduced-motion`, tout est posé
 * dans son état final dès l'affichage.
 */
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Géométrie du tracé, en unités du viewBox.
const X0 = 66, X1 = 610, Y0 = 74, Y1 = 396;
const V_MAX = 6;            // pleine échelle de l'axe, en mm/s
const SEUIL = 4.5;          // ISO 10816, entrée en zone C pour cette classe
const DAYS = 30;

const x = (d: number) => X0 + (d / DAYS) * (X1 - X0);
const y = (v: number) => Y1 - (v / V_MAX) * (Y1 - Y0);

/**
 * Vibration efficace jour par jour : une dérive lente de 2,1 à 4,9 mm/s,
 * plus le bruit de mesure. Suite déterministe, pour que deux constructions
 * du site produisent exactement la même courbe.
 */
const serie = Array.from({ length: DAYS + 1 }, (_, d) => {
  const derive = 2.1 + Math.pow(d / DAYS, 1.7) * 2.8;
  const bruit = Math.sin(d * 2.399) * 0.055 + Math.sin(d * 0.817) * 0.035;
  return Math.round((derive + bruit) * 100) / 100;
});

const jourFranchissement = serie.findIndex((v) => v >= SEUIL);
const valeurAlarme = serie[jourFranchissement];
const points = serie.map((v, d) => `${x(d).toFixed(1)},${y(v).toFixed(1)}`).join(' ');

// Le tracé est révélé par son propre trait : il faut sa longueur exacte.
const longueur = serie.reduce((acc, v, d) => {
  if (d === 0) return 0;
  const dx = x(d) - x(d - 1);
  const dy = y(v) - y(serie[d - 1]);
  return acc + Math.hypot(dx, dy);
}, 0);

const graduations = [0, 1, 2, 3, 4, 5, 6];
const semaines = [0, 7, 14, 21, 28];
const xAlarme = x(jourFranchissement);
const yAlarme = y(valeurAlarme);
const fmt = (v: number) => v.toFixed(1).replace('.', lang === 'fr' ? ',' : '.');
---

<figure class="sw">
  <svg
    viewBox="0 0 676 520"
    role="img"
    class="sw-svg"
    aria-label={t(lang, 'motion.spindle.alt')}
    style={`--sw-len:${longueur.toFixed(0)}`}
  >
    <!-- Grille d'enregistreur : une ligne par mm/s, un filet par semaine. -->
    <g class="sw-grid">
      {graduations.map((v) => (
        <line x1={X0} y1={y(v)} x2={X1} y2={y(v)} />
      ))}
      {semaines.map((d) => (
        <line x1={x(d)} y1={Y0} x2={x(d)} y2={Y1} />
      ))}
    </g>

    <g class="sw-axis">
      {graduations.filter((v) => v % 2 === 0).map((v) => (
        <text x={X0 - 12} y={y(v) + 4} text-anchor="end">{fmt(v)}</text>
      ))}
      <text x={X0 - 12} y={Y0 - 18} text-anchor="end" class="sw-unit">mm/s</text>
      {semaines.map((d) => (
        <text x={x(d)} y={Y1 + 22} text-anchor="middle">
          {d === 0 ? t(lang, 'motion.spindle.day_zero') : `J+${d}`}
        </text>
      ))}
    </g>

    <!-- Le seuil normalisé, posé avant la courbe : il préexiste à la dérive. -->
    <g class="sw-limit">
      <line x1={X0} y1={y(SEUIL)} x2={X1} y2={y(SEUIL)} />
      <text x={X1} y={y(SEUIL) - 10} text-anchor="end">
        {t(lang, 'motion.spindle.threshold')} · {fmt(SEUIL)} mm/s
      </text>
    </g>

    <polyline class="sw-trace" points={points} />

    <!-- Le franchissement : halo, point, valeur. -->
    <g class="sw-hit" transform={`translate(${xAlarme.toFixed(1)} ${yAlarme.toFixed(1)})`}>
      <circle class="sw-halo" r="7" />
      <circle class="sw-dot" r="4.5" />
      <text x="0" y="-18" text-anchor="middle">{fmt(valeurAlarme)} mm/s</text>
    </g>

    <!-- Ce que la supervision fait de ce franchissement. -->
    <g class="sw-alarm" transform="translate(66 432)">
      <rect width="330" height="44" rx="4" />
      <rect class="sw-alarm-rail" width="3" height="44" />
      <text x="18" y="19" class="sw-alarm-title">{t(lang, 'motion.spindle.alarm_title')}</text>
      <text x="18" y="35" class="sw-alarm-meta">{t(lang, 'motion.spindle.alarm_meta')}</text>
    </g>

    <g class="sw-fix" transform="translate(414 432)">
      <text x="0" y="19" class="sw-fix-title">{t(lang, 'motion.spindle.fix_title')}</text>
      <text x="0" y="35" class="sw-fix-meta">{t(lang, 'motion.spindle.fix_meta')}</text>
    </g>

    <!-- Cartouche, comme sur les figures du dossier. -->
    <g class="sw-cart">
      <line x1="66" y1="496" x2="610" y2="496" />
      <text x="66" y="512">
        <tspan class="sw-cart-strong">{t(lang, 'motion.spindle.fig')}</tspan>
        · {t(lang, 'motion.spindle.caption')}
      </text>
      <text x="610" y="512" text-anchor="end">{t(lang, 'motion.spindle.source')}</text>
    </g>
  </svg>
</figure>

<style>
  .sw {
    margin: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    padding: 0.5rem;
  }
  .sw-svg { display: block; width: 100%; height: auto; }

  /* Une seule horloge : chaque groupe lit ses temps dans ce cycle. */
  .sw-svg { --sw-cycle: 13s; }

  .sw-grid line { stroke: var(--color-n-150); stroke-width: 1; }
  .sw-axis text {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-muted);
  }
  .sw-axis .sw-unit { fill: var(--color-n-400); font-size: 10px; letter-spacing: 0.04em; }

  .sw-limit line {
    stroke: var(--color-warn);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .sw-limit text {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-warn);
    letter-spacing: 0.02em;
  }

  .sw-trace {
    fill: none;
    stroke: var(--color-info);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .sw-hit text {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    fill: var(--color-crit);
  }
  .sw-dot { fill: var(--color-crit); }
  .sw-halo { fill: var(--color-crit); opacity: 0.18; }

  .sw-alarm rect { fill: var(--color-crit-bg); }
  .sw-alarm .sw-alarm-rail { fill: var(--color-crit); }
  .sw-alarm-title {
    font-size: 13px;
    font-weight: 500;
    fill: var(--color-ink);
  }
  .sw-alarm-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-crit);
  }

  .sw-fix-title { font-size: 13px; font-weight: 500; fill: var(--color-ink); }
  .sw-fix-meta { font-family: var(--font-mono); font-size: 11px; fill: var(--color-normal); }

  .sw-cart line { stroke: var(--color-line); stroke-width: 1; }
  .sw-cart text {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--color-n-400);
    letter-spacing: 0.03em;
  }
  .sw-cart .sw-cart-strong { fill: var(--color-muted); }

  /* La séquence. Le seuil d'abord, la dérive ensuite, le franchissement,
     l'alarme, l'intervention : l'ordre est celui des faits. */
  @media (prefers-reduced-motion: no-preference) {
    .sw-limit { animation: sw-fade var(--sw-cycle) linear infinite; }
    .sw-trace {
      stroke-dasharray: var(--sw-len);
      animation: sw-draw var(--sw-cycle) linear infinite;
    }
    .sw-hit { animation: sw-pop var(--sw-cycle) linear infinite; }
    .sw-halo { animation: sw-pulse 1.8s ease-out infinite; transform-origin: center; }
    .sw-alarm { animation: sw-rise var(--sw-cycle) linear infinite; }
    .sw-fix { animation: sw-rise-late var(--sw-cycle) linear infinite; }

    @keyframes sw-fade {
      0%, 4% { opacity: 0; }
      10%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
    @keyframes sw-draw {
      0%, 10% { stroke-dashoffset: var(--sw-len); opacity: 1; }
      62%, 96% { stroke-dashoffset: 0; opacity: 1; }
      100% { stroke-dashoffset: 0; opacity: 0; }
    }
    @keyframes sw-pop {
      0%, 56% { opacity: 0; }
      62%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
    @keyframes sw-pulse {
      0% { r: 7; opacity: 0.3; }
      70%, 100% { r: 17; opacity: 0; }
    }
    @keyframes sw-rise {
      0%, 66% { opacity: 0; transform: translate(66px, 440px); }
      74%, 96% { opacity: 1; transform: translate(66px, 432px); }
      100% { opacity: 0; transform: translate(66px, 432px); }
    }
    @keyframes sw-rise-late {
      0%, 80% { opacity: 0; transform: translate(414px, 440px); }
      88%, 96% { opacity: 1; transform: translate(414px, 432px); }
      100% { opacity: 0; transform: translate(414px, 432px); }
    }
  }
</style>
