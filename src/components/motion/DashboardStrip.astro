---
/**
 * V-07 · Tableaux de bord. Registre dépouillé.
 *
 * La seule figure de la série qui ne raconte pas un scénario : elle montre
 * un tableau de bord qui se remplit. Le compteur additionne les modèles
 * livrés, puis trois cartes se posent et prennent vie : huit machines passent
 * en marche une à une, quatre barres de puissance prennent leur valeur, une
 * semaine de consommation se trace. Enfin un curseur vient presser « + » :
 * les modèles ne sont qu'un départ, l'utilisateur compose les siens. Aucun
 * mot dans le dessin : les titres de cartes sont des traits gris, comme sur
 * un écran vu de loin. Le point « en
 * direct » bat trois fois et se tait ; la figure joue une fois et tient sa
 * dernière image, comme le reste de la série.
 *
 * Tout ce qui est dessiné vient du produit : quatre modèles livrés dans le
 * code (En ce moment, Vue d'ensemble opérations, Énergie et efficacité,
 * Fiabilité et audit), les huit machines de production de Bellecombe, les
 * puissances relevées sur le widget « Puissance appelée » le 2026-09-16
 * (46,8, 37,8, 28,3 et 25,7 kW), et la forme de la semaine du modèle
 * « Énergie et efficacité » : cinq journées de production, un week-end plat.
 */
import { mt as t, type Lang } from './text';
import Stat from './Stat.astro';
import type { Ligne } from './Stat.astro';
import { toPoints } from './frame';
import './strip.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const MODELES = 4;
const lignes: Ligne[] = Array.from({ length: 31 }, (_, i) => ({
  valeur: String(Math.round((i / 30) * MODELES)),
  ton: 'ink',
}));

const MACHINES = 8;
const puissances = [46.8, 37.8, 28.3, 25.7];
const ECHELLE = 55;

// La semaine : cinq journées de production, puis le week-end au talon.
const SW = 600;
const SH = 96;
const semaine = Array.from({ length: 7 * 12 + 1 }, (_, k) => {
  const jour = Math.floor(k / 12);
  const heure = (k % 12) * 2;
  const production = jour < 5 && heure >= 6 && heure < 20;
  const bruit = Math.sin(k * 1.7) * 3 + Math.sin(k * 0.61) * 2;
  const v = production ? 78 + bruit : 22 + bruit * 0.5;
  return [(k / (7 * 12)) * SW, SH - 6 - (v / 90) * (SH - 12)] as [number, number];
});
const trace = toPoints(semaine);
const aire = `M 0 ${SH} L ${trace.replaceAll(' ', ' L ')} L ${SW} ${SH} Z`;
---

<figure class="mvf mvs" role="img" aria-label={t(lang, 'motion.dashStrip.alt')}>
  <Stat lignes={lignes} unite={t(lang, 'motion.dashStrip.unit')} phrase={t(lang, 'motion.dashStrip.caption')} />

  <div class="dbs-board" aria-hidden="true">
    <div class="dbs-head">
      <span class="dbs-titre" />
      <span class="dbs-actions">
        <span class="dbs-dot" />
        <!-- Créer le sien : le bouton que le curseur vient presser, une fois
             les modèles remplis. -->
        <span class="dbs-ajout">
          <svg viewBox="0 0 16 16" focusable="false"><path d="M8 3 V13 M3 8 H13" /></svg>
        </span>
      </span>
    </div>
    <svg class="dbs-curseur" viewBox="0 0 24 24" focusable="false">
      <path d="M5 3 L5 19 L9.4 14.8 L12.6 21.6 L15.4 20.3 L12.2 13.6 L18.4 13.6 Z" />
    </svg>

    <div class="dbs-grid">
      <div class="dbs-carte mvs-pop" style="--i: 2">
        <span class="dbs-ctitre" style="width: 46%" />
        <ul class="dbs-etats">
          {Array.from({ length: MACHINES }, (_, i) => <li style={`--i: ${i}`} />)}
        </ul>
      </div>

      <div class="dbs-carte mvs-pop" style="--i: 3">
        <span class="dbs-ctitre" style="width: 58%" />
        <ul class="dbs-barres">
          {
            puissances.map((kw, i) => (
              <li>
                <span class="dbs-fill" style={`--w: ${(kw / ECHELLE).toFixed(3)}; --i: ${i}`} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="dbs-carte dbs-large mvs-pop" style="--i: 4">
        <span class="dbs-ctitre" style="width: 30%" />
        <svg viewBox={`0 0 ${SW} ${SH}`} preserveAspectRatio="none" class="dbs-courbe">
          <path class="dbs-aire" d={aire} />
          <polyline class="dbs-trait" pathLength="1" points={trace} />
        </svg>
      </div>
    </div>
  </div>
</figure>

<script>
  import { observerLesFigures } from './observe';

  observerLesFigures();
</script>

<style>
  .dbs-board {
    position: relative;
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
  }
  .dbs-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  /* Les titres sont des traits : un écran vu de loin, pas un texte à lire. */
  .dbs-titre,
  .dbs-ctitre {
    display: block;
    height: 9px;
    border-radius: 5px;
    background: var(--color-n-200);
  }
  .dbs-titre { width: 28%; height: 11px; background: var(--color-n-300); }
  .dbs-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-normal);
  }
  .dbs-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .dbs-ajout {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--color-accent);
  }
  .dbs-ajout svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  /* Le curseur arrive de la carte des courbes et vient presser « + ». Au
     repos il est posé sur le bouton. */
  .dbs-curseur {
    position: absolute;
    top: 1.45rem;
    right: 0.45rem;
    width: 22px;
    height: 22px;
    fill: var(--color-ink);
    stroke: #fff;
    stroke-width: 1.4;
    stroke-linejoin: round;
    pointer-events: none;
  }

  .dbs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .dbs-carte {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .dbs-large { grid-column: 1 / -1; }

  /* Huit machines : huit pastilles, qui passent du gris au vert. */
  .dbs-etats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
    justify-items: center;
  }
  .dbs-etats li {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-normal);
  }

  /* Quatre barres de puissance, en laiton comme tout ce qui est mesuré. */
  .dbs-barres {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .dbs-barres li {
    height: 12px;
    border-radius: 6px;
    background: var(--color-n-150);
    overflow: hidden;
  }
  .dbs-fill {
    display: block;
    height: 100%;
    width: calc(var(--w) * 100%);
    border-radius: 6px;
    background: var(--color-brass);
    transform-origin: left center;
  }

  .dbs-courbe {
    display: block;
    width: 100%;
    height: 96px;
  }
  .dbs-aire { fill: var(--color-brass-bg); }
  .dbs-trait {
    fill: none;
    stroke: var(--color-brass);
    stroke-width: 2.4;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dbs-etats li {
      animation: dbs-marche 0.35s ease-out both;
      animation-delay: calc(0.75s + var(--i) * 0.1s);
    }
    .dbs-fill {
      animation: dbs-pousse 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(0.9s + var(--i) * 0.12s);
    }
    .dbs-trait {
      stroke-dasharray: 1;
      animation: dbs-trace 1.3s linear both;
      animation-delay: 1.15s;
    }
    .dbs-aire {
      animation: dbs-aire 0.6s ease-out both;
      animation-delay: 2.2s;
    }
    .dbs-curseur { animation: dbs-curseur 1.1s cubic-bezier(0.22, 1, 0.36, 1) both 2.6s; }
    .dbs-ajout { animation: dbs-presse 0.3s ease-in-out both 3.7s; }
    /* Trois battements, puis le point reste allumé. */
    .dbs-dot {
      animation: dbs-pouls 1.3s ease-out 3 both;
      animation-delay: 1s;
    }
  }

  /* Sous cette largeur les deux petites cartes s'empilent. */
  @media (max-width: 520px) {
    .dbs-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes dbs-marche {
      from { background: var(--color-n-200); transform: scale(0.7); }
      to { background: var(--color-normal); transform: scale(1); }
    }
    @keyframes dbs-pousse {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
    @keyframes dbs-trace {
      from { stroke-dashoffset: 1; }
      to { stroke-dashoffset: 0; }
    }
    @keyframes dbs-aire {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes dbs-curseur {
      from { opacity: 0; transform: translate(-150px, 170px); }
      20% { opacity: 1; }
      to { opacity: 1; transform: translate(0, 0); }
    }
    @keyframes dbs-presse {
      50% { transform: scale(0.86); box-shadow: 0 0 0 6px var(--color-accent-bg); }
    }
    @keyframes dbs-pouls {
      0% { box-shadow: 0 0 0 0 rgb(11 122 64 / 0.5); }
      70% { box-shadow: 0 0 0 9px rgb(11 122 64 / 0); }
      100% { box-shadow: 0 0 0 0 rgb(11 122 64 / 0); }
    }
  }
</style>
