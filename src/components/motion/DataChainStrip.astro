---
/**
 * V-06 · Rien ne se perd. Registre dépouillé.
 *
 * Une mesure se trace, puis la liaison au serveur tombe : une bande marque
 * la coupure, une pastille rouge la signale. Pendant ce temps les mesures
 * continuent d'arriver, mais elles ne sont que gardées : des points gris,
 * posés un à un. Quand la liaison revient, la pastille passe au vert, les
 * points gardés sont rattrapés d'un trait et la courbe reprend. La dernière
 * image est une courbe entière, avec la coupure encore visible et aucun trou.
 *
 * Elle remplace le 2026-09-22 la chaîne de quatre pastilles (équipement,
 * pilote, bus, consommateurs) et sa note sur la réserve de l'historien :
 * le propos était juste, mais il se lisait au lieu de se voir.
 *
 * Ce qui est montré est ce que fait le code : `bus/outbox.py` du runtime
 * garde les faits sur disque quand la liaison au bus tombe (SQLite, ordre
 * de publication et horodatage d'origine conservés, plafond d'un million),
 * et `engine/spill.py` de l'historien couvre la panne de la base.
 */
import { mt as t, type Lang } from './text';
import Stat from './Stat.astro';
import type { Ligne } from './Stat.astro';
import { toPoints } from './frame';
import './strip.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Rien ne se perd : le compteur reste à zéro du début à la fin.
const lignes: Ligne[] = Array.from({ length: 31 }, () => ({ valeur: '0', ton: 'ink' }));

// ── La mesure ──────────────────────────────────────────────────────────
const N = 60;
const COUPURE_DEBUT = 24;
const COUPURE_FIN = 38;

const W = 720;
const H = 214;
const X0 = 6;
const X1 = 714;
const Y0 = 52; // le haut porte la pastille de la coupure
const Y1 = 204;

const valeur = (i: number) =>
  50 + Math.sin(i * 0.23) * 18 + Math.sin(i * 0.61) * 7 + Math.sin(i * 1.7) * 3;
const V_MIN = 18;
const V_MAX = 82;

const x = (i: number) => X0 + (i / (N - 1)) * (X1 - X0);
const y = (v: number) => Y1 - ((v - V_MIN) / (V_MAX - V_MIN)) * (Y1 - Y0);
const point = (i: number): [number, number] => [x(i), y(valeur(i))];

const segment = (a: number, b: number) =>
  toPoints(Array.from({ length: b - a + 1 }, (_, k) => point(a + k)));

const avant = segment(0, COUPURE_DEBUT);
const pendant = segment(COUPURE_DEBUT, COUPURE_FIN);
const apres = segment(COUPURE_FIN, N - 1);
const gardes = Array.from({ length: COUPURE_FIN - COUPURE_DEBUT - 1 }, (_, k) => point(COUPURE_DEBUT + 1 + k));

const XC0 = x(COUPURE_DEBUT);
const XC1 = x(COUPURE_FIN);
const XCM = (XC0 + XC1) / 2;
const Y_PASTILLE = 22;
---

<figure class="mvf mvs" role="img" aria-label={t(lang, 'motion.chainStrip.alt')}>
  <Stat
    lignes={lignes}
    unite={t(lang, 'motion.chainStrip.lost')}
    phrase={t(lang, 'motion.chainStrip.caption')}
  />

  <svg viewBox={`0 0 ${W} ${H}`} class="mvs-svg" aria-hidden="true" focusable="false">
    <!-- La coupure : une bande, du haut du dessin jusqu'au bas. -->
    <rect class="dcs-bande mvs-a" style="animation-name: dcs-bande" x={XC0} y={Y_PASTILLE} width={XC1 - XC0} height={Y1 - Y_PASTILLE} />

    <!-- Avant la coupure : la mesure arrive en direct. -->
    <polyline class="mvs-trace mvs-a mvs-lin" pathLength="1" style="animation-name: dcs-avant; stroke-dasharray: 1" points={avant} />

    <!-- Pendant : chaque mesure est gardée, un point gris à la fois. Le
         groupe entier s'efface quand le trait de rattrapage passe. -->
    <g class="dcs-gardes mvs-a" style="animation-name: dcs-gardes">
      {
        gardes.map(([gx, gy], k) => (
          <circle class="dcs-garde" style={`--k: ${k}`} cx={gx} cy={gy} r="4" />
        ))
      }
    </g>

    <!-- Au retour : les points gardés sont rattrapés d'un trait, puis la
         courbe reprend en direct. -->
    <polyline class="mvs-trace mvs-a mvs-lin" pathLength="1" style="animation-name: dcs-rattrape; stroke-dasharray: 1" points={pendant} />
    <polyline class="mvs-trace mvs-a mvs-lin" pathLength="1" style="animation-name: dcs-apres; stroke-dasharray: 1" points={apres} />

    <!-- La pastille : rouge pendant la coupure, verte au retour. -->
    <g transform={`translate(${XCM} ${Y_PASTILLE})`}>
      <g class="dcs-pastille mvs-a" style="animation-name: dcs-coupe">
        <circle r="18" class="dcs-rouge" />
        <path class="dcs-ic" d="M-6 -6 L6 6 M6 -6 L-6 6" />
      </g>
      <g class="dcs-pastille mvs-a" style="animation-name: dcs-retour">
        <circle r="18" class="dcs-vert" />
        <path class="dcs-ic" d="M-7 0.5 L-2 5.5 L7.5 -5" />
      </g>
    </g>
  </svg>
</figure>

<script>
  import { observerLesFigures } from './observe';

  observerLesFigures();
</script>

<style>
  .dcs-bande {
    fill: var(--color-n-150);
    fill-opacity: 0.55;
  }
  .dcs-garde { fill: var(--color-n-400); }
  .dcs-rouge { fill: var(--color-crit); }
  .dcs-vert { fill: var(--color-normal); }
  .dcs-ic {
    fill: none;
    stroke: #fff;
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dcs-pastille {
    transform-box: fill-box;
    transform-origin: center;
  }
  .dcs-garde {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Au repos, sans mouvement : la courbe entière et la pastille verte. */
  .dcs-gardes { opacity: 0; }
  .dcs-pastille:first-child { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    /* Chaque point gardé entre à son tour, de 1,1 à 2,1 s. */
    .dcs-garde {
      animation: dcs-garde 0.25s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(1.1s + var(--k) * 0.08s);
    }
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    /* Le cycle de quatre secondes, en quatre temps : la mesure arrive
       (0 à 26 %), la liaison tombe et les mesures sont gardées (26 à 55 %),
       la liaison revient et le trou est rattrapé (55 à 66 %), la mesure
       reprend en direct (66 à 90 %). */
    @keyframes dcs-avant {
      0% { stroke-dashoffset: 1; }
      26%, 100% { stroke-dashoffset: 0; }
    }
    @keyframes dcs-bande {
      0%, 25% { opacity: 0; }
      30%, 100% { opacity: 1; }
    }
    @keyframes dcs-coupe {
      0%, 26% { opacity: 0; transform: scale(0.3); }
      31% { opacity: 1; transform: scale(1.15); }
      35%, 53% { opacity: 1; transform: scale(1); }
      57%, 100% { opacity: 0; transform: scale(0.6); }
    }
    @keyframes dcs-retour {
      0%, 54% { opacity: 0; transform: scale(0.3); }
      59% { opacity: 1; transform: scale(1.15); }
      63%, 100% { opacity: 1; transform: scale(1); }
    }
    @keyframes dcs-garde {
      from { opacity: 0; transform: scale(0.2); }
      to { opacity: 1; transform: scale(1); }
    }
    /* Les points restent visibles tant que la liaison est coupée, puis
       s'effacent sous le trait qui les rattrape. */
    @keyframes dcs-gardes {
      0%, 25% { opacity: 1; }
      58% { opacity: 1; }
      68%, 100% { opacity: 0; }
    }
    @keyframes dcs-rattrape {
      0%, 55% { stroke-dashoffset: 1; }
      66%, 100% { stroke-dashoffset: 0; }
    }
    @keyframes dcs-apres {
      0%, 64% { stroke-dashoffset: 1; }
      90%, 100% { stroke-dashoffset: 0; }
    }
  }
</style>
