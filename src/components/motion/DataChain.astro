---
/**
 * V-06 · La chaîne de la donnée.
 *
 * Ce que devient une valeur entre l'équipement et l'écran, et ce qui se
 * passe quand un maillon lâche. Pas une courbe non plus : un schéma de
 * principe, dans l'encre des figures du dossier, avec des faits qui
 * circulent réellement le long des liaisons.
 *
 * Acte 1, la chaîne posée. Acte 2, un fait publié une seule fois, avec son
 * horodatage pris à la source et jamais réécrit en aval. Acte 3, trois
 * consommateurs se servent du même fait : aucun ne retourne interroger
 * l'équipement, aucun n'interroge la base pour du temps réel. Acte 4, la
 * liaison au bus tombe, et le pilote met ses faits en file sur son disque
 * au lieu de les perdre.
 *
 * Les capacités affichées sont celles du code : `bus/outbox.py` du runtime
 * (SQLite en mode WAL, ordre de publication conservé, charge utile et donc
 * horodatage d'origine préservés, plafond d'un million de lignes) et
 * `engine/spill.py` de l'historien, qui couvre la panne de la base et non
 * celle du broker. Deux réserves distinctes, deux pannes distinctes.
 */
import { t, type Lang } from '../../i18n';
import Head from './Head.astro';
import Cartouche from './Cartouche.astro';
import { W, H, X0, X1, Y0, CARD_Y, CARD_H, thousands } from './frame';
import './motion.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ent = (v: number) => thousands(v, lang);

// ── Géométrie de la chaîne ─────────────────────────────────────────────
const AXE = 210;
const BOX_W = 124;
const BOX_H = 56;
const BOX_Y = AXE - BOX_H / 2;

const stations = [
  { x: X0, cle: 'src', sub: 'src_sub' },
  { x: 232, cle: 'drv', sub: 'drv_sub' },
  { x: 388, cle: 'bus', sub: 'bus_sub' },
];

const CONS_X = 540;
const CONS_W = X1 - CONS_X;
const CONS_H = 44;
const consommateurs = [
  { cle: 'live', sub: 'live_sub', y: 118 },
  { cle: 'hist', sub: 'hist_sub', y: 210 },
  { cle: 'rule', sub: 'rule_sub', y: 302 },
];

const S1 = stations[0].x + BOX_W;
const S2A = stations[1].x;
const S2B = stations[1].x + BOX_W;
const S3A = stations[2].x;
const S3B = stations[2].x + BOX_W;

const lien1 = `M ${S1} ${AXE} H ${S2A}`;
const lien2 = `M ${S2B} ${AXE} H ${S3A}`;
const fourche = (y: number) =>
  `M ${S3B} ${AXE} C ${S3B + 22} ${AXE} ${CONS_X - 22} ${y} ${CONS_X} ${y}`;

// La coupure, au milieu de la liaison vers le bus.
const X_COUPURE = (S2B + S3A) / 2;

// La file d'attente locale : une pile de faits sous le pilote.
const FILE_Y = 300;
const FILE_H = 44;
const OUTBOX_MAX = 1000000;

const acts = [
  t(lang, 'motion.chain.act1'),
  t(lang, 'motion.chain.act2'),
  t(lang, 'motion.chain.act3'),
  t(lang, 'motion.chain.act4'),
];
---

<figure class="mvf">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" class="mvf-svg dc" aria-label={t(lang, 'motion.chain.alt')}>
    <Head acts={acts} actWord={t(lang, 'motion.act')} />

    <!-- Les liaisons, posées avant ce qui circule dessus. -->
    <g class="dc-links">
      <path class="dc-link" d={lien1} />
      <path class="dc-link" d={lien2} />
      {consommateurs.map((c) => <path class="dc-link dc-link-fan mv-a" style="animation-name: mv-from-3" d={fourche(c.y)} />)}
    </g>

    <!-- Ce qui circule : un fait, une fois, dans un sens. -->
    <g class="dc-flow mv-a" style="animation-name: dc-flow-in">
      <path class="dc-pulse mv-a" style="animation-name: dc-run-1" d={lien1} />
      <path class="dc-pulse mv-a" style="animation-name: dc-run-2" d={lien2} />
    </g>
    <g class="dc-flow-fan mv-a" style="animation-name: dc-fan-in">
      {consommateurs.map((c) => <path class="dc-pulse mv-a" style="animation-name: dc-run-3" d={fourche(c.y)} />)}
    </g>

    <!-- Les trois stations de la chaîne. -->
    {
      stations.map((s) => (
        <g class={`dc-box${s.cle === 'bus' ? ' dc-box-bus' : ''}`}>
          <rect x={s.x} y={BOX_Y} width={BOX_W} height={BOX_H} rx="5" />
          <rect class="dc-box-rail" x={s.x} y={BOX_Y} width="2.5" height={BOX_H} />
          <text class="dc-box-t" x={s.x + 14} y={AXE - 5}>{t(lang, `motion.chain.${s.cle}`)}</text>
          <text class="dc-box-s" x={s.x + 14} y={AXE + 13}>{t(lang, `motion.chain.${s.sub}`)}</text>
        </g>
      ))
    }

    <!-- Les trois consommateurs. Ils sont là dès le premier acte, sinon la
         chaîne annoncée n'en est pas une ; ce qui arrive au troisième, c'est
         la liaison qui les sert, et le fait qui la parcourt. -->
    <g class="dc-cons mv-a" style="animation-name: dc-cons-in">
      {
        consommateurs.map((c) => (
          <g class="dc-box">
            <rect x={CONS_X} y={c.y - CONS_H / 2} width={CONS_W} height={CONS_H} rx="5" />
            <rect class="dc-box-rail" x={CONS_X} y={c.y - CONS_H / 2} width="2.5" height={CONS_H} />
            <text class="dc-box-t" x={CONS_X + 14} y={c.y - 3}>{t(lang, `motion.chain.${c.cle}`)}</text>
            <text class="dc-box-s" x={CONS_X + 14} y={c.y + 15}>{t(lang, `motion.chain.${c.sub}`)}</text>
          </g>
        ))
      }
    </g>

    <!-- Acte 2 : d'où vient l'horodatage, et pourquoi il ne bouge plus. -->
    <g class="dc-stamp mv-a mv-transient" style="animation-name: mv-mid">
      <line x1={S1 - BOX_W / 2} y1={BOX_Y} x2={S1 - BOX_W / 2} y2={BOX_Y - 26} />
      <line x1={S1 - BOX_W / 2} y1={BOX_Y - 26} x2={S3B} y2={BOX_Y - 26} />
      <line x1={S3B} y1={BOX_Y - 26} x2={S3B} y2={BOX_Y} />
      <text class="dc-stamp-t" x={(S1 - BOX_W / 2 + S3B) / 2} y={BOX_Y - 32} text-anchor="middle">
        {t(lang, 'motion.chain.stamp')}
      </text>
    </g>

    <!-- Acte 3 : ce que la chaîne interdit. -->
    <text class="dc-note mv-a" style="animation-name: mv-from-3" x={X1} y={Y0 - 10} text-anchor="end">
      {t(lang, 'motion.chain.no_reask')}
    </text>

    <!-- Acte 4 : la liaison au bus tombe. Le pilote ne perd rien, il
         empile sur son disque et rejoue dans l'ordre. -->
    <g class="dc-cut mv-a" style="animation-name: mv-from-4">
      <line class="dc-cut-x" x1={X_COUPURE - 8} y1={AXE - 8} x2={X_COUPURE + 8} y2={AXE + 8} />
      <line class="dc-cut-x" x1={X_COUPURE - 8} y1={AXE + 8} x2={X_COUPURE + 8} y2={AXE - 8} />
      <text class="dc-cut-t mv-halo-t" x={X_COUPURE} y={BOX_Y - 10} text-anchor="middle">
        {t(lang, 'motion.chain.cut')}
      </text>
    </g>

    <g class="dc-queue mv-a" style="animation-name: mv-from-4">
      <line class="dc-queue-drop" x1={S2A + BOX_W / 2} y1={BOX_Y + BOX_H} x2={S2A + BOX_W / 2} y2={FILE_Y} />
      <rect x={S2A} y={FILE_Y} width={BOX_W} height={FILE_H} rx="4" />
      <g class="dc-queue-fill">
        {
          [0, 1, 2, 3, 4, 5].map((i) => (
            <rect
              class="mv-a"
              style={`animation-name: dc-stack-${i}`}
              x={S2A + 10 + i * 17.5}
              y={FILE_Y + 10}
              width="11"
              height={FILE_H - 20}
              rx="1.5"
            />
          ))
        }
      </g>
      <text class="dc-queue-t" x={S2A} y={FILE_Y + FILE_H + 15}>
        {t(lang, 'motion.chain.queue')}
      </text>
      <text class="dc-queue-s" x={S2A} y={FILE_Y + FILE_H + 28}>
        {t(lang, 'motion.chain.queue_sub')}
      </text>
    </g>

    <g class="mv-card--brass mv-a" style="animation-name: dc-card" transform={`translate(${X0} ${CARD_Y})`}>
      <rect width={X1 - X0} height={CARD_H} rx="4" />
      <rect class="mv-card-rail" width="3" height={CARD_H} />
      <text class="mv-card-title" x="18" y="19">{t(lang, 'motion.chain.card_title')}</text>
      <text class="mv-card-meta" x="18" y="35">{t(lang, 'motion.chain.card_meta')}</text>
      <text class="mv-card-sum" x={X1 - X0 - 18} y="27" text-anchor="end">
        {ent(OUTBOX_MAX)} {t(lang, 'motion.chain.facts')}
      </text>
    </g>

    <Cartouche
      fig={t(lang, 'motion.chain.fig')}
      caption={t(lang, 'motion.chain.caption')}
      source={t(lang, 'motion.source')}
    />
  </svg>
</figure>

<style>
  .dc { --mv-cycle: 18s; }

  .dc-link { fill: none; stroke: var(--color-n-300); stroke-width: 1.5; }
  .dc-pulse {
    fill: none;
    stroke: var(--color-brass);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 10 300;
    stroke-dashoffset: 310;
  }

  .dc-box rect { fill: var(--color-n-50); }
  .dc-box .dc-box-rail { fill: var(--color-n-300); }
  .dc-box-bus rect { fill: var(--color-brass-bg); }
  .dc-box-bus .dc-box-rail { fill: var(--color-brass); }
  .dc-box-t { font-size: 12.5px; font-weight: 500; fill: var(--color-ink); }
  .dc-box-s {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--color-n-500);
    letter-spacing: 0.02em;
  }

  .dc-stamp line { stroke: var(--color-brass-light); stroke-width: 1; stroke-dasharray: 4 4; }
  .dc-stamp-t {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--color-brass);
    letter-spacing: 0.03em;
  }

  .dc-note {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--color-n-500);
    letter-spacing: 0.03em;
  }

  .dc-cut-x { stroke: var(--color-crit); stroke-width: 2.5; stroke-linecap: round; }
  .dc-cut-t {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--color-crit);
    letter-spacing: 0.03em;
  }

  .dc-queue > rect { fill: none; stroke: var(--color-brass-light); stroke-width: 1.2; }
  .dc-queue-drop { stroke: var(--color-brass-light); stroke-width: 1; stroke-dasharray: 3 4; }
  .dc-queue-fill rect { fill: var(--color-brass-light); }
  .dc-queue-t {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--color-brass);
    letter-spacing: 0.04em;
  }
  .dc-queue-s {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--color-n-500);
    letter-spacing: 0.02em;
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    /* Le fait remonte la chaîne au deuxième acte, puis se distribue au
       troisième. Une passe par acte : ce n'est pas un ruban qui tourne,
       c'est un message qui part une fois. */
    @keyframes dc-flow-in {
      0%, 21% { opacity: 0; }
      26%, 100% { opacity: 1; }
    }
    @keyframes dc-cons-in {
      0%, 47% { opacity: 0.4; }
      52%, 100% { opacity: 1; }
    }
    @keyframes dc-fan-in {
      0%, 47% { opacity: 0; }
      52%, 100% { opacity: 1; }
    }
    @keyframes dc-run-1 {
      0%, 24% { stroke-dashoffset: 310; }
      33%, 100% { stroke-dashoffset: 260; }
    }
    @keyframes dc-run-2 {
      0%, 31% { stroke-dashoffset: 310; }
      42%, 100% { stroke-dashoffset: 260; }
    }
    @keyframes dc-run-3 {
      0%, 52% { stroke-dashoffset: 310; }
      66%, 100% { stroke-dashoffset: 190; }
    }
    @keyframes dc-card {
      0%, 80% { opacity: 0; transform: translate(76px, 442px); }
      88%, 100% { opacity: 1; transform: translate(76px, 434px); }
    }
    @keyframes dc-stack-0 { 0%, 76% { opacity: 0; } 79%, 100% { opacity: 1; } }
    @keyframes dc-stack-1 { 0%, 79% { opacity: 0; } 82%, 100% { opacity: 1; } }
    @keyframes dc-stack-2 { 0%, 82% { opacity: 0; } 85%, 100% { opacity: 1; } }
    @keyframes dc-stack-3 { 0%, 85% { opacity: 0; } 88%, 100% { opacity: 1; } }
    @keyframes dc-stack-4 { 0%, 88% { opacity: 0; } 91%, 100% { opacity: 1; } }
    @keyframes dc-stack-5 { 0%, 91% { opacity: 0; } 94%, 100% { opacity: 1; } }
  }
</style>
