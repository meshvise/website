---
/**
 * V-03 · Décrochage de sous-compteur.
 *
 * Le pari de la figure : la première image ment. Trente minutes de
 * puissance sur une fraiseuse conventionnelle, tracées d'un seul trait,
 * dans une seule couleur. Rien ne signale que dix minutes de ce tracé ne
 * sont pas des mesures mais la même valeur répétée. C'est exactement ce
 * qu'un opérateur voit sur un écran qui ne surveille que la valeur, et
 * c'est pour ça que le tracé est brut au premier acte : la démonstration
 * consiste à retirer ce que le lecteur croyait avoir vu.
 *
 * Le cadrage ne resserre que le temps. Sur un graphe, agrandir la durée
 * sans toucher à l'échelle des kilowatts évite de faire relire l'axe au
 * lecteur alors que la question posée porte sur des minutes.
 *
 * Valeurs du pilote `SUBM1` du jeu de démonstration : Modbus TCP,
 * interrogation toutes les deux secondes, huit points sur quatre machines
 * conventionnelles, scénario `submeter-dropout` déclaré sur le pilote et
 * non sur un point, donc la coupure emporte les huit points et les quatre
 * drapeaux de marche. Un lien qui tombe n'emporte jamais un seul point.
 */
import { mt as t, type Lang } from './text';
import Head from './Head.astro';
import Cartouche from './Cartouche.astro';
import {
  W,
  H,
  X0,
  X1,
  Y0,
  Y1,
  LANE_Y,
  CARD_Y,
  CARD_H,
  cam,
  CAM_WIDE,
  screenAt,
  pinTo,
  pinX,
  PIN_WIDE,
  toPoints,
  step,
  decimal,
} from './frame';
import './motion.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dec = (v: number, n = 1) => decimal(v, n, lang);

// ── La fenêtre et ses quatre instants ──────────────────────────────────
const MINUTES = 30; // de 11:30 à 12:00
const PAS = 0.5;
const V_MAX = 16; // pleine échelle, en kW
const GEL = 12; // 11:42, dernier échantillon reçu
const PERIME = 17; // 11:47, la fraîcheur est dépassée
const COUPURE = 20; // 11:50, le pilote est déclaré injoignable
const RETOUR = 23; // 11:53, la liaison revient
const TOLERANCE = PERIME - GEL;
const TROU = RETOUR - GEL;

const x = (m: number) => X0 + (m / MINUTES) * (X1 - X0);
const y = (v: number) => Y1 - (v / V_MAX) * (Y1 - Y0);

/**
 * Puissance active de la fraiseuse : des cycles d'usinage de quatre
 * minutes, une passe en charge puis un dégagement à vide, plus le bruit de
 * mesure. Suite déterministe, pour que deux constructions du site
 * produisent exactement le même tracé.
 */
const brut = (m: number) => {
  const p = ((m + 2.35) % 4.2) / 4.2;
  const socle = p < 0.66 ? 9.4 + 2.7 * Math.sin(p * 8.2 + 0.4) : 1.8;
  const bruit =
    Math.sin(m * 7.31) * 0.42 + Math.sin(m * 2.91) * 0.28 + Math.sin(m * 1.13) * 0.19;
  return Math.round(Math.max(0.5, socle + bruit) * 10) / 10;
};

const echantillons = (a: number, b: number): Array<[number, number]> => {
  const out: Array<[number, number]> = [];
  for (let m = a; m <= b + 1e-9; m += PAS) out.push([m, brut(m)]);
  return out;
};

const avant = echantillons(0, GEL);
const apres = echantillons(RETOUR, MINUTES);
const V_GEL = avant[avant.length - 1][1];

const ptsAvant = toPoints(avant.map(([m, v]) => [x(m), y(v)]));
const ptsApres = toPoints(apres.map(([m, v]) => [x(m), y(v)]));
const yGel = y(V_GEL);

// ── Les deux resserrements, sur le temps seulement ─────────────────────
const KX2 = MINUTES / 18;
const C2X = x(17);
const KX3 = MINUTES / 8;
const C3X = x(15.5);
const CY = (Y0 + Y1) / 2;
const CAM_2 = cam(C2X, CY, KX2, 1);
const CAM_3 = cam(C3X, CY, KX3, 1);

const horodate = (m: number) => {
  const total = 11 * 60 + 30 + m;
  const h = Math.floor(total / 60);
  const mn = Math.round(total % 60);
  return `${h}:${mn.toString().padStart(2, '0')}`;
};

type Echelle = { gm: number[]; lm: number[]; k: number; cx: number };
const echelles: Echelle[] = [
  { gm: step(0, 30, 5), lm: step(0, 30, 5), k: 1, cx: (X0 + X1) / 2 },
  { gm: step(8, 26, 2), lm: step(8, 26, 4), k: KX2, cx: C2X },
  { gm: step(11.5, 19.5, 1), lm: [12, 14, 16, 18], k: KX3, cx: C3X },
];
const graduations = [0, 4, 8, 12, 16];

const dansPlan = (v: number, min: number, max: number) => v >= min - 0.5 && v <= max + 0.5;
const libM = (e: Echelle) =>
  e.lm
    .map((m) => ({ m, sx: screenAt(x(m), 0, e.k, e.cx, CY, 1).x }))
    .filter((p) => dansPlan(p.sx, X0 + 4, X1 - 4));

// L'ancrage du dernier échantillon reçu, un par cadrage.
const PIN_GEL_2 = pinTo(x(GEL), yGel, KX2, C2X, CY, 1);
const PIN_GEL_3 = pinTo(x(GEL), yGel, KX3, C3X, CY, 1);

// La cote des cinq minutes de tolérance, posée au troisième acte : c'est
// la fenêtre où une supervision qui ne regarde que la valeur ne voit rien.
const COTE_Y = Y0 + 34;
const xMilieu = x((GEL + PERIME) / 2);
const PIN_TXT_2 = pinX(xMilieu, KX2, C2X);
const PIN_TXT_3 = pinX(xMilieu, KX3, C3X);

// ── La voie de qualité : quatre états traversés ────────────────────────
const RUB_Y = LANE_Y;
const RUB_H = 18;
const segments = [
  { etat: 'good', a: 0, b: PERIME, cle: 'motion.meter.q_good' },
  { etat: 'stale', a: PERIME, b: COUPURE, cle: 'motion.meter.q_stale' },
  { etat: 'fail', a: COUPURE, b: RETOUR, cle: 'motion.meter.q_fail' },
  { etat: 'good2', a: RETOUR, b: MINUTES, cle: 'motion.meter.q_good' },
];

const acts = [
  t(lang, 'motion.meter.act1'),
  t(lang, 'motion.meter.act2'),
  t(lang, 'motion.meter.act3'),
  t(lang, 'motion.meter.act4'),
];
---

<figure class="mvf">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    class="mvf-svg md"
    aria-label={t(lang, 'motion.meter.alt')}
    style={`--cam-1:${CAM_WIDE};--cam-2:${CAM_2};--cam-3:${CAM_3}`}
  >
    <defs>
      <clipPath id="md-plot">
        <rect x={X0} y={Y0} width={X1 - X0} height={Y1 - Y0} />
      </clipPath>
    </defs>

    <Head acts={acts} actWord={t(lang, 'motion.act')} />

    <g clip-path="url(#md-plot)">
      <g class="mv-cam mv-a mv-ease" style="animation-name: mv-cam3">
        <g class="mv-grid">
          {graduations.map((v) => <line x1={x(-4)} y1={y(v)} x2={x(34)} y2={y(v)} />)}
        </g>
        {
          echelles.map((e, i) => (
            <g class={`mv-grid mv-a${i > 0 ? ' mv-transient' : ''}`} style={`animation-name: mv-scale-${i + 1}`}>
              {e.gm.map((m) => (
                <line x1={x(m)} y1={Y0 - 10} x2={x(m)} y2={Y1 + 10} />
              ))}
            </g>
          ))
        }

        <polyline class="mv-trace" points={ptsAvant} />
        <polyline class="mv-trace" points={ptsApres} />

        <!-- Le segment que le premier acte fait passer pour une mesure, et
             celui que le deuxième lui substitue. Même géométrie, deux
             encres : la démonstration tient dans ce remplacement. -->
        <line
          class="md-held-raw mv-a mv-transient"
          style="animation-name: mv-act-1"
          x1={x(GEL)}
          y1={yGel}
          x2={x(RETOUR)}
          y2={yGel}
        />
        <line
          class="md-held mv-a"
          style="animation-name: mv-from-2"
          x1={x(GEL)}
          y1={yGel}
          x2={x(RETOUR)}
          y2={yGel}
        />

        <g class="md-cote mv-a mv-transient" style="animation-name: mv-mid">
          <line class="md-cote-drop" x1={x(GEL)} y1={COTE_Y} x2={x(GEL)} y2={Y1 + 10} />
          <line class="md-cote-drop" x1={x(PERIME)} y1={COTE_Y} x2={x(PERIME)} y2={Y1 + 10} />
          <line x1={x(GEL)} y1={COTE_Y} x2={x(PERIME)} y2={COTE_Y} />
          <line x1={x(GEL)} y1={COTE_Y - 5} x2={x(GEL)} y2={COTE_Y + 5} />
          <line x1={x(PERIME)} y1={COTE_Y - 5} x2={x(PERIME)} y2={COTE_Y + 5} />
        </g>
      </g>
    </g>

    <g class="mv-axis">
      {graduations.map((v) => <text x={X0 - 12} y={y(v) + 4} text-anchor="end">{v}</text>)}
      <text class="mv-unit" x={X0 - 12} y={Y0 - 10} text-anchor="end">kW</text>
      {
        echelles.map((e, i) => (
          <g class={`mv-a${i > 0 ? ' mv-transient' : ''}`} style={`animation-name: mv-scale-${i + 1}`}>
            {libM(e).map((p) => (
              <text x={p.sx} y={Y1 + 22} text-anchor="middle">
                {horodate(p.m)}
              </text>
            ))}
          </g>
        ))
      }
    </g>

    <g class="mv-a mv-recycle">
      <!-- Acte 1 : ce que l'on croit regarder. -->
      <text class="md-plain mv-a mv-transient" style="animation-name: mv-act-1" x={X1} y={Y0 - 10} text-anchor="end">
        {t(lang, 'motion.meter.machine')}
      </text>

      <!-- Acte 2 : le dernier échantillon reçu, et ce qui n'en est pas un. -->
      <g
        class="mv-pin mv-a mv-ease"
        style={`animation-name: mv-pin3;--pin-1:${PIN_WIDE};--pin-2:${PIN_GEL_2};--pin-3:${PIN_GEL_3}`}
      >
        <g class="md-last mv-a" style="animation-name: mv-from-2" transform={`translate(${x(GEL).toFixed(1)} ${yGel.toFixed(1)})`}>
          <circle class="md-halo mv-a" style="animation-name: md-pulse" r="6" />
          <circle class="md-dot" r="4" />
          <text class="mv-value" x="12" y="-10">{dec(V_GEL)} kW · {horodate(GEL)}</text>
        </g>
      </g>
      <text class="md-held-t mv-a" style="animation-name: mv-from-2" x={X1} y={Y0 - 10} text-anchor="end">
        {t(lang, 'motion.meter.held')}
      </text>

      <!-- Acte 3 : les cinq minutes où la valeur figée passe encore pour
           bonne. La cote est dessinée dans la caméra, parce que c'est une
           mesure de durée et qu'elle doit s'étirer avec le temps ; ses
           libellés restent dehors et suivent l'abscisse sans grossir. -->
      <g
        class="md-cote-t mv-pin mv-a mv-ease"
        style={`animation-name: mv-pin3;--pin-1:${PIN_WIDE};--pin-2:${PIN_TXT_2};--pin-3:${PIN_TXT_3}`}
      >
        <g class="mv-a mv-transient" style="animation-name: mv-mid">
          <text x={xMilieu} y={COTE_Y - 24} text-anchor="middle">
            {t(lang, 'motion.meter.window')}
          </text>
          <text class="md-cote-len" x={xMilieu} y={COTE_Y - 9} text-anchor="middle">
            {TOLERANCE} min
          </text>
        </g>
      </g>

      <!-- Acte 4 : la qualité de la donnée, sur sa propre voie. Le tracé
           dit ce qui a été mesuré, la voie dit ce que ça valait. -->
      <g class="md-ribbon mv-a" style="animation-name: mv-from-4">
        <text class="mv-lane-t" x={X0} y={RUB_Y - 8}>{t(lang, 'motion.meter.quality')}</text>
        {
          segments.map((s) => (
            <g class={`md-seg md-seg-${s.etat}`}>
              <rect x={x(s.a)} y={RUB_Y} width={x(s.b) - x(s.a)} height={RUB_H} />
              <rect class="md-seg-rail" x={x(s.a)} y={RUB_Y + RUB_H - 2.5} width={x(s.b) - x(s.a)} height="2.5" />
              <text class={`md-seg-t md-seg-t-${s.etat}`} x={(x(s.a) + x(s.b)) / 2} y={RUB_Y + RUB_H + 14} text-anchor="middle">
                {t(lang, s.cle)}
              </text>
            </g>
          ))
        }
      </g>

      <g class="mv-card--crit mv-a" style="animation-name: md-card-1" transform={`translate(${X0} ${CARD_Y})`}>
        <rect width="352" height={CARD_H} rx="4" />
        <rect class="mv-card-rail" width="3" height={CARD_H} />
        <text class="mv-card-title" x="18" y="19">{t(lang, 'motion.meter.alarm_title')}</text>
        <text class="mv-card-meta" x="18" y="35">
          {horodate(COUPURE)} · SUBM1 · {t(lang, 'motion.meter.alarm_scope')}
        </text>
      </g>
      <g class="mv-card--plain mv-a" style="animation-name: md-card-2" transform={`translate(460 ${CARD_Y})`}>
        <text class="mv-card-title" x="0" y="19">{t(lang, 'motion.meter.fix_title')}</text>
        <text class="mv-card-meta" x="0" y="35">
          {horodate(GEL)} → {horodate(RETOUR)} · {TROU} min
        </text>
      </g>
    </g>

    <Cartouche
      fig={t(lang, 'motion.meter.fig')}
      caption={t(lang, 'motion.meter.caption')}
      source={t(lang, 'motion.source')}
    />
  </svg>
</figure>

<style>
  .md { --mv-cycle: 18s; }

  /* Le segment maintenu, dans l'encre du tracé : c'est le mensonge que la
     figure démonte, pas une erreur de couleur. */
  .md-held-raw {
    stroke: var(--color-brass);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .md-held { stroke: var(--color-off); stroke-width: 2; stroke-linecap: round; }
  .md-held-t {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--color-off);
    letter-spacing: 0.04em;
  }
  .md-plain {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--color-n-500);
    letter-spacing: 0.04em;
  }

  .md-last .mv-value { fill: var(--color-off); }
  .md-last-t { fill: var(--color-off); }
  .md-dot { fill: var(--color-off); }
  .md-halo { fill: var(--color-off); opacity: 0.2; }

  .md-cote line { stroke: var(--color-warn); stroke-width: 1.3; }
  .md-cote .md-cote-drop { stroke-width: 1; stroke-dasharray: 3 4; opacity: 0.5; }
  .md-cote-t text {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-warn);
    letter-spacing: 0.02em;
  }
  .md-cote-t .md-cote-len { font-size: 13px; font-weight: 500; }

  .md-seg-good rect, .md-seg-good2 rect { fill: var(--color-normal-bg); }
  .md-seg-good .md-seg-rail, .md-seg-good2 .md-seg-rail { fill: var(--color-normal); }
  .md-seg-stale rect { fill: var(--color-warn-bg); }
  .md-seg-stale .md-seg-rail { fill: var(--color-warn); }
  .md-seg-fail rect { fill: var(--color-crit-bg); }
  .md-seg-fail .md-seg-rail { fill: var(--color-crit); }

  .md-seg-t { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.03em; }
  .md-seg-t-good, .md-seg-t-good2 { fill: var(--color-normal); }
  .md-seg-t-stale { fill: var(--color-warn); }
  .md-seg-t-fail { fill: var(--color-crit); }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes md-pulse {
      0%, 24% { r: 6; opacity: 0; }
      28% { r: 6; opacity: 0.35; }
      44%, 100% { r: 17; opacity: 0; }
    }
    @keyframes md-card-1 {
      0%, 78% { opacity: 0; transform: translate(76px, 442px); }
      86%, 100% { opacity: 1; transform: translate(76px, 434px); }
    }
    @keyframes md-card-2 {
      0%, 89% { opacity: 0; transform: translate(460px, 442px); }
      96%, 100% { opacity: 1; transform: translate(460px, 434px); }
    }
  }
</style>
