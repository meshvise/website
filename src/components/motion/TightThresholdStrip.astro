---
/**
 * V-04 · Alarme au seuil trop serré. Registre dépouillé.
 *
 * Le compteur compte les déclenchements : zéro, puis un, puis huit. Sous
 * lui, la courbe ne bouge pas d'un dixième de degré du premier au dernier
 * jour. Ce qui bouge, c'est le seuil, qui descend à 22,5 °C puis remonte
 * à 24,0. Les huit bâtons rouges tombent exactement entre les deux
 * révisions, et nulle part ailleurs.
 *
 * C'est le seul cas de la série où la courbe est l'élément immobile. La
 * figure le montre en ne lui faisant rien faire : elle est posée dès la
 * première seconde, et c'est le trait de seuil qui se déplace.
 *
 * Valeurs du scénario `crying-wolf` du seed : seuil haut de l'alarme
 * « Huile de coupe » abaissé de 24,0 à 22,5 °C par une révision signée au
 * seizième jour avant aujourd'hui, remis à 24,0 avec une hystérésis d'un
 * degré au sixième. Les jours de déclenchement ne sont pas posés à la
 * main : ce sont ceux où le maximum dépasse le seuil en vigueur.
 */
import { mt as t, type Lang } from './text';
import Stat from './Stat.astro';
import type { Ligne } from './Stat.astro';
import { toPoints, decimal } from './frame';
import './strip.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dec = (v: number, n = 1) => decimal(v, n, lang);

// ── Les chiffres du scénario ───────────────────────────────────────────
const JOURS = 21;
const SEUIL_LARGE = 24.0;
const SEUIL_SERRE = 22.5;
const J_SERRAGE = 5; // seize jours avant aujourd'hui
const J_RETOUR = 15; // six jours avant aujourd'hui
const FENETRE = J_RETOUR - J_SERRAGE + 1;

/** Maximum journalier de la température de départ d'huile de coupe. Le
 *  groupe froid fait le même après-midi du premier au dernier jour. */
const serie = Array.from({ length: JOURS + 1 }, (_, j) => {
  const v =
    22.66 + Math.sin(j * 0.911) * 0.22 + Math.sin(j * 3.113) * 0.13 + Math.sin(j * 0.617) * 0.09;
  return Math.round(v * 100) / 100;
});
const seuilDuJour = (j: number) => (j >= J_SERRAGE && j <= J_RETOUR ? SEUIL_SERRE : SEUIL_LARGE);
const declenchements = serie.map((v, j) => (v > seuilDuJour(j) ? j : -1)).filter((j) => j >= 0);

// Le compteur suit le journal : il monte d'un cran à chaque déclenchement.
const lignes: Ligne[] = Array.from({ length: 31 }, (_, i) => {
  const j = (i / 30) * JOURS;
  const n = declenchements.filter((d) => d <= j).length;
  return { valeur: String(n), ton: n > 0 ? 'crit' : 'ink' };
});

// ── La bande : l'axe est tronqué sur le demi-degré où la mesure vit ────
const W = 720;
const H = 220;
const X0 = 6;
const X1 = 714;
const Y0 = 16;
const Y1 = 176;
const V_MIN = 22.25;
const V_MAX = 23.05;
const TICK_H = 26; // la voie des déclenchements, sous la bande

const x = (j: number) => X0 + (j / JOURS) * (X1 - X0);
const y = (v: number) => Y1 - ((v - V_MIN) / (V_MAX - V_MIN)) * (Y1 - Y0);

const trace = toPoints(serie.map((v, j) => [x(j), y(v)]));
const ySerre = y(SEUIL_SERRE);

// Le seuil, en trois marches. Seule celle du milieu entre dans le cadre :
// 24,0 °C est très au-dessus de l'intervalle utile, et c'est le propos.
const marche = toPoints([
  [x(0), Y0 - 30],
  [x(J_SERRAGE), Y0 - 30],
  [x(J_SERRAGE), ySerre],
  [x(J_RETOUR), ySerre],
  [x(J_RETOUR), Y0 - 30],
  [x(JOURS), Y0 - 30],
]);
---

<figure class="mvf mvs" role="img" aria-label={t(lang, 'motion.thresholdStrip.alt')}>
  <Stat
    lignes={lignes}
    unite={t(lang, 'motion.thresholdStrip.fires')}
    phrase={`${t(lang, 'motion.thresholdStrip.caption_a')} ${FENETRE} ${t(lang, 'motion.thresholdStrip.days')}`}
  />

  <svg viewBox={`0 0 ${W} ${H}`} class="mvs-svg" aria-hidden="true" focusable="false">
    <!-- La fenêtre où le seuil valait 22,5 : c'est elle qui rend la
         coïncidence avec la salve d'alarmes évidente. -->
    <rect
      class="mvs-gap tts-window mvs-a"
      style="animation-name: tts-window"
      x={x(J_SERRAGE)}
      y={Y0}
      width={x(J_RETOUR) - x(J_SERRAGE)}
      height={Y1 - Y0}
    />

    <!-- Le procédé. Il est là dès la première seconde et il ne bougera
         plus : c'est l'élément fixe de la figure. -->
    <polyline class="mvs-trace" points={trace} />

    <!-- Le seuil, qui descend puis remonte. C'est lui qui se déplace. -->
    <polyline class="mvs-limit tts-step mvs-a" style="animation-name: tts-step" points={marche} />
    <text class="mvs-limit-t mvs-a" style="animation-name: tts-step" x={x(J_SERRAGE) + 8} y={ySerre - 11}>
      {dec(SEUIL_SERRE)} °C
    </text>

    <!-- Le journal : un bâton par déclenchement, dans l'ordre. -->
    <g class="tts-log">
      {
        declenchements.map((j, i) => (
          <rect
            class="mvs-tick mvs-a"
            style={`animation-name: tts-tick-${i}`}
            x={x(j) - 2}
            y={Y1 + 14}
            width="4"
            height={TICK_H}
            rx="1"
          />
        ))
      }
    </g>
  </svg>

  <div class="mvs-axis" aria-hidden="true">
    <span>
      {`${t(lang, 'motion.spindleStrip.ago_pre')} ${JOURS} ${t(lang, 'motion.spindleStrip.ago_post')}`.trim()}
    </span>
    <span>{t(lang, 'motion.spindleStrip.now')}</span>
  </div>
</figure>

<script>
  import { observerLesFigures } from './observe';

  observerLesFigures();
</script>

<style>
  .tts-window { fill-opacity: 0.08; }
  .tts-step { fill: none; }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes tts-window {
      0%, 8% { opacity: 0; }
      22%, 100% { opacity: 1; }
    }
    @keyframes tts-step {
      0%, 10% { opacity: 0; }
      24%, 100% { opacity: 1; }
    }
    /* Les huit bâtons tombent dans l'ordre du journal, entre 26 et 62 % du
       cycle, au même rythme que le compteur qui les additionne. */
    @keyframes tts-tick-0 { 0%, 26% { opacity: 0; transform: scaleY(0); } 31%, 100% { opacity: 1; transform: scaleY(1); } }
    @keyframes tts-tick-1 { 0%, 30% { opacity: 0; transform: scaleY(0); } 35%, 100% { opacity: 1; transform: scaleY(1); } }
    @keyframes tts-tick-2 { 0%, 34% { opacity: 0; transform: scaleY(0); } 39%, 100% { opacity: 1; transform: scaleY(1); } }
    @keyframes tts-tick-3 { 0%, 38% { opacity: 0; transform: scaleY(0); } 43%, 100% { opacity: 1; transform: scaleY(1); } }
    @keyframes tts-tick-4 { 0%, 42% { opacity: 0; transform: scaleY(0); } 47%, 100% { opacity: 1; transform: scaleY(1); } }
    @keyframes tts-tick-5 { 0%, 48% { opacity: 0; transform: scaleY(0); } 53%, 100% { opacity: 1; transform: scaleY(1); } }
    @keyframes tts-tick-6 { 0%, 52% { opacity: 0; transform: scaleY(0); } 57%, 100% { opacity: 1; transform: scaleY(1); } }
    @keyframes tts-tick-7 { 0%, 56% { opacity: 0; transform: scaleY(0); } 61%, 100% { opacity: 1; transform: scaleY(1); } }
  }
</style>
