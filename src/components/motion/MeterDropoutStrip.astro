---
/**
 * V-03 · Décrochage de sous-compteur. Registre dépouillé.
 *
 * Le compteur de tête fait ici tout le travail, et il le fait en cessant
 * de travailler. Il suit la puissance de la fraiseuse minute après minute,
 * puis se fige sur 7,7 kW et passe au gris pendant que le crayon continue,
 * tout droit. C'est exactement ce que voit un opérateur devant un écran
 * qui ne surveille que la valeur : un chiffre stable, plausible, et faux.
 *
 * Le tracé raconte la même chose en deux encres : laiton pour ce qui est
 * mesuré, gris pour ce qui n'est que maintenu.
 *
 * Valeurs du pilote `SUBM1` du jeu de démonstration : Modbus TCP, huit
 * points sur quatre machines conventionnelles, scénario `submeter-dropout`
 * déclaré sur le pilote et non sur un point, donc la coupure emporte les
 * huit points. Un lien qui tombe n'emporte jamais un seul point.
 */
import { mt as t, type Lang } from './text';
import Stat from './Stat.astro';
import type { Ligne } from './Stat.astro';
import { toPoints, polylineLength, decimal } from './frame';
import './strip.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dec = (v: number, n = 1) => decimal(v, n, lang);

// ── La fenêtre et ses trois instants ───────────────────────────────────
const MINUTES = 30; // de 11:30 à 12:00
const GEL = 12; // 11:42, dernier échantillon reçu
const RETOUR = 23; // 11:53, la liaison revient
const TROU = RETOUR - GEL;

/** Puissance active de la fraiseuse : des cycles d'usinage de quatre
 *  minutes, une passe en charge puis un dégagement à vide. */
const brut = (m: number) => {
  const p = ((m + 2.35) % 4.2) / 4.2;
  const socle = p < 0.66 ? 9.4 + 2.7 * Math.sin(p * 8.2 + 0.4) : 1.8;
  const bruit =
    Math.sin(m * 7.31) * 0.42 + Math.sin(m * 2.91) * 0.28 + Math.sin(m * 1.13) * 0.19;
  return Math.round(Math.max(0.5, socle + bruit) * 10) / 10;
};

const V_GEL = brut(GEL);

// Le compteur : la mesure jusqu'au gel, puis la même valeur répétée. Il
// n'invente rien, il fait ce que fait le cache d'un superviseur.
const PAS = MINUTES / 30;
const lignes: Ligne[] = Array.from({ length: 31 }, (_, i) => {
  const m = i * PAS;
  const fige = m >= GEL;
  return { valeur: dec(fige ? V_GEL : brut(m), 1), ton: fige ? 'off' : 'ink' };
});

// ── La bande ───────────────────────────────────────────────────────────
const W = 720;
const H = 200;
const X0 = 6;
const X1 = 714;
const Y0 = 16;
const Y1 = 186;
const V_MAX = 14;

const x = (m: number) => X0 + (m / MINUTES) * (X1 - X0);
const y = (v: number) => Y1 - (v / V_MAX) * (Y1 - Y0);

const echantillons = (a: number, b: number): Array<[number, number]> => {
  const out: Array<[number, number]> = [];
  for (let m = a; m <= b + 1e-9; m += 0.5) out.push([x(m), y(brut(m))]);
  return out;
};
const avant = echantillons(0, GEL);
const apres = echantillons(RETOUR, MINUTES);
const yGel = y(V_GEL);

const tAvant = toPoints(avant);
const tApres = toPoints(apres);
const lAvant = polylineLength(avant);
const lApres = polylineLength(apres);

const horodate = (m: number) => {
  const total = 11 * 60 + 30 + m;
  return `${Math.floor(total / 60)}:${Math.round(total % 60)
    .toString()
    .padStart(2, '0')}`;
};
---

<figure class="mvf mvs" role="img" aria-label={t(lang, 'motion.meterStrip.alt')}>
  <Stat
    lignes={lignes}
    unite="kW"
    phrase={`${t(lang, 'motion.meterStrip.caption_a')} ${TROU} ${t(lang, 'motion.meterStrip.minutes')}`}
  />

  <svg viewBox={`0 0 ${W} ${H}`} class="mvs-svg" aria-hidden="true" focusable="false">
    <!-- Ce qui est mesuré. -->
    <polyline
      class="mvs-trace mvs-a mvs-lin"
      style={`animation-name: mds-draw-a; --len: ${lAvant.toFixed(0)}; stroke-dasharray: var(--len)`}
      points={tAvant}
    />

    <!-- Ce qui n'est que maintenu : même hauteur, autre encre. La ligne est
         plate parce que la dernière valeur reçue ne bouge plus. -->
    <line
      class="mvs-held mvs-a mvs-lin"
      style={`animation-name: mds-held; --len: ${(x(RETOUR) - x(GEL)).toFixed(0)}; stroke-dasharray: var(--len)`}
      x1={x(GEL)}
      y1={yGel}
      x2={x(RETOUR)}
      y2={yGel}
    />

    <polyline
      class="mvs-trace mvs-a mvs-lin"
      style={`animation-name: mds-draw-c; --len: ${lApres.toFixed(0)}; stroke-dasharray: var(--len)`}
      points={tApres}
    />

    <!-- Le dernier échantillon reçu. -->
    <circle class="mvs-ping mvs-ping--off mvs-a" style="animation-name: mds-ping" cx={x(GEL)} cy={yGel} r="6" />
    <circle class="mvs-dot mvs-dot--off mvs-a" style="animation-name: mds-dot" cx={x(GEL)} cy={yGel} r="5" />
    <text class="mvs-ref-t mvs-a" style="animation-name: mds-label" x={x(GEL) + 14} y={yGel - 12}>
      {t(lang, 'motion.meterStrip.held')}
    </text>
  </svg>

  <div class="mvs-axis" aria-hidden="true">
    <span>{horodate(0)}</span>
    <span>{horodate(MINUTES)}</span>
  </div>
</figure>

<script>
  import { observerLesFigures } from './observe';

  observerLesFigures();
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    /* Les trois morceaux du tracé se posent à la suite, au rythme du
       compteur : la mesure jusqu'à 11:42, le maintien, puis la mesure qui
       reprend. Le découpage est celui de l'horodatage, pas une cadence
       choisie. */
    @keyframes mds-draw-a {
      0% { stroke-dashoffset: var(--len); }
      15%, 100% { stroke-dashoffset: 0; }
    }
    @keyframes mds-held {
      0%, 15% { stroke-dashoffset: var(--len); }
      29%, 100% { stroke-dashoffset: 0; }
    }
    @keyframes mds-draw-c {
      0%, 29% { stroke-dashoffset: var(--len); }
      38%, 100% { stroke-dashoffset: 0; }
    }
    @keyframes mds-dot {
      0%, 15% { opacity: 0; transform: scale(0); }
      20% { opacity: 1; transform: scale(1.4); }
      26%, 100% { opacity: 1; transform: scale(1); }
    }
    @keyframes mds-ping {
      0%, 15% { opacity: 0; r: 6; }
      18% { opacity: 0.5; r: 6; }
      38%, 100% { opacity: 0; r: 28; }
    }
    @keyframes mds-label {
      0%, 44% { opacity: 0; transform: translateY(6px); }
      58%, 100% { opacity: 1; transform: translateY(0); }
    }
  }
</style>
