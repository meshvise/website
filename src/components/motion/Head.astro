---
/**
 * Le bandeau d'acte, commun aux six figures : le titre de l'acte en cours à
 * gauche, une jauge de quatre segments à droite.
 *
 * C'est ce bandeau qui rend la figure autonome. Sans lui, une illustration
 * animée posée à côté d'un paragraphe demande au lecteur de deviner ce
 * qu'elle est en train de lui montrer ; avec lui, elle le dit.
 *
 * Les quatre titres se relaient sur les bornes fixes de `motion.css`. La
 * jauge n'est pas décorative : elle dit au lecteur où en est la séquence,
 * donc combien de temps attendre s'il veut la voir en entier.
 *
 * Ce composant est présent dans chacune des six figures : c'est donc lui
 * qui embarque `observe.ts`, pour que le module suive les figures partout
 * où elles vont sans qu'une page ait à y penser.
 */
import { HEAD_BASE, HEAD_RULE, GAUGE_W, GAUGE_H, GAUGE_Y, X0, X1 } from './frame';

interface Props {
  /** Les quatre titres d'acte, dans l'ordre. */
  acts: string[];
  /** Le mot « acte » dans la langue de la page. */
  actWord: string;
}

const { acts, actWord } = Astro.props;
const seg = (GAUGE_W - 3 * 4) / 4;
const gx = X1 - GAUGE_W;
---

<g class="mv-head">
  {
    acts.map((label, i) => (
      <text class={`mv-a${i < acts.length - 1 ? ' mv-transient' : ''}`} x={X0} y={HEAD_BASE} style={`animation-name: mv-act-${i + 1}`}>
        <tspan class="mv-head-n">{actWord} {i + 1}</tspan>
        <tspan class="mv-head-label" dx="10">{label}</tspan>
      </text>
    ))
  }
  <g class="mv-gauge">
    {
      acts.map((_, i) => (
        <>
          <rect class="mv-gauge-slot" x={gx + i * (seg + 4)} y={GAUGE_Y} width={seg} height={GAUGE_H} rx="1" />
          <rect
            class="mv-gauge-fill mv-a"
            x={gx + i * (seg + 4)}
            y={GAUGE_Y}
            width={seg}
            height={GAUGE_H}
            rx="1"
            style={`animation-name: mv-fill-${i + 1}`}
          />
        </>
      ))
    }
  </g>
  <line class="mv-head-rule" x1={X0} y1={HEAD_RULE} x2={X1} y2={HEAD_RULE} />
</g>

<script>
  import { observerLesFigures } from './observe';

  observerLesFigures();
</script>
