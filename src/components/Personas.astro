---
/**
 * Cinq métiers, en liste. Tout est visible : pas d'onglets. Chaque ligne
 * est un relevé à deux colonnes, le problème et ce que Meshvise change.
 */
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const personas = [
  { id: 'director',    cta: href(lang, 'why', 'calc') },
  { id: 'maintenance', cta: null },
  { id: 'production',  cta: null },
  { id: 'quality',     cta: null },
  { id: 'integrator',  cta: href(lang, 'integrators') },
] as const;
---

<section id="personas" class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 class="t-page">{t(lang, 'home.personas.title')}</h2>
    </div>

    <div class="border-t border-line">
      {personas.map((p) => (
        <div class="grid lg:grid-cols-12 gap-x-10 gap-y-3 py-7 border-b border-line">
          <h3 class="lg:col-span-3 text-[17px] font-medium text-ink">{t(lang, `home.personas.${p.id}.label`)}</h3>
          <div class="lg:col-span-4">
            <div class="text-[12px] text-muted mb-1.5">{t(lang, 'common.the_problem')}</div>
            <p class="t-body">{t(lang, `home.personas.${p.id}.pain`)}</p>
          </div>
          <div class="lg:col-span-5">
            <div class="text-[12px] text-muted mb-1.5">{t(lang, 'common.with_meshvise')}</div>
            <p class="t-body text-ink">{t(lang, `home.personas.${p.id}.gain`)}</p>
            {p.cta && <a href={p.cta} class="link inline-block mt-3 text-[14px]">{t(lang, `home.personas.${p.id}.cta`)}</a>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
