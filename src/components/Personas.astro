---
/**
 * Ce n'est pas l'outil d'un service.
 *
 * Cinq métiers, de l'atelier à la direction, et une seule phrase visible à la
 * fois. C'est la forme qui concilie les deux contraintes de la section : dire
 * qu'une supervision n'appartient pas à un service, sans étaler cinq encadrés
 * qui prouveraient l'inverse en montrant cinq bénéfices parallèles.
 *
 * Les noms des métiers SONT la navigation, plutôt que des pastilles anonymes :
 * ils restent tous lisibles, donc le balayage de la hiérarchie se voit sans
 * cliquer, et la diapositive n'a plus à répéter le nom du métier actif.
 *
 * Trois points de construction qui ne se voient pas :
 *
 * - Les diapositives sont empilées dans une même cellule de grille. Le bloc
 *   prend la hauteur de la plus longue et ne saute jamais d'une vue à l'autre,
 *   sans hauteur réservée à la main.
 * - L'état de départ est dans le HTML, pas posé par le script : aucune vue ne
 *   clignote au chargement, et les cinq phrases restent dans le document pour
 *   les moteurs et les robots qui le lisent.
 * - L'avance automatique s'arrête définitivement dès que le visiteur touche un
 *   onglet. Reprendre la main sur un carrousel qui continue de tourner est la
 *   façon la plus sûre de le rendre pénible.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = (lang === 'fr' ? fr : en).home.personas;
const roles = dict.roles as { label: string; line: string }[];

/** Durée d'affichage d'une vue, en millisecondes. */
const INTERVAL = 4200;
---

<section id="personas" class="section">
  <div class="wrap">
    <h2 class="t-page head">{t(lang, 'home.personas.title')}</h2>

    <div class="reel" data-reel data-interval={INTERVAL}>
      <div class="tabs" role="tablist" aria-label={dict.aria}>
        {roles.map((r, i) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`persona-tab-${i}`}
            aria-controls={`persona-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="tab-label">{r.label}</span>
            <span class="tab-rule" aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <div class="stage">
        {roles.map((r, i) => (
          <div
            role="tabpanel"
            class:list={['slide', i === 0 && 'is-on']}
            id={`persona-panel-${i}`}
            aria-labelledby={`persona-tab-${i}`}
          >
            <p class="line">{r.line}</p>
          </div>
        ))}
      </div>
    </div>

    <p class="note">{t(lang, 'home.personas.note')}</p>
  </div>
</section>

<script>
  /**
   * Carrousel d'onglets. Le HTML arrive déjà dans son état de départ : le
   * script ne fait que déplacer l'état, jamais l'établir.
   */
  const calme = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const onglets = Array.from(reel.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const vues = Array.from(reel.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (onglets.length < 2) return;

    const duree = Number(reel.dataset.interval) || 4200;
    let actif = Math.max(0, onglets.findIndex((o) => o.getAttribute('aria-selected') === 'true'));
    let minuteur: number | undefined;
    let rendu = false;
    let visible = true;
    let suspendu = false;

    function montrer(i: number, donnerLeFocus = false) {
      actif = (i + onglets.length) % onglets.length;
      onglets.forEach((o, n) => {
        const est = n === actif;
        o.setAttribute('aria-selected', est ? 'true' : 'false');
        o.tabIndex = est ? 0 : -1;
      });
      vues.forEach((v, n) => v.classList.toggle('is-on', n === actif));
      if (donnerLeFocus) onglets[actif].focus();
    }

    function arreter() {
      if (minuteur !== undefined) window.clearInterval(minuteur);
      minuteur = undefined;
    }

    function relancer() {
      arreter();
      if (rendu || calme.matches || !visible || suspendu) return;
      minuteur = window.setInterval(() => montrer(actif + 1), duree);
    }

    function rendreLaMain() {
      rendu = true;
      arreter();
    }

    onglets.forEach((o, i) => {
      o.addEventListener('click', () => {
        rendreLaMain();
        montrer(i);
      });
    });

    reel.addEventListener('keydown', (e) => {
      const k = e.key;
      const pas = k === 'ArrowRight' ? 1 : k === 'ArrowLeft' ? -1 : 0;
      if (pas === 0 && k !== 'Home' && k !== 'End') return;
      e.preventDefault();
      rendreLaMain();
      if (k === 'Home') montrer(0, true);
      else if (k === 'End') montrer(onglets.length - 1, true);
      else montrer(actif + pas, true);
    });

    // Survol et focus suspendent l'avance, sans l'annuler.
    reel.addEventListener('pointerenter', () => { suspendu = true; arreter(); });
    reel.addEventListener('pointerleave', () => { suspendu = false; relancer(); });
    reel.addEventListener('focusin', () => { suspendu = true; arreter(); });
    reel.addEventListener('focusout', () => { suspendu = false; relancer(); });

    // Hors écran, rien ne tourne : personne ne regarde.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entrees) => {
          visible = entrees[0].isIntersecting;
          relancer();
        },
        { threshold: 0.25 }
      ).observe(reel);
    }

    calme.addEventListener('change', relancer);
    relancer();
  });
</script>

<style>
  .head { max-width: 24ch; }

  .reel { margin-top: 2.5rem; }

  /* Les noms font office de navigation : tous lisibles, l'actif seul en plein
     contraste. Le balayage de la hiérarchie se voit donc sans cliquer. */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
  }
  .tab {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    font-size: clamp(1.125rem, 2.1vw, 1.4375rem);
    font-weight: 300;
    letter-spacing: -0.015em;
    color: var(--color-n-500);
    cursor: pointer;
    transition: color 180ms ease;
  }
  .tab:hover { color: var(--color-ink-2); }
  .tab[aria-selected="true"] { color: var(--color-ink); }
  .tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Le filet marque l'actif par la forme autant que par la couleur : le
     changement ne repose jamais sur la seule teinte. */
  .tab-rule {
    display: block;
    height: 2px;
    margin-top: 0.5rem;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tab[aria-selected="true"] .tab-rule { transform: scaleX(1); }

  /* Les vues se superposent dans une même cellule : la scène prend la hauteur
     de la plus longue, donc rien ne saute d'une vue à l'autre. */
  .stage {
    display: grid;
    margin-top: 2.25rem;
  }
  /* La sortante disparaît d'un coup, seule l'entrante est animée. Un fondu
     croisé ferait lire deux phrases superposées pendant 320 ms, ce qui est
     illisible sur du texte long : c'est acceptable sur une image, jamais sur
     une ligne qu'on est en train de lire. */
  .slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
  }
  .slide.is-on {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: no-preference) {
    .slide.is-on {
      animation: persona-entree 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }
  @keyframes persona-entree {
    from {
      opacity: 0;
      transform: translateY(0.375rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .line {
    margin: 0;
    max-width: 38rem;
    font-size: clamp(1.375rem, 2.7vw, 1.875rem);
    font-weight: 300;
    line-height: 1.42;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .note {
    margin: 3rem 0 0;
    font-size: 1.1875rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--color-ink-2);
    max-width: 52ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-rule,
    .tab {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    /* Les onglets passent sur deux ou trois lignes : sans interligne, le filet
       de l'actif vient toucher le nom de la ligne suivante. */
    .tabs { gap: 0.75rem 1.25rem; }
    .stage { margin-top: 1.75rem; }
    .note { margin-top: 2.25rem; font-size: 1.0625rem; }
  }
</style>
