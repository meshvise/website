---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const personas = ['p1', 'p2', 'p3', 'p4'] as const;
---

<section id="personas" class="px-6 py-24 md:py-32 border-t border-border/60">
  <div class="mx-auto max-w-6xl">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="section-eyebrow justify-center">{t(lang, 'personas.eyebrow')}</div>
      <h2 class="section-title">{t(lang, 'personas.title')}</h2>
      <p class="section-lede mx-auto">{t(lang, 'personas.subtitle')}</p>
    </div>

    <!-- Subgrid alignment: parent grid declares 4 rows (role / context /
         pain / fit) ; each card uses grid-rows-subgrid so its 4 children
         snap to the parent rows. Result: the dividers and "LE PAIN"
         labels align horizontally even when context paragraphs vary in
         length. The 1fr on context absorbs the slack. -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 lg:[grid-template-rows:auto_1fr_auto_auto]">
      {personas.map((id) => (
        <article class="bg-surface rounded-lg border border-border p-7 lg:grid lg:grid-rows-subgrid lg:row-span-4 flex flex-col">
          <h3 class="font-semibold text-text text-[17px] tracking-tight mb-3 lg:mb-0">
            {t(lang, `personas.${id}.role`)}
          </h3>
          <p class="text-[14px] text-muted-strong leading-relaxed mb-4 lg:mb-0 lg:py-3">
            {t(lang, `personas.${id}.context`)}
          </p>

          <div class="mt-auto lg:mt-0 pt-4 border-t border-border/70">
            <span class="block text-[10px] font-mono uppercase tracking-wider text-muted mb-1">{t(lang, 'personas.pain_label')}</span>
            <p class="text-[13.5px] text-text leading-relaxed">{t(lang, `personas.${id}.pain`)}</p>
          </div>
          <div class="pt-3">
            <span class="block text-[10px] font-mono uppercase tracking-wider text-brand mb-1">{t(lang, 'personas.fit_label')}</span>
            <p class="text-[13.5px] text-text leading-relaxed">{t(lang, `personas.${id}.fit`)}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

