---
/**
 * Ce n'est pas l'outil d'un service.
 *
 * La section entière tient en trois éléments : le titre, onze métiers, une
 * ligne. Rien d'autre, et c'est délibéré.
 *
 * Les versions précédentes prouvaient l'inverse de ce qu'elles disaient : en
 * donnant à chaque métier son encadré et sa phrase, elles montraient quatre
 * bénéfices parallèles, c'est-à-dire une segmentation. L'énumération continue
 * fait le contraire. Onze noms séparés par un point médian se lisent comme une
 * seule population et non comme onze cas, et le nombre suffit à écarter l'idée
 * que ce serait l'outil de la maintenance.
 *
 * La ligne de conclusion porte les deux dimensions que l'énumération ne couvre
 * pas seule : la source unique, et l'indifférence au secteur, qui tient à ce
 * qu'on se branche sur des protocoles et non sur un métier.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const roles = (lang === 'fr' ? fr : en).home.personas.roles as string[];
---

<section id="personas" class="section">
  <div class="wrap">
    <h2 class="t-page head">{t(lang, 'home.personas.title')}</h2>

    <ul class="roles">
      {roles.map((r) => <li>{r}</li>)}
    </ul>

    <p class="note">{t(lang, 'home.personas.note')}</p>
  </div>
</section>

<style>
  .head { max-width: 24ch; }

  /* L'énumération est le contenu de la section, donc elle porte l'échelle d'un
     titre. Graisse légère : c'est une liste de noms, pas une affirmation à
     crier. */
  .roles {
    list-style: none;
    margin: 2.75rem 0 0;
    padding: 0;
    max-width: 48rem;
    /* Flex plutot qu'inline : un li en display:inline qui passe a la ligne
       fait entrer l'union de ses fragments dans le debordement du document,
       soit 121 px de defilement horizontal parasite a 1440 px. En flex, chaque
       nom reste un bloc, ne se coupe jamais en deux lignes, et rien ne
       deborde. */
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.5em;
    font-size: clamp(1.375rem, 3vw, 2.125rem);
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  /* Le séparateur porte l'accent : c'est le seul endroit coloré de la section,
     et il lie les noms au lieu de les découper. */
  .roles li::after {
    content: "·";
    color: var(--color-accent);
    margin-inline-start: 0.5em;
  }
  .roles li:last-child::after { content: none; }

  /* La ligne porte la these ; sous des noms a 34 px elle passerait pour une
     note de bas de page a 17 px. */
  .note {
    margin: 2.75rem 0 0;
    font-size: 1.1875rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--color-ink-2);
    max-width: 52ch;
  }

  @media (max-width: 640px) {
    .roles { margin-top: 2rem; line-height: 1.45; }
    .note { margin-top: 2rem; font-size: 1rem; }
  }
</style>
