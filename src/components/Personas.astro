---
/**
 * Ce n'est pas l'outil d'un service.
 *
 * Quatre métiers, de l'atelier à la direction, et une seule vue à la fois.
 * C'est la forme qui concilie les deux contraintes de la section : dire qu'une
 * supervision n'appartient pas à un service, sans étaler quatre encadrés qui
 * prouveraient l'inverse en montrant quatre bénéfices parallèles.
 *
 * Les noms des métiers SONT la navigation, plutôt que des pastilles anonymes :
 * ils restent tous lisibles, donc le balayage de la hiérarchie se voit sans
 * cliquer, et la diapositive n'a plus à répéter le nom du métier actif.
 *
 * Les illustrations viennent des planches isométriques de `value-chain`, qui
 * dormaient dans le dépôt sans être référencées nulle part. Trois des quatre
 * sont des recadrages de la même planche d'atelier : elle porte quatre scènes
 * distinctes, chacune avec son personnage, donc une seule source donne une
 * famille cohérente au lieu de quatre images disparates. La quatrième vient
 * de la planche de direction. `analytics.jpg` reste de côté, 595 px de large
 * contre 1644 pour les autres : la différence de définition se verrait.
 *
 * Trois points de construction qui ne se voient pas :
 *
 * - Les vues sont empilées dans une même cellule de grille. La scène prend la
 *   hauteur de la plus haute et ne saute jamais, sans hauteur posée à la main.
 * - L'état de départ est dans le HTML, pas posé par le script : aucune vue ne
 *   clignote au chargement, et les quatre phrases restent dans le document pour
 *   les moteurs et les robots qui le lisent.
 * - L'avance automatique s'arrête définitivement dès que le visiteur touche un
 *   onglet. Reprendre la main sur un carrousel qui continue de tourner est la
 *   façon la plus sûre de le rendre pénible.
 */
import { Image } from 'astro:assets';
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import { t, type Lang } from '../i18n';

import operateur from '../assets/personas/operateur.jpg';
import maintenance from '../assets/personas/maintenance.jpg';
import methodes from '../assets/personas/methodes.jpg';
import direction from '../assets/personas/direction.jpg';

interface Props {
  lang: Lang;
}

/**
 * Les visuels sont indexés par identifiant et non par position : réordonner
 * les métiers dans le dictionnaire ne décale pas les images.
 */
const VISUELS = { operateur, maintenance, methodes, direction } as const;

const { lang } = Astro.props;
const dict = (lang === 'fr' ? fr : en).home.personas;
const roles = dict.roles as {
  id: keyof typeof VISUELS;
  label: string;
  line: string;
  alt: string;
}[];

/** Durée d'affichage d'une vue, en millisecondes. */
const INTERVAL = 4200;

/** Largeur d'affichage de l'illustration, en pixels CSS. Format 3:2. */
const LARGEUR = 460;
---

<section id="personas" class="section">
  <div class="wrap">
    <h2 class="t-page head">{t(lang, 'home.personas.title')}</h2>

    <div class="reel" data-reel data-interval={INTERVAL}>
      <div class="tabs" role="tablist" aria-label={dict.aria}>
        {roles.map((r, i) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`persona-tab-${i}`}
            aria-controls={`persona-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="tab-label">{r.label}</span>
            <span class="tab-rule" aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <div class="stage">
        {roles.map((r, i) => (
          <div
            role="tabpanel"
            class:list={['slide', i === 0 && 'is-on']}
            id={`persona-panel-${i}`}
            aria-labelledby={`persona-tab-${i}`}
          >
            <p class="line">{r.line}</p>
            <figure class="shot">
              <Image
                src={VISUELS[r.id]}
                alt={r.alt}
                widths={[LARGEUR, LARGEUR * 2]}
                sizes={`(max-width: 900px) 100vw, ${LARGEUR}px`}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Carrousel d'onglets. Le HTML arrive déjà dans son état de départ : le
   * script ne fait que déplacer l'état, jamais l'établir.
   */
  const calme = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const onglets = Array.from(reel.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const vues = Array.from(reel.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (onglets.length < 2) return;

    const duree = Number(reel.dataset.interval) || 4200;
    let actif = Math.max(0, onglets.findIndex((o) => o.getAttribute('aria-selected') === 'true'));
    let minuteur: number | undefined;
    let rendu = false;
    let visible = true;
    let suspendu = false;

    function montrer(i: number, donnerLeFocus = false) {
      actif = (i + onglets.length) % onglets.length;
      onglets.forEach((o, n) => {
        const est = n === actif;
        o.setAttribute('aria-selected', est ? 'true' : 'false');
        o.tabIndex = est ? 0 : -1;
      });
      vues.forEach((v, n) => v.classList.toggle('is-on', n === actif));
      if (donnerLeFocus) onglets[actif].focus();
    }

    function arreter() {
      if (minuteur !== undefined) window.clearInterval(minuteur);
      minuteur = undefined;
    }

    function relancer() {
      arreter();
      if (rendu || calme.matches || !visible || suspendu) return;
      minuteur = window.setInterval(() => montrer(actif + 1), duree);
    }

    function rendreLaMain() {
      rendu = true;
      arreter();
    }

    onglets.forEach((o, i) => {
      o.addEventListener('click', () => {
        rendreLaMain();
        montrer(i);
      });
    });

    reel.addEventListener('keydown', (e) => {
      const k = e.key;
      const pas = k === 'ArrowRight' ? 1 : k === 'ArrowLeft' ? -1 : 0;
      if (pas === 0 && k !== 'Home' && k !== 'End') return;
      e.preventDefault();
      rendreLaMain();
      if (k === 'Home') montrer(0, true);
      else if (k === 'End') montrer(onglets.length - 1, true);
      else montrer(actif + pas, true);
    });

    // Survol et focus suspendent l'avance, sans l'annuler.
    reel.addEventListener('pointerenter', () => { suspendu = true; arreter(); });
    reel.addEventListener('pointerleave', () => { suspendu = false; relancer(); });
    reel.addEventListener('focusin', () => { suspendu = true; arreter(); });
    reel.addEventListener('focusout', () => { suspendu = false; relancer(); });

    // Hors écran, rien ne tourne : personne ne regarde.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entrees) => {
          visible = entrees[0].isIntersecting;
          relancer();
        },
        { threshold: 0.25 }
      ).observe(reel);
    }

    calme.addEventListener('change', relancer);
    relancer();
  });
</script>

<style>
  .head { max-width: 24ch; }

  .reel { margin-top: 2.5rem; }

  /* Les noms font office de navigation : tous lisibles, l'actif seul en plein
     contraste. Le balayage de la hiérarchie se voit donc sans cliquer. */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
  }
  .tab {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    font-size: clamp(1.125rem, 2.1vw, 1.4375rem);
    font-weight: 300;
    letter-spacing: -0.015em;
    color: var(--color-n-500);
    cursor: pointer;
    transition: color 180ms ease;
  }
  .tab:hover { color: var(--color-ink-2); }
  .tab[aria-selected="true"] { color: var(--color-ink); }
  .tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Le filet marque l'actif par la forme autant que par la couleur : le
     changement ne repose jamais sur la seule teinte. */
  .tab-rule {
    display: block;
    height: 2px;
    margin-top: 0.5rem;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tab[aria-selected="true"] .tab-rule { transform: scaleX(1); }

  /* Les vues se superposent dans une même cellule : la scène prend la hauteur
     de la plus longue, donc rien ne saute d'une vue à l'autre. */
  .stage {
    display: grid;
    margin-top: 2.25rem;
  }
  /* La sortante disparaît d'un coup, seule l'entrante est animée. Un fondu
     croisé ferait lire deux phrases superposées pendant 320 ms, ce qui est
     illisible sur du texte long : c'est acceptable sur une image, jamais sur
     une ligne qu'on est en train de lire. */
  .slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    /* La phrase à gauche, l'illustration à droite. La largeur de l'image est
       fixe : c'est elle qui fixe la hauteur de la scène, donc rien ne bouge
       d'une vue à l'autre quelle que soit la longueur de la phrase. */
    display: grid;
    grid-template-columns: 1fr 460px;
    gap: 3rem;
    align-items: center;
  }
  .slide.is-on {
    opacity: 1;
    visibility: visible;
  }

  .shot {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-line);
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .slide.is-on {
      animation: persona-entree 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }
  @keyframes persona-entree {
    from {
      opacity: 0;
      transform: translateY(0.375rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .line {
    margin: 0;
    max-width: 38rem;
    font-size: clamp(1.375rem, 2.7vw, 1.875rem);
    font-weight: 300;
    line-height: 1.42;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-rule,
    .tab {
      transition: none;
    }
  }

  /* Sous 900 px la phrase passe au-dessus de l'illustration, qui reprend toute
     la largeur de la colonne. */
  @media (max-width: 900px) {
    .slide {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      align-items: start;
    }
    .line { max-width: none; }
  }

  @media (max-width: 640px) {
    /* Les onglets passent sur deux ou trois lignes : sans interligne, le filet
       de l'actif vient toucher le nom de la ligne suivante. */
    .tabs { gap: 0.75rem 1.25rem; }
    .stage { margin-top: 1.75rem; }
  }
</style>
