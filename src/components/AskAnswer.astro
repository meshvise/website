---
/**
 * On tape une question, l'IA choisit ce qu'elle lit, elle répond. En boucle.
 *
 * Cinq actes. La question s'écrit et le bouton s'active ; une pulsation annonce
 * la lecture ; la grille de ce que le produit sait rendre se fait parcourir ;
 * les deux usages qui servent à CETTE question restent allumés et se
 * rassemblent au centre ; la réponse en sort, rédigée.
 *
 * Trois partis pris qui font la différence entre une démonstration et un décor.
 *
 * Chaque tour pose une AUTRE question, donc quatre chances qu'un visiteur
 * reconnaisse la sienne au lieu d'une seule.
 *
 * Chaque tour n'éclaire que les usages qui servent réellement à sa réponse, et
 * ce sont eux qui convergent : les micro-arrêts pour une fréquence d'arrêt,
 * l'énergie pour un talon nocturne, les révisions et les écritures pour un
 * seuil déplacé. La grille cesse d'être un ornement et montre que l'IA choisit
 * ce qu'elle lit.
 *
 * La réponse est rédigée comme une réponse d'assistant, en deux temps qui
 * arrivent l'un après l'autre, et elle cite ses sources. Ce n'est pas un effet
 * de style : le contrat des outils impose qu'une affirmation soit citée, et
 * montrer la citation vaut mieux que l'affirmer ailleurs.
 *
 * Tous les chiffres sont mesurés sur le parc de démonstration de Bellecombe.
 * La mention explicite a été retirée sur demande ; si un prospect demande d'où
 * viennent ces chiffres, la réponse est là. Le temps d'arrêt
 * cumulé, par exemple, n'existe pas sur trente jours (les accumulateurs ont été
 * posés le 9 septembre), donc aucune question ne porte dessus.
 *
 * État de repos, sans script ou sous `prefers-reduced-motion` : le premier tour
 * entier, question et réponse. Les quatre paires sont dans le document, donc
 * lisibles par un moteur d'indexation.
 */
import { type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const fr = {
  bouton: 'DEMANDER',
  pulsation: 'LECTURE DU PARC',
  usages: [
    'MACHINES', 'VALEURS COURANTES', 'HISTORIQUE', 'INDICATEURS',
    'ÉNERGIE', 'ALARMES', 'RÉVISIONS', 'COMMANDES',
  ],
  tours: [
    {
      q: "Quelle machine s'arrête le plus souvent ?",
      a1: "Le centre d'usinage CU3.",
      a2: 'Il enregistre 7,04 micro-arrêts par heure, contre moins de 0,5 sur les autres postes de l’atelier.',
      lus: [0, 3],
    },
    {
      q: 'Pourquoi le compresseur tourne-t-il la nuit ?',
      a1: "La centrale d'air comprimé ne s'arrête jamais vraiment.",
      a2: 'Elle consomme 22,7 kW de talon nocturne, atelier à l’arrêt.',
      lus: [0, 4],
    },
    {
      q: 'Qui a changé ce seuil, et quand ?',
      a1: 'Une révision du 25 août.',
      a2: "Elle a resserré le seuil d'huile de coupe de CU3, et une révision du 4 septembre l’a ramené en arrière.",
      lus: [5, 6, 7],
    },
    {
      q: "Combien d'alarmes personne n'a acquittées ?",
      a1: '151 alarmes sur 154.',
      a2: "Sur le centre d'usinage CU3, 3 seulement ont été acquittées en 30 jours.",
      lus: [5],
    },
  ],
  aria:
    "Une IA répond à quatre questions sur l'atelier. À chaque fois elle choisit " +
    'ce qu’elle lit du parc, puis répond en citant ses sources : la machine ' +
    'qui s’arrête le plus souvent, le talon nocturne du compresseur, la ' +
    'révision qui a déplacé un seuil, et les alarmes que personne n’a acquittées.',
};

const en = {
  bouton: 'ASK',
  pulsation: 'READING THE SITE',
  usages: [
    'MACHINES', 'LIVE VALUES', 'HISTORY', 'INDICATORS',
    'ENERGY', 'ALARMS', 'REVISIONS', 'COMMANDS',
  ],
  tours: [
    {
      q: 'Which machine stops most often?',
      a1: 'Machining centre CU3.',
      a2: 'It records 7.04 micro-stoppages per hour, against under 0.5 on every other workstation.',
      lus: [0, 3],
    },
    {
      q: 'Why is the compressor running at night?',
      a1: 'The compressed air plant never really stops.',
      a2: 'It draws 22.7 kW of night-time baseload with the shop floor at a standstill.',
      lus: [0, 4],
    },
    {
      q: 'Who changed this threshold, and when?',
      a1: 'A revision dated 25 August.',
      a2: 'It tightened the cutting oil threshold on CU3, and a revision of 4 September rolled it back.',
      lus: [5, 6, 7],
    },
    {
      q: 'How many alarms did nobody acknowledge?',
      a1: '151 alarms out of 154.',
      a2: 'On machining centre CU3, only 3 were acknowledged in 30 days.',
      lus: [5],
    },
  ],
  aria:
    'An AI answers four questions about the shop floor. Each time it chooses ' +
    'what to read from the site, then answers citing its sources: the machine ' +
    'that stops most often, the compressor night-time baseload, the revision ' +
    'that moved a threshold, and the alarms nobody acknowledged.',
};

const d = lang === 'fr' ? fr : en;

// Huit lectures reellement distinctes, une par famille du contrat des outils :
// le parc, les valeurs courantes, l'historique, les indicateurs derives,
// l'energie, les alarmes, les revisions de configuration, les commandes.
// La version precedente en alignait douze dont cinq disaient la meme chose :
// arrets, micro-arrets, disponibilite, utilisation et fiabilite sortent tous
// du meme drapeau de marche et du meme outil.
const L = 160;
const H = 44;
const EX = 20;
const EY = 16;
const COLS = 4;
const Y0 = 4;
const VB_W = COLS * L + (COLS - 1) * EX;
const VB_H = Y0 + 2 * H + EY;

/**
 * Les places de convergence, centrees dans la vue quel que soit leur nombre.
 * Une question peut n'en consulter qu'une, ou trois : la rangee se recentre.
 */
const SLOT_Y = Y0 + (VB_H - Y0 - H) / 2;
const placeX = (rang: number, total: number) =>
  (VB_W - (total * L + (total - 1) * EX)) / 2 + rang * (L + EX);

const premier = d.tours[0].lus;
const cases = d.usages.map((nom, i) => {
  const x = (i % COLS) * (L + EX);
  const y = Y0 + Math.floor(i / COLS) * (H + EY);
  const rang = premier.indexOf(i);
  return {
    nom,
    i,
    x,
    y,
    retenue: rang >= 0,
    dx: rang >= 0 ? placeX(rang, premier.length) - x : 0,
    dy: rang >= 0 ? SLOT_Y - y : 0,
  };
});

/**
 * Durée d'un tour, en millisecondes.
 *
 * La séquence occupe les sept premières secondes, donc le reste est le temps
 * de lecture de la réponse : sept secondes pour deux phrases et leur ligne de
 * sources, ce qui laisse le temps de lire sans relire.
 */
const TOUR = 14000;
---

<figure
  class="mvf fig"
  role="img"
  aria-label={d.aria}
  data-ask
  data-tour={TOUR}
  data-tours={d.tours.length}
  data-l={L}
  data-ex={EX}
  data-w={VB_W}
  data-slot-y={SLOT_Y}
>
  <div class="bar">
    <span class="field">
      {d.tours.map((t, i) => (
        <span
          class:list={['typed', i === 0 && 'on']}
          data-q={i}
          style={`--pas: ${t.q.length}`}
        >{t.q}</span>
      ))}
    </span>
    <span class="btn">{d.bouton}</span>
  </div>

  <div class="stage">
    <div class="pulse" aria-hidden="true">
      <span class="ring ring1"></span>
      <span class="ring ring2"></span>
      <span class="ring ring3"></span>
      <span class="pulse-t">{d.pulsation}</span>
    </div>

    <svg class="grid" viewBox={`0 0 ${VB_W} ${VB_H}`} preserveAspectRatio="xMidYMid meet">
      {cases.map((c) => (
        <g
          class:list={['cell', c.retenue && 'use']}
          data-cell={c.i}
          data-x={c.x}
          data-y={c.y}
          style={`--i:${c.i}; --dx:${c.dx}px; --dy:${c.dy}px`}
        >
          <rect x={c.x} y={c.y} width={L} height={H} rx="9" />
          <text x={c.x + L / 2} y={c.y + H / 2 + 5} text-anchor="middle">{c.nom}</text>
        </g>
      ))}
    </svg>

    {d.tours.map((t, i) => (
      <div class:list={['ans', i === 0 && 'on']} data-a={i} data-lus={t.lus.join(',')}>
        <span class="ans-1">{t.a1}</span>
        <span class="ans-2">{t.a2}</span>
        <span class="ans-src">{t.lus.map((n) => d.usages[n]).join(' · ')}</span>
      </div>
    ))}
  </div>

</figure>

<script>
  /**
   * La boucle. Le premier tour est déjà posé dans le HTML, donc sans script la
   * figure reste une question et sa réponse ; le script ne fait que déplacer
   * l'état d'un tour au suivant.
   *
   * Le redémarrage des animations passe par une classe sur la figure, retirée
   * puis remise après une lecture forcée de la mise en page : c'est la seule
   * façon de rejouer des animations CSS déclaratives sans les redéclarer.
   */
  const calme = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-ask]').forEach((fig) => {
    const nb = Number(fig.dataset.tours) || 1;
    const duree = Number(fig.dataset.tour) || 14000;
    if (nb < 2) return;

    // Les constantes de la vue, lues sur la figure : le script ne redeclare pas
    // la geometrie que le rendu connait deja.
    const L = Number(fig.dataset.l);
    const EX = Number(fig.dataset.ex);
    const VB_W = Number(fig.dataset.w);
    const SLOT_Y = Number(fig.dataset.slotY);
    const placeX = (rang: number, total: number) =>
      (VB_W - (total * L + (total - 1) * EX)) / 2 + rang * (L + EX);

    const cellules = Array.from(fig.querySelectorAll<SVGGElement>('[data-cell]'));
    const questions = Array.from(fig.querySelectorAll<HTMLElement>('[data-q]'));
    const reponses = Array.from(fig.querySelectorAll<HTMLElement>('[data-a]'));

    // Chaque réponse porte la liste des usages qui ont servi à la produire :
    // le script ne redéclare pas ce que le rendu sait déjà.
    const lus = reponses.map((r) => {
      const brut = r.dataset.lus || '';
      return brut ? brut.split(',').map(Number) : [];
    });

    let i = 0;
    let horloge: number | undefined;
    let visible = true;

    function poser(n: number) {
      questions.forEach((e) => e.classList.toggle('on', Number(e.dataset.q) === n));
      reponses.forEach((e) => e.classList.toggle('on', Number(e.dataset.a) === n));
      const utilises = lus[n] || [];
      cellules.forEach((c) => {
        const k = Number(c.dataset.cell);
        const rang = utilises.indexOf(k);
        c.classList.toggle('use', rang >= 0);
        if (rang >= 0) {
          const x = Number(c.dataset.x);
          const y = Number(c.dataset.y);
          c.style.setProperty('--dx', `${placeX(rang, utilises.length) - x}px`);
          c.style.setProperty('--dy', `${SLOT_Y - y}px`);
        }
      });
      // Relance : retirer, forcer le calcul, remettre.
      fig.classList.remove('run');
      void fig.offsetWidth;
      fig.classList.add('run');
    }

    function arreter() {
      if (horloge !== undefined) window.clearInterval(horloge);
      horloge = undefined;
    }
    function demarrer() {
      arreter();
      if (calme.matches || !visible) return;
      horloge = window.setInterval(() => {
        i = (i + 1) % nb;
        poser(i);
      }, duree);
    }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entrees) => {
          visible = entrees[0].isIntersecting;
          // Une histoire prise en cours de route n'en est pas une.
          if (visible) {
            i = 0;
            poser(0);
          }
          demarrer();
        },
        { threshold: 0.3 },
      ).observe(fig);
    }

    calme.addEventListener('change', demarrer);
    fig.classList.add('run');
    demarrer();
  });
</script>

<style>
  .fig {
    margin: 2.5rem auto 0;
    padding: 0;
    max-width: 40rem;
    display: grid;
    justify-items: center;
    /* La figure a l'air d'une barre de recherche et d'un bouton, mais elle n'en
       est pas une. Le curseur de texte sur le champ et la selection sur les
       libelles suffisent a promettre une interaction qui n'existe pas. */
    cursor: default;
    user-select: none;
  }

  /* Acte 1 : la barre. */
  .bar {
    display: flex;
    align-items: stretch;
    width: 100%;
    border: 1px solid var(--color-accent-border);
    border-radius: 10px;
    background: var(--color-surface);
    overflow: hidden;
  }
  .field {
    flex: 1;
    min-width: 0;
    display: grid;
    align-items: center;
    padding: 0.75rem 1rem;
    font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
    color: var(--color-ink);
    text-align: left;
  }
  /* Les quatre questions occupent la même cellule : la barre ne change pas de
     hauteur d'un tour à l'autre, et les trois inactives restent dans le
     document pour les moteurs. */
  .typed {
    grid-area: 1 / 1;
    overflow: hidden;
    white-space: nowrap;
    visibility: hidden;
  }
  .typed.on { visibility: visible; }
  .btn {
    flex: none;
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    background: var(--color-accent);
    color: #fff;
  }

  /* Les actes suivants occupent la même cellule : rien ne se déplace quand
     l'un cède la place au suivant. */
  .stage {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 16rem;
    margin-top: 1.25rem;
  }
  .stage > * { grid-area: 1 / 1; }

  .pulse {
    display: grid;
    place-items: center;
    width: 100%;
    opacity: 0;
    pointer-events: none;
  }
  .pulse > * { grid-area: 1 / 1; }
  .ring {
    display: block;
    width: 7rem;
    height: 7rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 50%;
  }
  .pulse-t {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-accent-strong);
    white-space: nowrap;
  }

  .grid {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0;
  }
  /* Sans filet, un aplat à #f0f3f7 sur un fond de page à #f8f7fb est
     invisible : les cases doivent se voir pour que le passage se voie. */
  .cell rect {
    fill: var(--color-n-100);
    stroke: var(--color-line);
    stroke-width: 1;
  }
  .cell text {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    fill: var(--color-n-500);
  }
  .cell.use rect { fill: var(--color-accent); stroke: var(--color-accent); }
  .cell.use text { fill: #fff; }

  /* Acte 5 : la réponse, écrite comme une réponse d'assistant. */
  .ans {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    max-width: 34rem;
    padding-left: 1.125rem;
    border-left: 2px solid var(--color-accent);
    text-align: left;
    visibility: hidden;
  }
  .ans.on { visibility: visible; }
  .ans-1 {
    font-size: clamp(1.125rem, 2.2vw, 1.4375rem);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .ans-2 {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  /* Les sources : le contrat des outils impose qu'une affirmation soit citée,
     la figure le montre au lieu de le promettre ailleurs. */
  .ans-src {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  /* Le mouvement ne s'applique qu'au tour en cours, et seulement quand la
     figure porte `run` : c'est ce qui permet de le rejouer à chaque tour. */
  @media (prefers-reduced-motion: no-preference) {
    .run .typed.on {
      max-width: 100%;
      animation: aa-type 1.6s steps(var(--pas)) both;
    }

    /* L'appui : le bouton s'enfonce et se fonce a l'instant ou la question
       part. C'est le seul geste de la sequence qui vient d'un humain. */
    .run .btn { animation: aa-press 280ms cubic-bezier(0.22, 1, 0.36, 1) 1.65s both; }

    .run .pulse { animation: aa-fade 1.4s ease-out 1.9s both; }
    .run .ring1 { animation: aa-ring 1.4s ease-out 1.9s both; }
    .run .ring2 { animation: aa-ring 1.4s ease-out 2.1s both; }
    .run .ring3 { animation: aa-ring 1.4s ease-out 2.3s both; }

    .run .grid { animation: aa-grid 3.6s linear 3.3s both; }

    /* Deux animations par case : l'entrée échelonnée du balayage, puis la
       sortie ou la convergence. La seconde gagne sur les propriétés
       partagées, ce qui est exactement l'ordre voulu. */
    .run .cell {
      animation:
        aa-in 700ms cubic-bezier(0.22, 1, 0.36, 1) calc(3.5s + var(--i, 0) * 0.09s) both,
        aa-out 500ms ease 5.2s both;
    }
    .run .cell rect {
      animation: aa-flash 700ms cubic-bezier(0.22, 1, 0.36, 1)
        calc(3.5s + var(--i, 0) * 0.09s) both;
    }
    .run .cell.use rect { animation-name: aa-lock; }
    .run .cell.use text {
      animation: aa-white 700ms cubic-bezier(0.22, 1, 0.36, 1)
        calc(3.5s + var(--i, 0) * 0.09s) both;
    }
    /* Les retenues ne sortent pas : elles se rassemblent au centre, a la place
       que leur rang leur donne dans une rangee recentree. */
    .run .cell.use {
      animation:
        aa-in 700ms cubic-bezier(0.22, 1, 0.36, 1) calc(3.5s + var(--i, 0) * 0.09s) both,
        aa-join 700ms cubic-bezier(0.22, 1, 0.36, 1) 5.2s both;
    }

    /* La réponse sort des deux cases rassemblées, en deux temps. */
    /* Le filet entre avec la reponse : sinon il flotte seul a gauche
       pendant toute la lecture du parc. */
    .run .ans.on { animation: aa-bar 300ms linear 6.9s both; }
    .run .ans.on .ans-1 { animation: aa-up 420ms cubic-bezier(0.22, 1, 0.36, 1) 6.9s both; }
    .run .ans.on .ans-2 { animation: aa-up 420ms cubic-bezier(0.22, 1, 0.36, 1) 7.3s both; }
    .run .ans.on .ans-src { animation: aa-in 300ms linear 7.8s both; }
  }

  @keyframes aa-type { from { max-width: 0; } to { max-width: 100%; } }
  @keyframes aa-press {
    0% { transform: none; background: var(--color-accent); }
    40% { transform: scale(0.95); background: var(--color-accent-strong); }
    100% { transform: none; background: var(--color-accent); }
  }
  @keyframes aa-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes aa-out { to { opacity: 0; } }
  @keyframes aa-fade { 0% { opacity: 0; } 20%, 70% { opacity: 1; } 100% { opacity: 0; } }
  /* La grille tient jusqu'a la convergence, puis s'efface pour la reponse. */
  @keyframes aa-grid { 0% { opacity: 0; } 6%, 78% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes aa-ring {
    from { transform: scale(0.55); opacity: 0.9; }
    to { transform: scale(2.4); opacity: 0; }
  }
  @keyframes aa-flash {
    0% { fill: var(--color-n-100); }
    35% { fill: var(--color-accent-bg); }
    100% { fill: var(--color-n-100); }
  }
  @keyframes aa-lock {
    0% { fill: var(--color-n-100); }
    45%, 100% { fill: var(--color-accent); }
  }
  @keyframes aa-white {
    0% { fill: var(--color-n-500); }
    45%, 100% { fill: #fff; }
  }
  @keyframes aa-join {
    from { transform: translate(0, 0); }
    to { transform: translate(var(--dx), var(--dy)); }
  }
  @keyframes aa-bar {
    from { border-left-color: transparent; }
    to { border-left-color: var(--color-accent); }
  }
  @keyframes aa-up {
    from { opacity: 0; transform: translateY(0.4rem); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 700px) {
    .field { font-size: 0.875rem; }
    .btn { padding: 0 0.875rem; }
    .stage { min-height: 15rem; }
    .ans { padding-left: 0.875rem; }
  }
</style>
