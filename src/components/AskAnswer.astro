---
/**
 * On tape la question, l'IA va chercher, elle répond.
 *
 * Quatre actes, repris de la séquence d'Ethon dont Bruno a fourni les images :
 * une barre de recherche où la question s'écrit et dont le bouton s'active,
 * une pulsation qui annonce la lecture, le parc que l'on parcourt, la réponse.
 *
 * Ce qui change par rapport à Ethon, et ce n'est pas un détail de style. Leur
 * troisième acte est un graphe de paramètres reliés, où un chemin causal
 * s'allume jusqu'au rendement. Meshvise ne fait pas ça : l'IA ne remonte
 * aucune cause, elle interroge le parc et rapporte ce qu'elle trouve. La
 * grille est donc une grille, sans liens entre machines, et le balayage dit la
 * lecture de vingt-trois machines, rien de plus. Un graphe causal serait plus
 * spectaculaire et mentirait sur ce que fait le produit.
 *
 * Deux règles tenues, héritées des figures animées du site :
 *
 * - L'état de repos EST l'état final : barre remplie, grille avec CU3 retenu,
 *   réponse visible. L'animation ne fait que retarder et éclairer. Sans
 *   script, sous `prefers-reduced-motion` ou pour un robot d'indexation, la
 *   figure se lit entière. La pulsation est le seul élément transitoire, et
 *   son absence au repos ne retire rien.
 * - La séquence joue une fois et tient sa dernière image. `observe.ts` la
 *   rejoue quand la figure revient à l'écran.
 */
import { type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const fr = {
  question: 'Quelle machine nous a le plus arrêtés le mois dernier ?',
  bouton: 'DEMANDER',
  pulsation: 'LECTURE DU PARC',
  entete: 'ALARMES · 30 JOURS · 23 MACHINES',
  reponse: '154 ALARMES · 3 ACQUITTÉES',
  pied: 'Parc de démonstration',
  aria:
    'On demande quelle machine a le plus arrêté la production le mois dernier. ' +
    "L'IA lit les vingt-trois machines du parc et retient le centre d'usinage " +
    'CU3 : cent cinquante-quatre alarmes en trente jours, dont trois acquittées.',
};
const en = {
  question: 'Which machine stopped us the most last month?',
  bouton: 'ASK',
  pulsation: 'READING THE SITE',
  entete: 'ALARMS · 30 DAYS · 23 MACHINES',
  reponse: '154 ALARMS · 3 ACKNOWLEDGED',
  pied: 'Demonstration site',
  aria:
    'Someone asks which machine stopped production the most last month. AI ' +
    'reads the twenty-three machines on site and singles out machining centre ' +
    'CU3: one hundred and fifty-four alarms over thirty days, three acknowledged.',
};
const d = lang === 'fr' ? fr : en;

/** Le parc, vingt-trois machines. CU3 est la retenue. */
const MACHINES = [
  'CU1', 'CU2', 'CU4', 'CU5',
  'TCN1', 'TCN2', 'TCN3', 'RECT1',
  'RECT2', 'PERC1', 'PERC2', 'SCIE1',
  'PRESSE1', 'EBAV1', 'LAV1', 'MET1',
  'COMP1', 'SECH1', 'TGBT1', 'CTA1',
  'GF1', 'CU3', 'ONDU1',
];
const RETENUE = MACHINES.indexOf('CU3');

const L = 156;
const H = 46;
const EX = 20;
const EY = 16;
const X0 = 2;
const Y0 = 26;

const pastilles = MACHINES.map((nom, i) => ({
  nom,
  i,
  x: X0 + (i % 4) * (L + EX),
  y: Y0 + Math.floor(i / 4) * (H + EY),
  retenue: i === RETENUE,
}));

const cible = pastilles[RETENUE];
const cx = cible.x + L / 2;

/** Un pas de frappe par caractère. */
const PAS = d.question.length;
---

<figure class="mvf fig" role="img" aria-label={d.aria}>
  <div class="bar">
    <span class="field">
      <span class="typed">{d.question}</span><span class="caret" aria-hidden="true"></span>
    </span>
    <span class="btn">{d.bouton}</span>
  </div>

  <div class="stage">
    <div class="pulse" aria-hidden="true">
      <span class="ring ring1"></span>
      <span class="ring ring2"></span>
      <span class="ring ring3"></span>
      <span class="pulse-t">{d.pulsation}</span>
    </div>

    <svg class="grid" viewBox="0 0 700 396" preserveAspectRatio="xMidYMid meet">
      <text class="entete" x={X0} y="10">{d.entete}</text>
      {pastilles.map((p) => (
        <g class:list={['chip', p.retenue && 'chip-on']} style={`--i: ${p.i}`}>
          <rect x={p.x} y={p.y} width={L} height={H} rx="9" />
          <text x={p.x + L / 2} y={p.y + H / 2 + 5} text-anchor="middle">{p.nom}</text>
        </g>
      ))}
      <line class="fil" x1={cx} y1={cible.y + H} x2={cx} y2={cible.y + H + 30} />
    </svg>
  </div>

  <p class="ans">{d.reponse}</p>
  <figcaption class="pied">{d.pied}</figcaption>
</figure>

<script>
  import { observerLesFigures } from './motion/observe';

  observerLesFigures();
</script>

<style define:vars={{ pas: PAS }}>
  .fig {
    margin: 2.5rem 0 0;
    padding: 0;
    max-width: 40rem;
    display: grid;
    justify-items: start;
  }

  /* Acte 1 : la barre. */
  .bar {
    display: flex;
    align-items: stretch;
    width: 100%;
    border: 1px solid var(--color-accent-border);
    border-radius: 10px;
    background: var(--color-surface);
    overflow: hidden;
  }
  .field {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0.75rem 1rem;
    font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
    color: var(--color-ink);
  }
  /* La frappe : le texte est entier dans le document, seule sa largeur visible
     avance. Un robot d'indexation lit donc la question complète. */
  .typed {
    overflow: hidden;
    white-space: nowrap;
  }
  .caret {
    flex: none;
    width: 2px;
    align-self: stretch;
    background: var(--color-accent);
    opacity: 0;
  }
  .btn {
    flex: none;
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    background: var(--color-accent);
    color: #fff;
  }

  /* Actes 2 et 3 dans la même cellule : la pulsation cède la place à la
     grille sans que rien ne se déplace. */
  .stage {
    display: grid;
    width: 100%;
    margin-top: 1.25rem;
  }
  .stage > * {
    grid-area: 1 / 1;
  }

  .pulse {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }
  .pulse > * {
    grid-area: 1 / 1;
  }
  .ring {
    display: block;
    width: 7rem;
    height: 7rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 50%;
  }
  .pulse-t {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-accent-strong);
    white-space: nowrap;
  }

  .grid {
    display: block;
    width: 100%;
    height: auto;
  }
  .entete {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    fill: var(--color-muted);
  }
  /* Sans filet, un aplat à #f0f3f7 sur un fond de page à #f8f7fb est
     invisible : les cases éteintes doivent se voir pour que la retenue se
     détache de quelque chose. */
  .chip rect {
    fill: var(--color-n-100);
    stroke: var(--color-line);
    stroke-width: 1;
  }
  .chip text {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    fill: var(--color-n-500);
  }
  .chip-on rect { fill: var(--color-accent); }
  .chip-on text { fill: #fff; }
  .fil { stroke: var(--color-accent); stroke-width: 2; }

  /* Acte 4 : la réponse. */
  /* Toute la largeur, et le texte centre : le filet qui descend de la machine
     retenue tombe alors DANS la reponse au lieu d'en frôler le coin. */
  .ans {
    width: 100%;
    text-align: center;
    margin: 0.5rem 0 0;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 10px;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    color: var(--color-accent-strong);
  }
  .pied {
    margin-top: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .typed {
      max-width: 100%;
      animation: aa-type 1.7s steps(var(--pas)) both;
    }
    .caret {
      animation:
        aa-caret 0.7s steps(1) 0s 3,
        aa-caret-out 1ms linear 2.1s both;
    }
    .btn {
      animation: aa-btn 1ms linear 1.75s both;
    }

    .pulse { animation: aa-pulse 1.5s ease-out 2s both; }
    .ring1 { animation: aa-ring 1.5s ease-out 2s both; }
    .ring2 { animation: aa-ring 1.5s ease-out 2.2s both; }
    .ring3 { animation: aa-ring 1.5s ease-out 2.4s both; }

    .grid { animation: aa-in 400ms ease-out 3.5s both; }
    .chip,
    .chip rect,
    .chip text {
      animation-duration: 800ms;
      animation-delay: calc(3.7s + var(--i, 0) * 0.06s);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      /* `both` n'est pas cosmétique : sans lui le verrou de la retenue ne tient
         pas sa dernière image, et une animation terminée sort de
         `getAnimations()`, ce qui la rend invisible à toute vérification. */
      animation-fill-mode: both;
    }
    .chip { animation-name: aa-in; }
    .chip rect { animation-name: aa-flash; }
    .chip-on rect { animation-name: aa-lock; }
    .chip-on text { animation-name: aa-white; }

    .fil { animation: aa-link 300ms ease-out 5.5s both; }
    .ans { animation: aa-up 420ms cubic-bezier(0.22, 1, 0.36, 1) 5.7s both; }
    .pied { animation: aa-in 300ms linear 6s both; }
  }

  @keyframes aa-type { from { max-width: 0; } to { max-width: 100%; } }
  @keyframes aa-caret { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes aa-caret-out { to { opacity: 0; } }
  @keyframes aa-btn {
    from { background: var(--color-accent-bg); color: var(--color-accent-border); }
    to { background: var(--color-accent); color: #fff; }
  }
  @keyframes aa-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes aa-up {
    from { opacity: 0; transform: translateY(0.4rem); }
    to { opacity: 1; transform: none; }
  }
  @keyframes aa-link {
    from { opacity: 0; transform: scaleY(0); transform-origin: top; }
    to { opacity: 1; transform: none; }
  }
  /* La pulsation est le seul élément qui s'efface : elle annonce, puis cède la
     place à ce qu'elle annonçait. */
  @keyframes aa-pulse { 0% { opacity: 0; } 20%, 70% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes aa-ring {
    from { transform: scale(0.55); opacity: 0.9; }
    to { transform: scale(2.4); opacity: 0; }
  }
  @keyframes aa-flash {
    0% { fill: var(--color-n-100); }
    35% { fill: var(--color-accent-bg); }
    100% { fill: var(--color-n-100); }
  }
  @keyframes aa-lock {
    0% { fill: var(--color-n-100); }
    45%, 100% { fill: var(--color-accent); }
  }
  @keyframes aa-white {
    0% { fill: var(--color-n-500); }
    45%, 100% { fill: #fff; }
  }

  @media (max-width: 700px) {
    .field { font-size: 0.875rem; }
    .btn { padding: 0 0.875rem; }
    .stage { overflow-x: auto; overscroll-behavior-x: contain; }
    .grid { min-width: 520px; }
  }
</style>
