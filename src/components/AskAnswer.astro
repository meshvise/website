---
/**
 * Le parc entier lu, une machine retenue.
 *
 * La question de la section demande « quelle machine nous a le plus arrêtés ».
 * La figure montre ce que ça veut dire : les vingt-trois machines du parc
 * s'allument une à une pendant que l'IA les lit, puis tout s'éteint sauf une,
 * et la réponse tombe sous elle.
 *
 * Le registre est celui des figures animées du site, lui-même proche de ce que
 * fait Ethon : une grille d'aplats arrondis, des libellés en chasse fixe, une
 * seule couleur d'accent contre des gris très pâles, et beaucoup de vide. Ce
 * qui n'est pas l'argument est retiré : pas de cadre, pas de fond, pas d'axe.
 *
 * Une différence avec Ethon qui n'est pas un détail. Chez eux, le chemin qui
 * s'allume est une chaîne causale entre paramètres. Ici il n'y en a pas : l'IA
 * ne remonte aucune cause, elle interroge le parc et rapporte ce qu'elle
 * trouve. Le balayage dit donc exactement ce qui se passe, la lecture de
 * vingt-trois machines, et rien de plus. Une chaîne causale serait plus jolie
 * et fausse.
 *
 * L'état de repos EST l'état final : grille pâle, CU3 en accent, réponse
 * visible. L'animation n'ajoute que le balayage et les entrées, donc sans
 * script, sous `prefers-reduced-motion` ou pour un robot, la figure se lit
 * entière. `observe.ts` la rejoue quand elle revient à l'écran.
 */
import { type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const fr = {
  entete: 'ALARMES · 30 JOURS · 23 MACHINES',
  reponse: '154 ALARMES · 3 ACQUITTÉES',
  pied: 'Parc de démonstration',
  aria:
    "L'IA lit les vingt-trois machines du parc, puis retient le centre " +
    "d'usinage CU3 : cent cinquante-quatre alarmes en trente jours, dont " +
    'trois acquittées.',
};
const en = {
  entete: 'ALARMS · 30 DAYS · 23 MACHINES',
  reponse: '154 ALARMS · 3 ACKNOWLEDGED',
  pied: 'Demonstration site',
  aria:
    'AI reads the twenty-three machines on site, then singles out machining ' +
    'centre CU3: one hundred and fifty-four alarms over thirty days, three ' +
    'of them acknowledged.',
};
const d = lang === 'fr' ? fr : en;

/** Le parc, vingt-trois machines. La retenue est la vingt-deuxième. */
const MACHINES = [
  'CU1', 'CU2', 'CU4', 'CU5',
  'TCN1', 'TCN2', 'TCN3', 'RECT1',
  'RECT2', 'PERC1', 'PERC2', 'SCIE1',
  'PRESSE1', 'EBAV1', 'LAV1', 'MET1',
  'COMP1', 'SECH1', 'TGBT1', 'CTA1',
  'GF1', 'CU3', 'ONDU1',
];
const RETENUE = MACHINES.indexOf('CU3');

// Grille de quatre colonnes. Les pastilles ne portent pas de chiffre :
// la valeur n'apparait qu'une fois, sur la reponse.
const L = 156;
const H = 52;
const EX = 20;
const EY = 20;
const X0 = 16;
const Y0 = 76;

const pastilles = MACHINES.map((nom, i) => {
  const col = i % 4;
  const rang = Math.floor(i / 4);
  return {
    nom,
    i,
    x: X0 + col * (L + EX),
    y: Y0 + rang * (H + EY),
    retenue: i === RETENUE,
  };
});

const cible = pastilles[RETENUE];
const cx = cible.x + L / 2;
const yFil = cible.y + H;
const yRep = yFil + 46;
const LR = 340;
---

<figure class="mvf fig" role="img" aria-label={d.aria}>
  <svg class="svg" viewBox="0 0 720 636" preserveAspectRatio="xMidYMid meet">
    <text class="entete an" style="animation-name: pk-in" x={X0} y="34">{d.entete}</text>

    {pastilles.map((p) => (
      <g
        class:list={['chip', p.retenue && 'chip-on', 'an']}
        style={`--i: ${p.i}`}
      >
        <rect x={p.x} y={p.y} width={L} height={H} rx="10" />
        <text x={p.x + L / 2} y={p.y + H / 2 + 5} text-anchor="middle">{p.nom}</text>
      </g>
    ))}

    <line
      class="fil an"
      style="animation-name: pk-link"
      x1={cx}
      y1={yFil}
      x2={cx}
      y2={yRep}
    />

    <g class="rep an" style="animation-name: pk-answer">
      <rect x={cx - LR / 2} y={yRep} width={LR} height="60" rx="12" />
      <text x={cx} y={yRep + 37} text-anchor="middle">{d.reponse}</text>
    </g>
  </svg>

  <figcaption class="pied">{d.pied}</figcaption>
</figure>

<script>
  import { observerLesFigures } from './motion/observe';

  observerLesFigures();
</script>

<style>
  .fig {
    margin: 2.5rem 0 0;
    padding: 0;
    max-width: 40rem;
  }
  .svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .pied {
    margin-top: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .entete {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.08em;
    fill: var(--color-muted);
  }

  /* Une pastille au repos : un aplat très pâle, un nom lisible sans appuyer.
     C'est le fond de grille sur lequel la retenue se détache. */
  .chip rect {
    fill: var(--color-n-100);
    /* Le filet n'est pas un ornement : sans lui, un aplat a #f0f3f7 sur un
       fond de page a #f8f7fb est litteralement invisible. Les cases eteintes
       doivent se voir pour que la retenue se detache de quelque chose. */
    stroke: var(--color-line);
    stroke-width: 1;
  }
  .chip text {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.04em;
    fill: var(--color-n-500);
  }
  .chip-on rect {
    fill: var(--color-accent);
  }
  .chip-on text {
    fill: #fff;
  }

  .fil {
    stroke: var(--color-accent);
    stroke-width: 2;
  }
  .rep rect {
    fill: var(--color-surface);
    stroke: var(--color-accent-border);
    stroke-width: 1;
  }
  .rep text {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.05em;
    fill: var(--color-accent-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .an {
      animation-duration: 460ms;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      animation-iteration-count: 1;
      animation-fill-mode: both;
    }

    /* Le balayage : chaque machine s'éclaire au passage de la lecture, puis
       revient à son gris. Soixante-dix millisecondes d'écart, soit un peu
       moins de deux secondes pour les vingt-trois. Le tour de la pastille et
       son fond sont animés séparément : l'un porte l'apparition, l'autre le
       passage de la lecture. */
    .chip,
    .chip rect,
    .chip text {
      animation-duration: 900ms;
      animation-delay: calc(0.45s + var(--i, 0) * 0.07s);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      /* `both` n'est pas cosmetique ici : sans lui, le verrou de la retenue ne
         tient pas sa derniere image, et une animation terminee sort de
         `getAnimations()`, ce qui la rend invisible a toute verification. */
      animation-fill-mode: both;
    }
    .chip { animation-name: pk-in; }
    .chip rect { animation-name: pk-flash; }
    /* La retenue ne redescend pas : elle s'allume au passage comme les autres,
       et reste allumée. */
    .chip-on rect { animation-name: pk-lock; }
    .chip-on text { animation-name: pk-white; }

    .fil { animation-delay: 2.5s; }
    .rep { animation-delay: 2.8s; }
  }

  @keyframes pk-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  /* Le passage de la lecture : le gris s'échauffe, puis retombe. */
  @keyframes pk-flash {
    0% { fill: var(--color-n-100); }
    35% { fill: var(--color-accent-bg); }
    100% { fill: var(--color-n-100); }
  }
  /* La retenue suit le même échauffement mais ne retombe pas. */
  @keyframes pk-lock {
    0% { fill: var(--color-n-100); }
    45%, 100% { fill: var(--color-accent); }
  }
  @keyframes pk-white {
    0% { fill: var(--color-n-500); }
    45%, 100% { fill: #fff; }
  }
  @keyframes pk-link {
    from { opacity: 0; transform: scaleY(0); transform-origin: top; }
    to { opacity: 1; transform: none; }
  }
  @keyframes pk-answer {
    from { opacity: 0; transform: translateY(0.5rem); }
    to { opacity: 1; transform: none; }
  }

  /* Sous cette largeur, une grille de sept cent vingt unités rend sa mono de
     quinze pixels à moins de neuf : elle se parcourt latéralement plutôt que
     de devenir illisible. */
  @media (max-width: 700px) {
    .fig {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
    }
    .svg {
      min-width: 520px;
    }
  }
</style>
