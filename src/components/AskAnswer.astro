---
/**
 * On tape la question, l'IA parcourt ce qu'elle sait lire, elle répond.
 *
 * Quatre actes, sur le modèle de la séquence d'Ethon : une barre de recherche
 * où la question s'écrit et dont le bouton s'active, une pulsation qui annonce
 * la lecture, ce que l'IA consulte, la réponse.
 *
 * Le troisième acte porte des USAGES et non des noms de machines. C'est plus
 * juste et plus vendeur : « arrêts », « disponibilité », « révisions » disent à
 * un visiteur ce que le produit sait rendre, là où vingt-trois codes machine ne
 * disaient rien à personne hors de Bellecombe. Chaque case correspond à une
 * lecture réellement servie par le catalogue d'outils.
 *
 * Ce qui reste différent d'Ethon, et c'est délibéré : leur troisième acte est
 * un graphe de paramètres reliés où un chemin causal s'allume jusqu'au
 * rendement. Meshvise ne fait pas ça. L'IA ne remonte aucune cause, elle lit et
 * rapporte. La grille n'a donc aucun lien entre ses cases : elle dit ce qui est
 * consulté, pas une chaîne d'explication. Un graphe causal serait plus
 * spectaculaire et mentirait sur ce que fait le produit.
 *
 * La réponse prend la place de la grille plutôt que de s'ajouter dessous : la
 * séquence se termine sur elle seule, ce qui est la seule chose qu'un visiteur
 * doit retenir.
 *
 * État de repos : la barre remplie et la réponse. La grille et la pulsation
 * sont transitoires et finissent à zéro, donc sans script, sous
 * `prefers-reduced-motion` ou pour un robot d'indexation, la figure se lit
 * comme une question et sa réponse. `observe.ts` la rejoue quand elle revient à
 * l'écran.
 */
import { type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const fr = {
  question: "Quelle machine s'arrête le plus souvent ?",
  bouton: 'DEMANDER',
  pulsation: 'LECTURE DU PARC',
  entete: '23 MACHINES · 30 JOURS',
  usages: [
    'UTILISATION', 'ARRÊTS', 'MICRO-ARRÊTS',
    'DISPONIBILITÉ', 'ALARMES', 'ACQUITTEMENTS',
    'FIABILITÉ', 'COMPTEURS', 'ÉNERGIE',
    'HISTORIQUE', 'RÉVISIONS', 'ÉCRITURES',
  ],
  machine: "CU3 · CENTRE D'USINAGE",
  chiffre: '7,04',
  unite: 'micro-arrêts par heure, contre moins de 0,5 ailleurs',
  pied: 'Parc de démonstration',
  aria:
    "On demande quelle machine s'arrête le plus souvent. L'IA parcourt ce " +
    "qu'elle sait lire du parc, puis répond : le centre d'usinage CU3, sept " +
    'virgule zéro quatre micro-arrêts par heure, contre moins de zéro virgule '  +
    'cinq sur les autres postes.',
};
const en = {
  question: 'Which machine stops most often?',
  bouton: 'ASK',
  pulsation: 'READING THE SITE',
  entete: '23 MACHINES · 30 DAYS',
  usages: [
    'UPTIME', 'STOPPAGES', 'MICRO-STOPPAGES',
    'AVAILABILITY', 'ALARMS', 'ACKNOWLEDGEMENTS',
    'RELIABILITY', 'COUNTERS', 'ENERGY',
    'HISTORY', 'REVISIONS', 'WRITES',
  ],
  machine: 'CU3 · MACHINING CENTRE',
  chiffre: '7.04',
  unite: 'micro-stoppages per hour, against under 0.5 elsewhere',
  pied: 'Demonstration site',
  aria:
    'Someone asks which machine stops most often. AI reads what it knows of ' +
    'the site, then answers: machining centre CU3, seven point zero four ' +
    'micro-stoppages per hour, against under zero point five elsewhere.',
};
const d = lang === 'fr' ? fr : en;

// Trois colonnes : les libelles d'usage sont plus longs qu'un code machine.
const L = 220;
const H = 46;
const EX = 20;
const EY = 16;
const X0 = 0;
const Y0 = 24;

const cases = d.usages.map((nom, i) => ({
  nom,
  i,
  x: X0 + (i % 3) * (L + EX),
  y: Y0 + Math.floor(i / 3) * (H + EY),
}));

/** Un pas de frappe par caractère. */
const PAS = d.question.length;
---

<figure class="mvf fig" role="img" aria-label={d.aria}>
  <div class="bar">
    <span class="field">
      <span class="typed">{d.question}</span><span class="caret" aria-hidden="true"></span>
    </span>
    <span class="btn">{d.bouton}</span>
  </div>

  <div class="stage">
    <div class="pulse" aria-hidden="true">
      <span class="ring ring1"></span>
      <span class="ring ring2"></span>
      <span class="ring ring3"></span>
      <span class="pulse-t">{d.pulsation}</span>
    </div>

    <svg class="grid" viewBox="0 0 700 272" preserveAspectRatio="xMidYMid meet">
      <text class="entete" x={X0} y="8">{d.entete}</text>
      {cases.map((c) => (
        <g class="cell" style={`--i: ${c.i}`}>
          <rect x={c.x} y={c.y} width={L} height={H} rx="9" />
          <text x={c.x + L / 2} y={c.y + H / 2 + 5} text-anchor="middle">{c.nom}</text>
        </g>
      ))}
    </svg>

    <div class="ans">
      <span class="ans-m">{d.machine}</span>
      <span class="ans-n">{d.chiffre}</span>
      <span class="ans-u">{d.unite}</span>
    </div>
  </div>

  <figcaption class="pied">{d.pied}</figcaption>
</figure>

<script>
  import { observerLesFigures } from './motion/observe';

  observerLesFigures();
</script>

<style define:vars={{ pas: PAS }}>
  .fig {
    margin: 2.5rem 0 0;
    padding: 0;
    max-width: 40rem;
    display: grid;
    justify-items: start;
  }

  /* Acte 1 : la barre. */
  .bar {
    display: flex;
    align-items: stretch;
    width: 100%;
    border: 1px solid var(--color-accent-border);
    border-radius: 10px;
    background: var(--color-surface);
    overflow: hidden;
  }
  .field {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0.75rem 1rem;
    font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
    color: var(--color-ink);
  }
  /* La frappe : le texte est entier dans le document, seule sa largeur visible
     avance. Un robot d'indexation lit donc la question complète. */
  .typed {
    overflow: hidden;
    white-space: nowrap;
  }
  .caret {
    flex: none;
    width: 2px;
    align-self: stretch;
    background: var(--color-accent);
    opacity: 0;
  }
  .btn {
    flex: none;
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    background: var(--color-accent);
    color: #fff;
  }

  /* Les trois actes suivants occupent la même cellule : la pulsation cède la
     place à la grille, la grille cède la place à la réponse, et rien ne se
     déplace. */
  .stage {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 15rem;
    margin-top: 1.25rem;
  }
  .stage > * {
    grid-area: 1 / 1;
  }

  .pulse {
    display: grid;
    place-items: center;
    width: 100%;
    opacity: 0;
    pointer-events: none;
  }
  .pulse > * { grid-area: 1 / 1; }
  .ring {
    display: block;
    width: 7rem;
    height: 7rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 50%;
  }
  .pulse-t {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-accent-strong);
    white-space: nowrap;
  }

  /* La grille est transitoire : elle finit à zéro, la réponse prend sa place. */
  .grid {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0;
  }
  .entete {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    fill: var(--color-muted);
  }
  /* Sans filet, un aplat à #f0f3f7 sur un fond de page à #f8f7fb est
     invisible : les cases doivent se voir pour que le passage se voie. */
  .cell rect {
    fill: var(--color-n-100);
    stroke: var(--color-line);
    stroke-width: 1;
  }
  .cell text {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    fill: var(--color-n-500);
  }

  /* Acte 4 : la réponse, seule à la fin. */
  .ans {
    display: grid;
    justify-items: center;
    gap: 0.375rem;
    text-align: center;
  }
  .ans-m {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .ans-n {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-accent-strong);
  }
  .ans-u {
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }
  .pied {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .typed {
      max-width: 100%;
      animation: aa-type 1.7s steps(var(--pas)) both;
    }
    .caret {
      animation:
        aa-caret 0.7s steps(1) 0s 3,
        aa-caret-out 1ms linear 2.1s both;
    }
    .btn { animation: aa-btn 1ms linear 1.75s both; }

    .pulse { animation: aa-fade 1.5s ease-out 2s both; }
    .ring1 { animation: aa-ring 1.5s ease-out 2s both; }
    .ring2 { animation: aa-ring 1.5s ease-out 2.2s both; }
    .ring3 { animation: aa-ring 1.5s ease-out 2.4s both; }

    /* La grille entre, se fait parcourir, puis s'efface. */
    .grid { animation: aa-grid 2.6s linear 3.4s both; }
    .cell,
    .cell rect {
      animation-duration: 700ms;
      animation-delay: calc(3.7s + var(--i, 0) * 0.09s);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      /* `both` n'est pas cosmétique : une animation terminée sans ce mode sort
         de `getAnimations()`, ce qui la rend invisible à toute vérification. */
      animation-fill-mode: both;
    }
    .cell { animation-name: aa-in; }
    .cell rect { animation-name: aa-flash; }

    .ans { animation: aa-up 500ms cubic-bezier(0.22, 1, 0.36, 1) 6s both; }
    .pied { animation: aa-in 300ms linear 6.3s both; }
  }

  @keyframes aa-type { from { max-width: 0; } to { max-width: 100%; } }
  @keyframes aa-caret { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes aa-caret-out { to { opacity: 0; } }
  @keyframes aa-btn {
    from { background: var(--color-accent-bg); color: var(--color-accent-border); }
    to { background: var(--color-accent); color: #fff; }
  }
  @keyframes aa-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes aa-fade { 0% { opacity: 0; } 20%, 70% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes aa-grid { 0% { opacity: 0; } 8%, 88% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes aa-ring {
    from { transform: scale(0.55); opacity: 0.9; }
    to { transform: scale(2.4); opacity: 0; }
  }
  @keyframes aa-flash {
    0% { fill: var(--color-n-100); }
    35% { fill: var(--color-accent-bg); }
    100% { fill: var(--color-n-100); }
  }
  @keyframes aa-up {
    from { opacity: 0; transform: translateY(0.5rem); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 700px) {
    .field { font-size: 0.875rem; }
    .btn { padding: 0 0.875rem; }
    .stage { min-height: 12rem; }
  }
</style>
