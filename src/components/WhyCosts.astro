---
/**
 * Pourquoi superviser : ce que la supervision fait gagner, dit en général.
 *
 * Remplace le 2026-09-22 le calculateur à quinze champs, puis, le même
 * jour, une première version en chiffres d'exemple (une heure par jour,
 * 13 000 € par an, deux heures de route) : un exemple chiffré se discute,
 * un gain décrit se reconnaît. Chaque gain tient en un titre, une phrase et
 * une animation :
 *
 *   temps      les arrêts, même courts, apparaissent et s'additionnent
 *   énergie    ce qui consomme hors production devient visible
 *   décisions  un indicateur suivi semaine après semaine qui progresse
 *
 * Les animations partent quand la ligne entre dans l'écran, une fois, et
 * tiennent leur dernière image. Sans script ou sous `prefers-reduced-motion`,
 * elles sont posées dans leur état final.
 *
 * Tous les dessins sont écrits en dur, sans expression conditionnelle : Astro
 * ne pose pas son attribut de portée sur un élément SVG rendu dans une
 * expression conditionnelle, et les styles de la ligne ne s'y appliqueraient
 * pas.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = (lang === 'fr' ? fr : en).why.gains as {
  key: string;
  title: string;
  body: string;
  alt: string;
}[];
const [arrets, nuit, decisions] = c;

// ── Décisions : six semaines d'un indicateur qui progresse ──────────────
const semaines = [48, 56, 61, 70, 78, 88];

// ── Micro-arrêts : vingt arrêts répartis sur une journée de production ──
const J_X0 = 20;
const J_X1 = 580;
const arretsX = Array.from({ length: 20 }, (_, i) => {
  const base = J_X0 + 18 + (i / 19) * (J_X1 - J_X0 - 36);
  return Math.round(base + Math.sin(i * 2.7) * 9);
});

// ── Nuit : cinq jours, la puissance ne retombe jamais à la veille ───────
const N_W = 600;
const N_Y_HAUT = 60; // production
const N_Y_TALON = 128; // ce qui tourne la nuit
const N_Y_VEILLE = 176; // ce qui devrait tourner
const jours = 5;
const pas = N_W / jours;
const courbe = Array.from({ length: jours * 24 + 1 }, (_, h) => {
  const heure = h % 24;
  const prod = heure >= 6 && heure < 20;
  const bruit = Math.sin(h * 1.9) * 4 + Math.sin(h * 0.7) * 3;
  const y = prod ? N_Y_HAUT + bruit : N_Y_TALON + bruit * 0.4;
  return `${((h / 24) * pas).toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
const nuits = Array.from({ length: jours }, (_, j) => ({
  x: j * pas + (20 / 24) * pas,
  w: (10 / 24) * pas,
}));
---

<section class="section" data-couts>
  <div class="wrap couts">
    <!-- 1. Les micro-arrêts -->
    <article class="cout">
      <div class="texte">
        <h2 class="gain gain--crit">{arrets.title}</h2>
        <p class="corps">{arrets.body}</p>
      </div>
      <figure class="dessin" role="img" aria-label={arrets.alt}>
        <svg viewBox="0 0 600 220" focusable="false" aria-hidden="true">
          <rect class="ma-jour" x={J_X0} y="60" width={J_X1 - J_X0} height="40" rx="8" />
          {arretsX.map((x, i) => (
            <rect class="ma-arret" x={x - 3} y="54" width="6" height="52" rx="3" style={`--i: ${i}`} />
          ))}
          <!-- Les vingt arrêts, additionnés : une heure entière. -->
          <rect class="ma-cumul-fond" x={J_X0} y="150" width={J_X1 - J_X0} height="40" rx="8" />
          <rect class="ma-cumul" x={J_X0} y="150" width={(J_X1 - J_X0) / 16} height="40" rx="8" />
          <path class="ma-fleche" d="M300 116 V140 M292 132 L300 141 L308 132" />
        </svg>
      </figure>
    </article>

    <!-- 2. La machine qui tourne la nuit -->
    <article class="cout cout--inverse">
      <div class="texte">
        <h2 class="gain gain--warn">{nuit.title}</h2>
        <p class="corps">{nuit.body}</p>
      </div>
      <figure class="dessin" role="img" aria-label={nuit.alt}>
        <svg viewBox="0 0 600 220" focusable="false" aria-hidden="true">
          {nuits.map((n) => <rect class="nu-nuit" x={n.x} y="30" width={n.w} height="170" />)}
          {nuits.map((n) => (
            <rect class="nu-perte" x={n.x} y={N_Y_TALON} width={n.w} height={N_Y_VEILLE - N_Y_TALON} />
          ))}
          <line class="nu-veille" x1="0" y1={N_Y_VEILLE} x2={N_W} y2={N_Y_VEILLE} />
          <polyline class="nu-courbe" pathLength="1" points={courbe} />
          <g class="nu-lune" transform="translate(560 26)">
            <path d="M8 -12 A13 13 0 1 0 12 8 A10 10 0 1 1 8 -12 Z" />
          </g>
        </svg>
      </figure>
    </article>

    <!-- 3. Des décisions sur des faits -->
    <article class="cout">
      <div class="texte">
        <h2 class="gain gain--accent">{decisions.title}</h2>
        <p class="corps">{decisions.body}</p>
      </div>
      <figure class="dessin" role="img" aria-label={decisions.alt}>
        <svg viewBox="0 0 600 220" focusable="false" aria-hidden="true">
          <line class="de-sol" x1="30" y1="204" x2="570" y2="204" />
          {semaines.map((v, i) => (
            <rect class="de-barre" x={50 + i * 88} y={204 - v * 1.7} width="56" height={v * 1.7} rx="8" style={`--i: ${i}`} />
          ))}
          <polyline
            class="de-tendance"
            pathLength="1"
            points={semaines.map((v, i) => `${78 + i * 88},${204 - v * 1.7 - 16}`).join(' ')}
          />
          <g transform={`translate(${78 + 5 * 88} ${204 - 88 * 1.7 - 16})`}>
            <g class="de-fleche">
              <circle r="16" />
              <path d="M-6 2 L0 -5 L6 2 M0 -5 V7" />
            </g>
          </g>
        </svg>
      </figure>
    </article>
  </div>
</section>

<script>
  // Chaque ligne s'anime quand elle entre dans l'écran, une seule fois.
  const calme = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-couts] .cout').forEach((ligne) => {
    if (calme.matches || !('IntersectionObserver' in window)) return;
    ligne.classList.add('attend');
    const obs = new IntersectionObserver(
      (entrees) => {
        if (entrees.some((e) => e.isIntersecting)) {
          ligne.classList.remove('attend');
          ligne.classList.add('vu');
          obs.disconnect();
        }
      },
      { threshold: 0.35 }
    );
    obs.observe(ligne);
  });
</script>

<style>
  .couts {
    display: grid;
    gap: 7rem;
  }
  .cout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 4rem;
    align-items: center;
  }
  .cout--inverse { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .cout--inverse .texte { order: 2; }

  .gain {
    margin: 0;
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .gain--crit { color: var(--color-crit); }
  .gain--warn { color: var(--color-warn); }
  .gain--accent { color: var(--color-accent); }
  .corps {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-ink-2);
    max-width: 34rem;
  }

  .dessin {
    margin: 0;
    padding: 2rem 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .dessin svg { display: block; width: 100%; height: auto; }

  /* ── Micro-arrêts ─────────────────────────────────────────────────── */
  .ma-jour { fill: var(--color-normal); fill-opacity: 0.85; }
  .ma-arret { fill: var(--color-crit); }
  .ma-cumul-fond { fill: var(--color-n-100); }
  .ma-cumul { fill: var(--color-crit); }
  .ma-fleche {
    fill: none;
    stroke: var(--color-n-400);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── Nuit ─────────────────────────────────────────────────────────── */
  .nu-nuit { fill: var(--color-n-150); fill-opacity: 0.7; }
  .nu-perte { fill: var(--color-warn); fill-opacity: 0.3; }
  .nu-veille {
    stroke: var(--color-n-500);
    stroke-width: 2.5;
    stroke-dasharray: 8 7;
  }
  .nu-courbe {
    fill: none;
    stroke: var(--color-brass);
    stroke-width: 4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .nu-lune path { fill: var(--color-n-400); }

  /* ── Décisions ──────────────────────────────────────────────────── */
  .de-sol { stroke: var(--color-n-200); stroke-width: 3; }
  .de-barre { fill: var(--color-accent); fill-opacity: 0.32; }
  .de-tendance {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .de-fleche circle { fill: var(--color-accent); }
  .de-fleche path {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ma-arret,
  .ma-cumul,
  .de-barre,
  .de-fleche,
  .nu-perte {
    transform-box: fill-box;
  }
  .ma-arret { transform-origin: center; }
  .ma-cumul { transform-origin: left center; }
  .nu-perte { transform-origin: bottom; }
  .de-barre { transform-origin: bottom; }
  .de-fleche { transform-origin: center; }

  /* Avant l'entrée dans l'écran, les éléments animés attendent leur tour ;
     sans script ni mouvement, la classe n'est jamais posée et tout est là. */
  .attend .ma-arret,
  .attend .ma-cumul,
  .attend .ma-fleche,
  .attend .nu-perte,
  .attend .de-barre,
  .attend .de-fleche { opacity: 0; }
  .attend .nu-courbe,
  .attend .de-tendance { stroke-dasharray: 1; stroke-dashoffset: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .vu .ma-arret {
      animation: wc-pop 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(0.2s + var(--i) * 0.09s);
    }
    .vu .ma-fleche { animation: wc-fondu 0.4s ease both 2.1s; }
    .vu .ma-cumul { animation: wc-pousse 0.9s cubic-bezier(0.22, 1, 0.36, 1) both 2.4s; }

    .vu .nu-courbe {
      stroke-dasharray: 1;
      animation: wc-trace 2.2s linear both 0.2s;
    }
    .vu .nu-perte { animation: wc-monte 0.7s cubic-bezier(0.22, 1, 0.36, 1) both 2.4s; }

    .vu .de-barre {
      animation: wc-monte 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(0.2s + var(--i) * 0.18s);
    }
    .vu .de-tendance {
      stroke-dasharray: 1;
      animation: wc-trace 1.1s ease-out both 1.4s;
    }
    .vu .de-fleche { animation: wc-pop 0.45s cubic-bezier(0.22, 1, 0.36, 1) both 2.4s; }
  }

  @media (max-width: 900px) {
    .couts { gap: 4.5rem; }
    .cout,
    .cout--inverse { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .cout--inverse .texte { order: 0; }
    .dessin { padding: 1.25rem 1rem; }
  }
</style>

<style is:global>
  @keyframes wc-pop {
    from { opacity: 0; transform: scale(0.3); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes wc-fondu {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes wc-pousse {
    from { opacity: 1; transform: scaleX(0); }
    to { opacity: 1; transform: scaleX(1); }
  }
  @keyframes wc-trace {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes wc-monte {
    from { opacity: 0; transform: scaleY(0); }
    to { opacity: 1; transform: scaleY(1); }
  }
</style>
