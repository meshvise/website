---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Trust bar / KPI strip rendue immediatement sous le hero. Sans titre
// ni eyebrow, ce n'est pas une section conceptuelle, c'est une bande
// utilitaire qui rassure avant que l'oeil descende vers ValueChain.
// 4 colonnes : delai de deploiement, protocoles natifs, ouverture BI,
// position souveraine.
const items = [
  { id: 'deploy',     icon: 'clock' },
  { id: 'protocols',  icon: 'plug'  },
  { id: 'open_data',  icon: 'db'    },
  { id: 'sovereign',  icon: 'shield'},
];
---

<section aria-label={t(lang, 'kpi_strip.aria_label')} class="border-y border-border/60" style="background:var(--color-bg-alt);">
  <div class="mx-auto max-w-6xl px-6 py-10 md:py-12">
    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-y-8 gap-x-6 lg:divide-x lg:divide-border list-none">
      {items.map((it, idx) => (
        <li class={`flex items-start gap-3 ${idx > 0 ? 'lg:pl-6' : ''}`}>
          <span class="w-9 h-9 rounded-md bg-brand-soft text-brand flex items-center justify-center shrink-0">
            {it.icon === 'clock' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
            {it.icon === 'plug' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M9 2v4M15 2v4M6 6h12v6a6 6 0 0 1-12 0V6zM12 18v4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
            {it.icon === 'db' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <ellipse cx="12" cy="5" rx="8" ry="3"/>
                <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" stroke-linecap="round"/>
              </svg>
            )}
            {it.icon === 'shield' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M12 3l8 3v6c0 4.5-3.5 8-8 9-4.5-1-8-4.5-8-9V6l8-3z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
          </span>
          <div class="min-w-0">
            <div class="text-[20px] md:text-[22px] font-semibold tracking-tight text-text leading-none" set:html={t(lang, `kpi_strip.${it.id}.metric_html`)} />
            <div class="mt-1.5 text-[10px] font-mono uppercase tracking-[0.12em] text-muted">{t(lang, `kpi_strip.${it.id}.label`)}</div>
            <div class="mt-1 text-[12.5px] text-muted-strong leading-snug" set:html={t(lang, `kpi_strip.${it.id}.detail_html`)} />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
