---
/**
 * Le formulaire de contact. Sans backend pour l'instant : il compose un
 * courriel (mailto) avec les champs saisis.
 *
 * Depuis le 2026-09-23, chaque demande dit de quoi elle parle : un champ
 * « Votre demande » (licence, exploitation déléguée, essai, démonstration,
 * autre) qui donne aussi son objet au courriel. Il est prérempli par la
 * page qui porte le formulaire (`topic`) ou par le lien qui y mène
 * (`?sujet=licence`) : le bouton « Prendre contact » de la licence arrive
 * sur la page Contact avec la licence déjà choisie.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import { t, type Lang } from '../i18n';

const TOPICS = ['licence', 'exploitation', 'essai', 'demo', 'autre'] as const;
type Topic = (typeof TOPICS)[number];

interface Props {
  lang: Lang;
  title: string;
  body: string;
  id?: string;
  /** Libellé du bouton. */
  submitKey?: string;
  /** La demande choisie d'office ; un `?sujet=` dans l'adresse l'emporte. */
  topic?: Topic;
  /** Bande graphite, comme la section IA de l'accueil. */
  dark?: boolean;
  /** Le titre est celui de la page (h1), quand le formulaire est la page. */
  main?: boolean;
}

const {
  lang,
  title,
  body,
  id = 'contact',
  submitKey = 'contact_form.submit',
  topic = 'autre',
  dark = false,
  main = false,
} = Astro.props;
const libelles = (lang === 'fr' ? fr : en).contact_form.topics as Record<Topic, string>;
const Titre = main ? 'h1' : 'h2';
---

<section id={id} class={dark ? 'section dark-block relative overflow-hidden' : 'section border-t border-line'}>
  <div class="wrap grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-5">
      <Titre class="t-page">{title}</Titre>
      <p class="t-lede mt-5">{body}</p>
    </div>
    <form class="formulaire lg:col-span-7 panel p-7 md:p-9 grid sm:grid-cols-2 gap-6" data-contact-form>
      <div class="sm:col-span-2">
        <label for={`${id}-topic`} class="field-label">{t(lang, 'contact_form.topic')}</label>
        <select id={`${id}-topic`} name="topic" class="field" data-topic>
          {TOPICS.map((k) => <option value={k} selected={k === topic}>{libelles[k]}</option>)}
        </select>
      </div>
      <div>
        <label for={`${id}-name`} class="field-label">{t(lang, 'contact_form.name')}</label>
        <input id={`${id}-name`} name="name" type="text" required placeholder={t(lang, 'contact_form.name_ph')} class="field" />
      </div>
      <div>
        <label for={`${id}-company`} class="field-label">{t(lang, 'contact_form.company')}</label>
        <input id={`${id}-company`} name="company" type="text" required placeholder={t(lang, 'contact_form.company_ph')} class="field" />
      </div>
      <div class="sm:col-span-2">
        <label for={`${id}-email`} class="field-label">{t(lang, 'contact_form.email')}</label>
        <input id={`${id}-email`} name="email" type="email" required placeholder={t(lang, 'contact_form.email_ph')} class="field" />
      </div>
      <div class="sm:col-span-2">
        <label for={`${id}-install`} class="field-label">{t(lang, 'contact_form.install')}</label>
        <textarea id={`${id}-install`} name="install" rows="3" placeholder={t(lang, 'contact_form.install_ph')} class="field resize-y"></textarea>
      </div>
      <div class="sm:col-span-2 pt-1">
        <button type="submit" class="btn btn-primary btn-lg">{t(lang, submitKey)}</button>
      </div>
    </form>
  </div>
</section>

<style>
  /* Sur une bande graphite, le bouton garde sa couleur sombre : il est posé
     sur la carte blanche du formulaire, pas sur le fond. */
  .dark-block .formulaire .btn-primary {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #fff;
  }
</style>

<script is:inline>
  (function () {
    // La demande annoncée par le lien (?sujet=licence) l'emporte sur celle
    // de la page, si elle existe dans la liste.
    var sujet = new URLSearchParams(window.location.search).get('sujet');
    document.querySelectorAll('form[data-contact-form]').forEach(function (form) {
      var choix = form.querySelector('[data-topic]');
      if (sujet && choix && choix.querySelector('option[value="' + CSS.escape(sujet) + '"]')) choix.value = sujet;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var fd = new FormData(form);
        var demande = choix ? choix.options[choix.selectedIndex].text : '';
        var body = [
          'Demande / Request: ' + demande,
          'Nom / Name: ' + (fd.get('name') || ''),
          'Entreprise / Company: ' + (fd.get('company') || ''),
          'Email: ' + (fd.get('email') || ''),
          '',
          String(fd.get('install') || ''),
        ].join('\n');
        var subject = 'Meshvise · ' + demande;
        window.location.href = 'mailto:contact@meshvise.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      });
    });
  })();
</script>
