---
/**
 * Grâce à l'IA, répondez enfin à vos questions sur l'atelier.
 *
 * Deux versions écartées avant celle-ci, et les deux erreurs valent d'être
 * retenues.
 *
 * La première expliquait : ce qu'est un référentiel, puis les dix-huit outils
 * en chasse fixe. C'était répondre à « comment ça marche » sur la page dont le
 * métier est de répondre à « qu'est-ce que j'y gagne ». `describe_vocabulary`
 * ne vend rien.
 *
 * La seconde ouvrait sur une question entre guillemets, en laissant le lecteur
 * déduire le gain. Le titre énonce désormais le gain, et les questions le
 * prouvent. « Sur l'atelier » n'est pas décoratif : sans ce complément, la
 * phrase vendrait n'importe quel produit, alors que tout l'intérêt tient à ce
 * que l'IA répond déjà sur le reste de l'entreprise.
 *
 * Chaque question est servie par un outil livré (alarm_summary, diff_revisions,
 * energy_summary, read_indicators, read_live). Le visiteur n'a pas à le savoir :
 * il reconnaît sa propre question, et c'est le seul travail qu'on lui demande.
 *
 * Les garanties (aucune écriture, la clé reste au client) ne sont pas ici.
 * Elles rassurent une direction informatique, ce qui est le travail de la page
 * Produit : l'accueil vend, la page Produit prouve.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';
import AskAnswer from './AskAnswer.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const lienGuide = `${href(lang, 'guides')}brancher-une-ia-sur-sa-supervision/`;

/** Guillemets de la langue : chevrons en français, apostrophes en anglais. */
---

<section id="assistant" class="section dark-block relative overflow-hidden">
  <div class="wrap mid">
    <h2 class="t-page head">{t(lang, 'home.ai.title')}</h2>
    <div class="ecran">
      <AskAnswer lang={lang} />
    </div>
    <a href={lienGuide} class="lien mt-8 inline-block">{t(lang, 'home.ai.cta')}</a>
  </div>
</section>

<style>
  /* Toute la section est centree : un axe unique, du titre au lien.
     Elle est la seule de l'accueil sur fond sombre : c'est l'argument fort
     de la page, et le fond marque la rupture entre les métiers, sur fond
     clair, et les fonctionnalités, sur fond blanc. L'animation garde son
     dessin clair, posée sur un panneau comme sur un écran. */
  .mid { text-align: center; }
  .head { max-width: 26ch; margin-inline: auto; margin-bottom: 0.5rem; }

  .ecran {
    max-width: 48rem;
    margin: 2.75rem auto 0;
    padding: 2.25rem 2rem 2.5rem;
    border-radius: 18px;
    background: var(--color-surface);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.06) inset,
      0 30px 70px -30px rgb(0 0 0 / 0.65);
    text-align: left;
  }
  .ecran :global(.fig) { margin-top: 0; }

  /* Le lien, lisible sur le fond sombre. */
  .lien {
    color: var(--color-accent-soft);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent-soft) 40%, transparent);
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }
  .lien:hover {
    color: #fff;
    text-decoration-color: #fff;
  }

  @media (max-width: 640px) {
    .ecran { padding: 1.5rem 1rem 1.75rem; border-radius: 14px; }
  }
</style>
