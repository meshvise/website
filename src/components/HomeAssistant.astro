---
/**
 * Les questions auxquelles l'IA sait enfin répondre.
 *
 * Première version de cette section : un titre, une explication de ce qu'est
 * un référentiel, et les seize outils en chasse fixe. Autrement dit une
 * réponse à « comment ça marche » sur la page dont le métier est de répondre
 * à « qu'est-ce que j'y gagne ». `describe_vocabulary` ne vend rien.
 *
 * Ce qui vend, c'est la question qu'on se pose et à laquelle personne ne
 * répondait. Chacune de celles qui suivent est servie par un outil livré
 * (alarm_summary, diff_revisions, energy_summary, read_indicators,
 * read_live), mais le visiteur n'a pas à le savoir : il reconnaît sa propre
 * question, et c'est le seul travail qu'on lui demande.
 *
 * Le titre EST une question, entre guillemets. C'est inhabituel pour un h2 et
 * c'est délibéré : une question reconnue arrête le défilement là où une
 * affirmation sur le produit ne l'arrête pas.
 *
 * Les garanties (aucune écriture, la clé reste au client) ne sont pas ici.
 * Elles rassurent une direction informatique, ce qui est le travail de la
 * page Produit ; l'accueil vend, la page Produit prouve.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const questions = (lang === 'fr' ? fr : en).home.ai.questions as string[];
const lienGuide = `${href(lang, 'guides')}brancher-une-ia-sur-sa-supervision/`;

/** Guillemets de la langue : français à chevrons, anglais à apostrophes. */
const [ouvre, ferme] = lang === 'fr' ? ['« ', ' »'] : ['“', '”'];
---

<section id="assistant" class="section">
  <div class="wrap">
    <h2 class="t-page ask">{t(lang, 'home.ai.title')}</h2>
    <p class="t-lede lede">{t(lang, 'home.ai.lede')}</p>

    <div class="more">
      <span class="more-label">{t(lang, 'home.ai.more_label')}</span>
      <ul class="qs">
        {questions.map((q) => (
          <li>{ouvre}{q}{ferme}</li>
        ))}
      </ul>
    </div>

    <a href={lienGuide} class="link mt-8 inline-block">{t(lang, 'home.ai.cta')}</a>
  </div>
</section>

<style>
  .ask { max-width: 22ch; }
  .lede { margin-top: 1.25rem; max-width: 48ch; }

  .more { margin-top: 3rem; }
  .more-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 1.125rem;
  }

  /* Les questions se lisent comme une liste de doléances d'atelier : une par
     ligne, dans la même graisse légère que le reste, sans encadré. Ce ne sont
     pas des fonctionnalités, ce sont des phrases que le visiteur a déjà dites. */
  .qs {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 46rem;
  }
  .qs li {
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-ink-2);
    padding: 0.55rem 0 0.55rem 1.25rem;
    border-left: 2px solid var(--color-line-strong);
  }
  .qs li + li { margin-top: 0.5rem; }

  @media (max-width: 640px) {
    .more { margin-top: 2.25rem; }
    .qs li { padding-left: 1rem; }
  }
</style>
