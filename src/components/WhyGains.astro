---
/**
 * Pourquoi superviser : ce que la supervision fait gagner, dit en général.
 *
 * Remplace le 2026-09-22 le calculateur à quinze champs, puis, le même
 * jour, une première version en chiffres d'exemple (une heure par jour,
 * 13 000 € par an, deux heures de route) : un exemple chiffré se discute,
 * un gain décrit se reconnaît.
 *
 * Même grammaire que l'accueil : un gain par bande pleine largeur, et des
 * fonds qui alternent pour que chaque partie se détache de la précédente.
 * Le troisième est graphite, comme la section IA de l'accueil : c'est le
 * gain qui conclut, et le fond marque la rupture avant « Par où commencer ».
 *
 *   arrets     les arrêts, même courts, apparaissent et s'additionnent
 *   energie    ce qui consomme hors production devient visible
 *   decisions  un indicateur suivi semaine après semaine qui progresse
 *
 * Les dessins se posent sur le fond, sans cadre (un panneau blanc a été
 * écarté sur l'accueil), en traits épais. Ils partent quand la bande entre
 * dans l'écran, une fois, et tiennent leur dernière image. Sans script ou
 * sous `prefers-reduced-motion`, ils sont posés dans leur état final.
 *
 * Tous les dessins sont écrits en dur, sans expression conditionnelle : Astro
 * ne pose pas son attribut de portée sur un élément SVG rendu dans une
 * expression conditionnelle, et les styles de la bande ne s'y appliqueraient
 * pas.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const [arrets, nuit, decisions] = (lang === 'fr' ? fr : en).why.gains as {
  key: string;
  title: string;
  body: string;
  alt: string;
}[];

// ── Arrêts : vingt arrêts répartis sur une journée de production ────────
const J_X0 = 20;
const J_X1 = 580;
const arretsX = Array.from({ length: 20 }, (_, i) => {
  const base = J_X0 + 18 + (i / 19) * (J_X1 - J_X0 - 36);
  return Math.round(base + Math.sin(i * 2.7) * 9);
});
// Additionnés, ils forment un bloc : la part de la journée qu'ils ont prise.
const CUMUL_W = (J_X1 - J_X0) / 7;

// ── Énergie : cinq jours, la puissance ne retombe jamais à la veille ────
const N_W = 600;
const N_Y_HAUT = 60; // production
const N_Y_TALON = 128; // ce qui tourne la nuit
const N_Y_VEILLE = 180; // ce qui devrait tourner
const jours = 5;
const pas = N_W / jours;
const courbe = Array.from({ length: jours * 24 + 1 }, (_, h) => {
  const heure = h % 24;
  const prod = heure >= 6 && heure < 20;
  const bruit = Math.sin(h * 1.9) * 4 + Math.sin(h * 0.7) * 3;
  const y = prod ? N_Y_HAUT + bruit : N_Y_TALON + bruit * 0.4;
  return `${((h / 24) * pas).toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
const nuits = Array.from({ length: jours }, (_, j) => ({
  x: j * pas + (20 / 24) * pas,
  w: (10 / 24) * pas,
}));

// ── Décisions : six semaines d'un indicateur qui progresse ──────────────
const semaines = [46, 54, 60, 69, 78, 90];
const D_SOL = 214;
const D_K = 1.8;
const barreX = (i: number) => 44 + i * 90;
const sommet = (v: number) => D_SOL - v * D_K;
---

<div data-gains>
  <!-- 1. Moins d'arrêts -->
  <section id="arrets" class="section bande">
    <div class="wrap ligne">
      <div class="texte">
        <h2 class="titre titre--crit">{arrets.title}</h2>
        <p class="corps">{arrets.body}</p>
      </div>
      <figure class="dessin" role="img" aria-label={arrets.alt}>
        <svg viewBox="0 0 600 240" focusable="false" aria-hidden="true">
          <rect class="ar-jour" x={J_X0} y="40" width={J_X1 - J_X0} height="52" rx="12" />
          {arretsX.map((x, i) => (
            <rect class="ar-arret" x={x - 4} y="30" width="8" height="72" rx="4" style={`--i: ${i}`} />
          ))}
          <path class="ar-fleche" d="M300 118 V150 M288 139 L300 151 L312 139" />
          <rect class="ar-cumul-fond" x={J_X0} y="170" width={J_X1 - J_X0} height="52" rx="12" />
          <rect class="ar-cumul" x={J_X0} y="170" width={CUMUL_W} height="52" rx="12" />
          <g transform={`translate(${J_X0 + CUMUL_W + 40} 196)`}>
            <g class="ar-horloge">
              <circle r="17" />
              <path d="M0 -9 V0 L7 5" />
            </g>
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <!-- 2. Moins d'énergie gaspillée -->
  <section id="energie" class="section bande bg-surface border-y border-line">
    <div class="wrap ligne ligne--inverse">
      <div class="texte">
        <h2 class="titre titre--warn">{nuit.title}</h2>
        <p class="corps">{nuit.body}</p>
      </div>
      <figure class="dessin" role="img" aria-label={nuit.alt}>
        <svg viewBox="0 0 600 220" focusable="false" aria-hidden="true">
          {nuits.map((n) => <rect class="en-nuit" x={n.x} y="24" width={n.w} height="180" rx="6" />)}
          {nuits.map((n) => (
            <rect class="en-perte" x={n.x} y={N_Y_TALON} width={n.w} height={N_Y_VEILLE - N_Y_TALON} />
          ))}
          <line class="en-veille" x1="0" y1={N_Y_VEILLE} x2={N_W} y2={N_Y_VEILLE} />
          <polyline class="en-courbe" pathLength="1" points={courbe} />
          <g class="en-lune" transform="translate(566 0)">
            <path d="M9 -2 A15 15 0 1 0 14 19 A11.5 11.5 0 1 1 9 -2 Z" transform="translate(-6 12)" />
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <!-- 3. Des décisions sur des faits -->
  <section id="decisions" class="section bande dark-block relative overflow-hidden">
    <div class="wrap ligne">
      <div class="texte">
        <h2 class="titre titre--accent">{decisions.title}</h2>
        <p class="corps">{decisions.body}</p>
      </div>
      <figure class="dessin" role="img" aria-label={decisions.alt}>
        <svg viewBox="0 0 600 240" focusable="false" aria-hidden="true">
          <line class="de-sol" x1="20" y1={D_SOL + 2} x2="580" y2={D_SOL + 2} />
          {semaines.map((v, i) => (
            <rect
              class="de-barre"
              x={barreX(i)}
              y={sommet(v)}
              width="62"
              height={v * D_K}
              rx="10"
              style={`--i: ${i}; --o: ${0.45 + i * 0.11}`}
            />
          ))}
          <polyline
            class="de-tendance"
            pathLength="1"
            points={semaines.map((v, i) => `${barreX(i) + 31},${sommet(v) - 20}`).join(' ')}
          />
          <g transform={`translate(${barreX(5) + 31} ${sommet(semaines[5]) - 20})`}>
            <g class="de-fleche">
              <circle r="19" />
              <path d="M-7 3 L0 -5 L7 3 M0 -5 V8" />
            </g>
          </g>
        </svg>
      </figure>
    </div>
  </section>
</div>

<script>
  // Chaque bande s'anime quand elle entre dans l'écran, une seule fois.
  const calme = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-gains] .ligne').forEach((ligne) => {
    if (calme.matches || !('IntersectionObserver' in window)) return;
    ligne.classList.add('attend');
    const obs = new IntersectionObserver(
      (entrees) => {
        if (entrees.some((e) => e.isIntersecting)) {
          ligne.classList.remove('attend');
          ligne.classList.add('vu');
          obs.disconnect();
        }
      },
      { threshold: 0.35 }
    );
    obs.observe(ligne);
  });
</script>

<style>
  .ligne {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 5rem;
    align-items: center;
  }
  .ligne--inverse { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .ligne--inverse .texte { order: 2; }

  .titre {
    margin: 0;
    font-size: clamp(2.5rem, 4.8vw, 3.5rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .titre--crit { color: var(--color-crit); }
  .titre--warn { color: var(--color-warn); }
  .titre--accent { color: var(--color-accent-soft); }
  .corps {
    margin-top: 1.5rem;
    font-size: 1.1875rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 30rem;
  }
  .dark-block .corps { color: var(--color-n-300); }

  .dessin { margin: 0; }
  .dessin svg { display: block; width: 100%; height: auto; overflow: visible; }

  /* ── Arrêts ───────────────────────────────────────────────────────── */
  .ar-jour { fill: var(--color-normal); }
  .ar-arret { fill: var(--color-crit); stroke: var(--color-canvas); stroke-width: 2; }
  .ar-cumul-fond { fill: var(--color-n-150); }
  .ar-cumul { fill: var(--color-crit); }
  .ar-fleche,
  .ar-horloge path {
    fill: none;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ar-fleche { stroke: var(--color-n-400); }
  .ar-horloge circle { fill: none; stroke: var(--color-crit); stroke-width: 4; }
  .ar-horloge path { stroke: var(--color-crit); }

  /* ── Énergie ──────────────────────────────────────────────────────── */
  .en-nuit { fill: var(--color-n-150); }
  .en-perte { fill: var(--color-warn); fill-opacity: 0.35; }
  .en-veille {
    stroke: var(--color-n-500);
    stroke-width: 3;
    stroke-dasharray: 9 8;
  }
  .en-courbe {
    fill: none;
    stroke: var(--color-warn);
    stroke-width: 5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .en-lune path { fill: var(--color-n-400); }

  /* ── Décisions, sur fond graphite ─────────────────────────────────── */
  .de-sol { stroke: rgb(255 255 255 / 0.28); stroke-width: 3; }
  .de-barre { fill: var(--color-accent-soft); fill-opacity: var(--o); }
  .de-tendance {
    fill: none;
    stroke: #ffffff;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .de-fleche circle { fill: var(--color-normal); }
  .de-fleche path {
    fill: none;
    stroke: #ffffff;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ar-arret,
  .ar-cumul,
  .ar-horloge,
  .de-barre,
  .de-fleche,
  .en-perte {
    transform-box: fill-box;
  }
  .ar-arret,
  .ar-horloge,
  .de-fleche { transform-origin: center; }
  .ar-cumul { transform-origin: left center; }
  .en-perte,
  .de-barre { transform-origin: bottom; }

  /* Avant l'entrée dans l'écran, les éléments animés attendent leur tour ;
     sans script ni mouvement, la classe n'est jamais posée et tout est là. */
  .attend .ar-arret,
  .attend .ar-cumul,
  .attend .ar-fleche,
  .attend .ar-horloge,
  .attend .en-perte,
  .attend .de-barre,
  .attend .de-fleche { opacity: 0; }
  .attend .en-courbe,
  .attend .de-tendance { stroke-dasharray: 1; stroke-dashoffset: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .vu .ar-arret {
      animation: wg-pop 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(0.2s + var(--i) * 0.09s);
    }
    .vu .ar-fleche { animation: wg-fondu 0.4s ease both 2.1s; }
    .vu .ar-cumul { animation: wg-pousse 0.9s cubic-bezier(0.22, 1, 0.36, 1) both 2.4s; }
    .vu .ar-horloge { animation: wg-pop 0.45s cubic-bezier(0.22, 1, 0.36, 1) both 3.2s; }

    .vu .en-courbe {
      stroke-dasharray: 1;
      animation: wg-trace 2.2s linear both 0.2s;
    }
    .vu .en-perte { animation: wg-monte 0.7s cubic-bezier(0.22, 1, 0.36, 1) both 2.4s; }

    .vu .de-barre {
      animation: wg-monte 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(0.2s + var(--i) * 0.18s);
    }
    .vu .de-tendance {
      stroke-dasharray: 1;
      animation: wg-trace 1.1s ease-out both 1.4s;
    }
    .vu .de-fleche { animation: wg-pop 0.45s cubic-bezier(0.22, 1, 0.36, 1) both 2.4s; }
  }

  @media (max-width: 900px) {
    .ligne,
    .ligne--inverse { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .ligne--inverse .texte { order: 0; }
  }
</style>

<style is:global>
  @keyframes wg-pop {
    from { opacity: 0; transform: scale(0.3); }
    to { opacity: 1; transform: none; }
  }
  @keyframes wg-fondu {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes wg-pousse {
    from { opacity: 0; transform: scaleX(0); }
    to { opacity: 1; transform: none; }
  }
  @keyframes wg-trace {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes wg-monte {
    from { opacity: 0; transform: scaleY(0); }
    to { opacity: 1; transform: none; }
  }
</style>
