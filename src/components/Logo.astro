---
/**
 * Marque Meshvise, « Signal Frame » : deux crochets encadrant un noeud qui
 * rayonne, deux arcs en dôme au-dessus, deux en dessous, un point au centre.
 *
 * Report fidèle de `MvBrandMark.vue` du produit (apps/spa/src/components/
 * brand/), lui-même issu de `markSignal` dans la charte livrée. Le site et
 * l'application affichent exactement le même dessin : c'est le premier
 * élément que voit un visiteur qui passe de l'un à l'autre.
 *
 * Trois modes, comme dans le produit :
 *   color    : dégradé bleu sur les arcs et le point, dégradé sombre sur les
 *              crochets. C'est la variante de l'en-tête.
 *   mono     : une seule couleur, héritée du contexte.
 *   reversed : blanc plein, pour les fonds sombres.
 *
 * Les bleus de la variante `color` sont ceux de la marque et n'appartiennent
 * pas au système de couleurs du site : le logo est un objet graphique, pas
 * un état de donnée.
 */
interface Props {
  class?: string;
  mode?: 'color' | 'mono' | 'reversed';
}

const { class: className = 'w-6 h-6', mode = 'mono' } = Astro.props;

// Identifiants fixes : deux marques en mode `color` sur une même page
// déclarent le même dégradé, au même contenu, donc la duplication ne change
// rien au rendu. Un identifiant tiré au hasard casserait la reproductibilité
// de la construction pour ne rien résoudre.
const uid = 'mvs';
const gradient = mode === 'color';
const flat = mode === 'reversed' ? '#ffffff' : 'currentColor';
const arcs = gradient ? `url(#${uid}-a)` : flat;
const frame = gradient ? `url(#${uid}-b)` : flat;
---

<svg
  viewBox="10 10 80 80"
  class={className}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {gradient && (
    <defs>
      <linearGradient id={`${uid}-a`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#5aa6ff" />
        <stop offset="1" stop-color="#1f6feb" />
      </linearGradient>
      <linearGradient id={`${uid}-b`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2c3f60" />
        <stop offset="1" stop-color="#0f1f33" />
      </linearGradient>
    </defs>
  )}

  <!-- Les deux crochets, en U, angles vifs et bouts arrondis. -->
  <path d="M35 16 H16 V84 H35" stroke={frame} stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M65 16 H84 V84 H65" stroke={frame} stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Les arcs de rayonnement, deux au-dessus du point, deux en dessous. -->
  <path d="M62.3,41.4 A15,15 0 0 0 37.7,41.4 M72.1,36.2 A26,26 0 0 0 27.9,36.2" stroke={arcs} stroke-width="6.5" stroke-linecap="round" />
  <path d="M62.3,58.6 A15,15 0 0 1 37.7,58.6 M72.1,63.8 A26,26 0 0 1 27.9,63.8" stroke={arcs} stroke-width="6.5" stroke-linecap="round" />

  <!-- Le noeud. -->
  <circle cx="50" cy="50" r="6" fill={arcs} />
</svg>
