---
/**
 * Page intermédiaire tant que la démonstration publique n'est pas
 * branchée. Quand elle le sera, la route `demo` pointera vers son URL.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import LiveTable from '../LiveTable.astro';
import ContactForm from '../ContactForm.astro';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<Base lang={lang} title={t(lang, 'demo_page.meta.title')} description={t(lang, 'demo_page.meta.description')}>
  <PageHero title={t(lang, 'demo_page.title')} subtitle={t(lang, 'demo_page.body')} />
  <section class="wrap py-14 md:py-20">
    <p class="t-small mb-3">{t(lang, 'home.live.caption')}</p>
    <LiveTable lang={lang} />
  </section>
  <ContactForm lang={lang} title={t(lang, 'why.cta.title')} body={t(lang, 'why.cta.body')} topic="demo" />
</Base>
