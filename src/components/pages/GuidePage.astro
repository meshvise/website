---
/**
 * Un guide. Colonne de lecture unique, sans encadré ni appel à l'action
 * intercalé : un article technique se lit d'un bout à l'autre, et ce qui
 * l'interrompt le fait abandonner.
 *
 * L'en-tête dit à qui il s'adresse et combien de temps il prend, pour que
 * celui qui n'est pas concerné referme la page tout de suite plutôt qu'après
 * trois paragraphes.
 */
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FinalCTA from '../FinalCTA.astro';
import { t, type Lang } from '../../i18n';
import { href } from '../../i18n/routes';

interface Props {
  guide: CollectionEntry<'guides'>;
  lang: Lang;
}

const { guide, lang } = Astro.props;
const { Content } = await render(guide);
const { title, description, date, audience, minutes, tags } = guide.data;
const publie = date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base lang={lang} title={`${title} · Meshvise`} description={description}>
  <article>
    <header class="wrap pt-12 pb-8 md:pt-16 md:pb-10 border-b border-line">
      <p class="t-small mb-5">
        <a href={href(lang, 'guides')} class="link">{t(lang, 'guides.back')}</a>
      </p>
      <h1 class="t-page max-w-4xl">{title}</h1>
      <p class="t-lede mt-5">{description}</p>

      <dl class="meta">
        <div>
          <dt>{t(lang, 'guides.for_whom')}</dt>
          <dd>{audience}</dd>
        </div>
        <div>
          <dt>{t(lang, 'guides.reading')}</dt>
          <dd>{minutes} {t(lang, 'guides.minutes')}</dd>
        </div>
        <div>
          <dt>{t(lang, 'guides.published')}</dt>
          <dd>{publie}</dd>
        </div>
      </dl>
    </header>

    <div class="wrap py-12 md:py-16">
      <div class="prose">
        <Content />
      </div>

      {tags.length > 0 && (
        <p class="tags">
          {tags.map((tag) => <span>{tag}</span>)}
        </p>
      )}
    </div>
  </article>

  <FinalCTA lang={lang} />
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.3rem;
  }
  .meta dd { margin: 0; font-size: 0.875rem; color: var(--color-ink-2); max-width: 44ch; }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .tags span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    border-radius: 3px;
    padding: 0.2rem 0.5rem;
  }
</style>
