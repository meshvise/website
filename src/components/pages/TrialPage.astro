---
/**
 * Essai sur vos équipements : une demande, pas un téléchargement.
 *
 * L'essai est sur devis depuis le 2026-09-22 : sa durée, son périmètre et
 * l'accompagnement se fixent selon le site. La page ne délivre donc plus de
 * licence. Le formulaire libre-service qui en envoyait une de sept jours par
 * courriel (TrialForm, route `/api/trial` du Worker, Turnstile) est retiré
 * de la page ; le Worker, son courriel de bienvenue et l'ADR-0006 côté
 * produit restent en place, à trancher à part.
 *
 * La demande passe par le même formulaire que le devis de la page Tarifs,
 * avec son propre objet de courriel.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import ContactForm from '../ContactForm.astro';
import fr from '../../i18n/fr.json';
import en from '../../i18n/en.json';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const etapes = (lang === 'fr' ? fr : en).trial.steps as { k: string; v: string }[];
---

<Base lang={lang} title={t(lang, 'trial.meta.title')} description={t(lang, 'trial.meta.description')}>
  <PageHero title={t(lang, 'trial.title')} subtitle={t(lang, 'trial.subtitle')} />

  <section class="section">
    <div class="wrap">
      <h2 class="t-section">{t(lang, 'trial.steps_title')}</h2>
      <ol class="etapes">
        {
          etapes.map((e, i) => (
            <li class="etape">
              <span class="etape-n" aria-hidden="true">{i + 1}</span>
              <h3 class="etape-k">{e.k}</h3>
              <p class="etape-v">{e.v}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <ContactForm
    lang={lang}
    id="essai"
    title={t(lang, 'trial.form_title')}
    body={t(lang, 'trial.form_body')}
    submitKey="contact_form.submit_trial"
    subjectKey="contact_form.mailto_subject_trial"
  />
</Base>

<style>
  .etapes {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .etape {
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .etape-n {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-accent-bg);
    color: var(--color-accent-strong);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .etape-k {
    margin-top: 1rem;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .etape-v {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }
  @media (max-width: 860px) {
    .etapes { grid-template-columns: minmax(0, 1fr); }
  }
</style>
