---
/**
 * Pourquoi superviser. Direct : le titre, trois coûts cachés montrés d'un
 * regard, puis la demande de démonstration.
 *
 * Le calculateur de gisements (cinq onglets, quinze champs) a été retiré le
 * 2026-09-22 : aucun visiteur ne remplit un formulaire pour apprendre ce
 * qu'il perd. « Ce qui apparaît la première semaine » faisait doublon avec
 * les trois coûts, et « Ce que Meshvise ne fait pas » parlait en négations ;
 * les deux sections sont parties avec lui.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import WhyCosts from '../WhyCosts.astro';
import ContactForm from '../ContactForm.astro';
import LogsheetBackground from '../bg/LogsheetBackground.astro';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<Base lang={lang} title={t(lang, 'why.meta.title')} description={t(lang, 'why.meta.description')}>
  <PageHero title={t(lang, 'why.hero.title')} subtitle={t(lang, 'why.hero.subtitle')}>
    <LogsheetBackground slot="bg" lang={lang} />
  </PageHero>

  <WhyCosts lang={lang} />

  <ContactForm lang={lang} title={t(lang, 'why.cta.title')} body={t(lang, 'why.cta.body')} />
</Base>
