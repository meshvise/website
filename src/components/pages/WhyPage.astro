---
/**
 * Pourquoi superviser. Direct : ce que la supervision fait gagner, en trois
 * gains, puis par où commencer.
 *
 * Construite sur la grammaire de l'accueil (2026-09-22) : une accroche au
 * format de la sienne, titre en deux temps dont la fin est à la couleur
 * d'accent, et sous elle un bloc graphite, les trois gains d'un regard, qui
 * mène chacun à sa bande. Puis une bande par gain, fonds alternés, et
 * « Par où commencer », la même section que l'accueil : le visiteur
 * convaincu y trouve toutes les suites, pas seulement un formulaire.
 *
 * Le calculateur de gisements (cinq onglets, quinze champs) a été retiré le
 * même jour : aucun visiteur ne remplit un formulaire pour apprendre ce
 * qu'il perd.
 */
import Base from '../../layouts/Base.astro';
import WhyGains from '../WhyGains.astro';
import PricingBrief from '../PricingBrief.astro';
import LogsheetBackground from '../bg/LogsheetBackground.astro';
import fr from '../../i18n/fr.json';
import en from '../../i18n/en.json';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const gains = (lang === 'fr' ? fr : en).why.gains as { key: string; title: string; short: string }[];
const ancres: Record<string, { id: string; ton: string }> = {
  arrets: { id: 'arrets', ton: 'crit' },
  nuit: { id: 'energie', ton: 'warn' },
  decisions: { id: 'decisions', ton: 'accent' },
};
---

<Base lang={lang} title={t(lang, 'why.meta.title')} description={t(lang, 'why.meta.description')}>
  <section class="relative overflow-hidden border-b border-line isolate">
    <div class="feuille absolute inset-0 -z-10 hidden lg:block"><LogsheetBackground lang={lang} /></div>
    <div class="wrap relative pt-12 pb-12 md:pt-16 md:pb-16">
      <h1 class="t-hero accroche">
        <span class="block">{t(lang, 'why.hero.lead')}</span>
        <span class="block accent">{t(lang, 'why.hero.accent')}</span>
      </h1>
      <p class="sous-titre">{t(lang, 'why.hero.subtitle')}</p>

      <nav class="apercu dark-block relative" aria-label={t(lang, 'why.hero.nav')}>
        {gains.map((g) => (
          <a href={`#${ancres[g.key].id}`} class={`porte porte--${ancres[g.key].ton}`}>
            <span class="marque" aria-hidden="true"></span>
            <span class="t-section nom">{g.title}</span>
            <span class="t-body mt-2 block">{g.short}</span>
            <span class="descend" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="20" height="20"><path d="M10 4 V15 M5 10.5 L10 15.5 L15 10.5" /></svg>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <WhyGains lang={lang} />

  <PricingBrief lang={lang} />
</Base>

<style>
  /* La feuille de relevé s'efface vers la gauche : elle reste le décor du
     statu quo sans passer sous le titre ni le sous-titre. */
  .feuille {
    -webkit-mask-image: linear-gradient(to right, transparent 42%, #000 72%);
    mask-image: linear-gradient(to right, transparent 42%, #000 72%);
  }
  .accroche { max-width: 46rem; margin: 0; }
  .accent { color: var(--color-accent); }
  .sous-titre {
    margin-top: 0.9rem;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-ink-2);
    max-width: 52ch;
  }

  /* Le bloc graphite de l'accroche, comme les deux portes de l'accueil :
     les trois gains d'un regard, chacun menant à sa bande. */
  .apercu {
    margin-top: 2.75rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 2px 4px rgb(22 27 35 / 0.10), 0 18px 40px -20px rgb(22 27 35 / 0.45);
  }
  .porte {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 120ms;
  }
  .porte + .porte { border-left: 1px solid var(--color-n-700); }
  @media (min-width: 768px) { .porte { padding: 2rem; } }
  .porte:hover { background: rgb(255 255 255 / 0.04); }
  .nom { color: var(--color-n-0); }

  .marque {
    width: 2.5rem;
    height: 4px;
    border-radius: 2px;
    margin-bottom: 1.25rem;
  }
  .porte--crit .marque { background: var(--color-crit); }
  .porte--warn .marque { background: var(--color-warn); }
  .porte--accent .marque { background: var(--color-accent-soft); }

  .descend {
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--color-accent-soft);
  }
  .descend svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms ease;
  }
  .porte:hover .descend { color: var(--color-n-0); }
  .porte:hover .descend svg { transform: translateY(3px); }

  @media (max-width: 767px) {
    .apercu { grid-template-columns: minmax(0, 1fr); }
    .porte + .porte { border-left: 0; border-top: 1px solid var(--color-n-700); }
  }
</style>
