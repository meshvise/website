---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import FAQ from '../FAQ.astro';
import FinalCTA from '../FinalCTA.astro';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<Base lang={lang} title={t(lang, 'faq.meta.title')} description={t(lang, 'faq.meta.description')}>
  <PageHero title={t(lang, 'faq.title')} subtitle={t(lang, 'faq.subtitle')} />
  <div class="pt-14 md:pt-20"><FAQ lang={lang} standalone /></div>
  <FinalCTA lang={lang} />
</Base>
