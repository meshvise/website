---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import ContactForm from '../ContactForm.astro';
import fr from '../../i18n/fr.json';
import en from '../../i18n/en.json';
import { t, type Lang } from '../../i18n';
import { href } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const whys = ['repro', 'points', 'license', 'ui'] as const;
const conditions = (lang === 'fr' ? fr : en).integrators.conditions.items as string[];
---

<Base lang={lang} title={t(lang, 'integrators.meta.title')} description={t(lang, 'integrators.meta.description')}>
  <PageHero title={t(lang, 'integrators.hero.title')} subtitle={t(lang, 'integrators.hero.subtitle')}>
    <div class="mt-7 flex flex-col sm:flex-row gap-3">
      <a href="#contact" class="btn btn-primary btn-lg">{t(lang, 'common.cta_contact')}</a>
      <a href={href(lang, 'demo')} class="btn btn-outline btn-lg">{t(lang, 'common.cta_demo')}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2 class="t-page">{t(lang, 'integrators.why.title')}</h2></div>
      <dl class="border-t border-line">
        {whys.map((k) => (
          <div class="grid sm:grid-cols-12 gap-x-10 gap-y-2 py-7 border-b border-line">
            <dt class="sm:col-span-4 text-[17px] font-medium text-ink">{t(lang, `integrators.why.${k}.title`)}</dt>
            <dd class="sm:col-span-8 t-body">{t(lang, `integrators.why.${k}.body`)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section bg-surface border-y border-line">
    <div class="wrap grid lg:grid-cols-12 gap-8">
      <div class="lg:col-span-5"><h2 class="t-page">{t(lang, 'integrators.conditions.title')}</h2></div>
      <ul class="lg:col-span-7 border-t border-line self-start">
        {conditions.map((c) => <li class="py-4 border-b border-line text-[15px] text-ink">{c}</li>)}
      </ul>
    </div>
  </section>

  <ContactForm lang={lang} title={t(lang, 'integrators.cta.title')} body={t(lang, 'integrators.cta.body')} />
</Base>
