---
import Base from '../../layouts/Base.astro';
import fr from '../../i18n/fr.json';
import en from '../../i18n/en.json';
import PageHero from '../PageHero.astro';
import ProtocolGrid from '../ProtocolGrid.astro';
import ScreenPlaceholder from '../ScreenPlaceholder.astro';
import { Image } from 'astro:assets';
import acqFr from '../../assets/screens/fr/acquisition.png';
import histFr from '../../assets/screens/fr/historisation.png';
import alarmsFr from '../../assets/screens/fr/alarmes.png';
import kpiFr from '../../assets/screens/fr/indicateurs.png';
import dashFr from '../../assets/screens/fr/tableaux.png';
import traceFr from '../../assets/screens/fr/revisions.png';
import acqEn from '../../assets/screens/en/acquisition.png';
import histEn from '../../assets/screens/en/historisation.png';
import alarmsEn from '../../assets/screens/en/alarmes.png';
import kpiEn from '../../assets/screens/en/indicateurs.png';
import dashEn from '../../assets/screens/en/tableaux.png';
import traceEn from '../../assets/screens/en/revisions.png';
import FinalCTA from '../FinalCTA.astro';
import ProcessBackground from '../bg/ProcessBackground.astro';
import { t, type Lang } from '../../i18n';
import { href } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
/**
 * Les captures du produit, prises sur le parc de démonstration de
 * Bellecombe, une série par langue : le produit est traduit, la page
 * anglaise montre donc l'interface en anglais. C'est ici qu'elles vivent :
 * l'accueil donne envie avec des figures animées, la page Produit montre
 * l'outil.
 *
 * Pour les refaire : navigateur à 1232 × 800 px en densité 2, recadrage de
 * 976 × 610 px sans la barre latérale, le même cadre pour les six. Deux
 * écrans sont retouchés avant la prise, par masquage et rien d'autre : les
 * révisions perdent la colonne du nombre de changements et laissent leurs
 * messages revenir à la ligne (sinon le tableau défile et perd son bouton
 * de retour arrière), et la liste des pilotes ne garde que ceux qui
 * acquièrent (le 2026-09-16, six ou sept pilotes du parc étaient en échec
 * face à leur simulateur, défaut signalé à part).
 */
const CAPTURES = {
  fr: { acq: acqFr, hist: histFr, alarms: alarmsFr, kpi: kpiFr, dash: dashFr, trace: traceFr },
  en: { acq: acqEn, hist: histEn, alarms: alarmsEn, kpi: kpiEn, dash: dashEn, trace: traceEn },
} as const;
const captures = CAPTURES[lang];
type Capture = keyof typeof captures;

// La page suit la chaîne de la donnée : on la lit, on la garde, on
// surveille, on la calcule, on la montre, on la commande, on la trace.
// `shot` est une vraie capture ; `kind` un écran dessiné, gardé seulement
// là où le parc de démonstration n'a rien à montrer (aucun synoptique).
const sections: { id: string; shot?: Capture; kind?: 'synoptic' }[] = [
  { id: 'hist', shot: 'hist' },
  { id: 'alarms', shot: 'alarms' },
  { id: 'kpi', shot: 'kpi' },
  { id: 'dash', shot: 'dash' },
  { id: 'synoptic', kind: 'synoptic' },
  { id: 'live' },
  { id: 'logic' },
  { id: 'reports' },
  { id: 'trace', shot: 'trace' },
  { id: 'sec' },
  { id: 'ops' },
];

const assistantFacts = (lang === 'fr' ? fr : en).product.assistant.facts as {
  k: string;
  v: string;
}[];
---

<Base lang={lang} title={t(lang, 'product.meta.title')} description={t(lang, 'product.meta.description')}>
  <PageHero title={t(lang, 'product.hero.title')} subtitle={t(lang, 'product.hero.subtitle')}>
    <ProcessBackground slot="bg" />
    <div class="mt-7 flex flex-col sm:flex-row gap-3">
      <a href={href(lang, 'demo')} class="btn btn-primary btn-lg">{t(lang, 'common.cta_demo')}</a>
      <a href={href(lang, 'trial')} class="btn btn-outline btn-lg">{t(lang, 'common.cta_trial')}</a>
    </div>
  </PageHero>

  <section id="acquisition" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="t-page">{t(lang, 'product.acq.title')}</h2>
        <p class="t-lede">{t(lang, 'product.acq.intro')}</p>
      </div>
      <ProtocolGrid lang={lang} />
      <div class="grid gap-8 items-center lg:grid-cols-12 mt-10">
        <p class="t-body lg:col-span-5">{t(lang, 'product.acq.after')}</p>
        <figure class="lg:col-span-7 shot">
          <Image
            src={captures.acq}
            alt={t(lang, 'product.shots.acq')}
            widths={[720, 1440]}
            sizes="(max-width: 1023px) 100vw, 720px"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <div class="bg-surface border-t border-line">
    {sections.map((s) => (
      <section id={s.id} class="wrap py-16 md:py-20 border-b border-line">
        <div class={`grid gap-8 items-start ${s.shot || s.kind ? 'lg:grid-cols-12' : ''}`}>
          <div class={s.shot || s.kind ? 'lg:col-span-5' : 'max-w-3xl'}>
            <h2 class="t-section">{t(lang, `product.${s.id}.title`)}</h2>
            <p class="t-body mt-3">{t(lang, `product.${s.id}.body`)}</p>
            {s.id === 'kpi' && (
              <p class="t-body mt-4 pl-5 border-l-2 border-warn text-ink">{t(lang, 'product.kpi.wip')}</p>
            )}
          </div>
          {s.shot && (
            <figure class="lg:col-span-7 shot">
              <Image
                src={captures[s.shot]}
                alt={t(lang, `product.shots.${s.shot}`)}
                widths={[720, 1440]}
                sizes="(max-width: 1023px) 100vw, 720px"
                loading="lazy"
                decoding="async"
              />
            </figure>
          )}
          {s.kind && (
            <div class="lg:col-span-7">
              <ScreenPlaceholder kind={s.kind} lang={lang} label={t(lang, 'home.see.placeholder')} />
            </div>
          )}
        </div>
      </section>
    ))}
  </div>

  <!-- La prise pour un assistant. Section à part plutôt qu'une ligne de la
       liste ci-dessus : c'est la seule capacité du produit qui n'a aucun
       équivalent chez les supervisions établies, et elle appelle autant de
       garde-fous que de promesses. Tout ce qui est écrit ici est vérifiable
       dans le code, et rien n'anticipe : l'assistant de diagnostic et la
       question en langue naturelle n'existent pas, donc ils ne sont pas
       mentionnés. -->
  <section id="assistant" class="section border-t border-line">
    <div class="wrap">
      <div class="section-head">
        <h2 class="t-page">{t(lang, 'product.assistant.title')}</h2>
        <p class="t-lede">{t(lang, 'product.assistant.lede')}</p>
      </div>

      <dl class="facts">
        {assistantFacts.map((f) => (
          <div class="fact">
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>

      <!-- Dire ce que ce n'est pas vaut mieux que de laisser le visiteur
           l'imaginer, puis être déçu devant la démonstration. -->
      <p class="nope">{t(lang, 'product.assistant.not')}</p>

      <a href={`${href(lang, 'guides')}brancher-une-ia-sur-sa-supervision/`} class="link mt-6 inline-block">
        {t(lang, 'product.assistant.cta')}
      </a>
    </div>
  </section>

  <FinalCTA lang={lang} />
</Base>

<style>
  /* Une capture du produit : cadrée, posée sur la page, jamais recadrée à
     l'affichage. Toutes sont au même format 16:10. */
  .shot {
    margin: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-canvas);
    box-shadow:
      0 1px 2px rgb(22 27 35 / 0.04),
      0 18px 40px -22px rgb(22 27 35 / 0.22);
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;
    margin: 0;
  }
  .fact dt {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .fact dd {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-2);
  }
  /* Le filet accent marque la mise au point sans en faire un avertissement :
     ce n'est pas une réserve, c'est une définition. */
  .nope {
    margin: 2.75rem 0 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-accent);
    max-width: 68ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  @media (max-width: 780px) {
    .facts { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
