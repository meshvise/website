---
import Base from '../../layouts/Base.astro';
import fr from '../../i18n/fr.json';
import en from '../../i18n/en.json';
import PageHero from '../PageHero.astro';
import ProtocolGrid from '../ProtocolGrid.astro';
import ScreenPlaceholder from '../ScreenPlaceholder.astro';
import FinalCTA from '../FinalCTA.astro';
import ProcessBackground from '../bg/ProcessBackground.astro';
import { t, type Lang } from '../../i18n';
import { href } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
// La page suit la chaîne de la donnée : on la lit, on la garde, on
// surveille, on la calcule, on la montre, on la commande, on la trace.
const sections = [
  { id: 'hist',     kind: 'history' },
  { id: 'alarms',   kind: 'alarms' },
  { id: 'kpi',      kind: null },
  { id: 'dash',     kind: 'dashboard' },
  { id: 'synoptic', kind: 'synoptic' },
  { id: 'live',     kind: null },
  { id: 'logic',    kind: null },
  { id: 'reports',  kind: null },
  { id: 'trace',    kind: 'history' },
  { id: 'sec',      kind: null },
  { id: 'ops',      kind: null },
] as const;

const assistantFacts = (lang === 'fr' ? fr : en).product.assistant.facts as {
  k: string;
  v: string;
}[];
---

<Base lang={lang} title={t(lang, 'product.meta.title')} description={t(lang, 'product.meta.description')}>
  <PageHero title={t(lang, 'product.hero.title')} subtitle={t(lang, 'product.hero.subtitle')}>
    <ProcessBackground slot="bg" />
    <div class="mt-7 flex flex-col sm:flex-row gap-3">
      <a href={href(lang, 'demo')} class="btn btn-primary btn-lg">{t(lang, 'common.cta_demo')}</a>
      <a href={href(lang, 'trial')} class="btn btn-outline btn-lg">{t(lang, 'common.cta_trial')}</a>
    </div>
  </PageHero>

  <section id="acquisition" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="t-page">{t(lang, 'product.acq.title')}</h2>
        <p class="t-lede">{t(lang, 'product.acq.intro')}</p>
      </div>
      <ProtocolGrid lang={lang} />
      <p class="t-body mt-6 max-w-3xl">{t(lang, 'product.acq.after')}</p>
    </div>
  </section>

  <div class="bg-surface border-t border-line">
    {sections.map((s) => (
      <section id={s.id} class="wrap py-16 md:py-20 border-b border-line">
        <div class={`grid gap-8 items-start ${s.kind ? 'lg:grid-cols-12' : ''}`}>
          <div class={s.kind ? 'lg:col-span-5' : 'max-w-3xl'}>
            <h2 class="t-section">{t(lang, `product.${s.id}.title`)}</h2>
            <p class="t-body mt-3">{t(lang, `product.${s.id}.body`)}</p>
            {s.id === 'kpi' && (
              <p class="t-body mt-4 pl-5 border-l-2 border-warn text-ink">{t(lang, 'product.kpi.wip')}</p>
            )}
          </div>
          {s.kind && (
            <div class="lg:col-span-7">
              <ScreenPlaceholder kind={s.kind} lang={lang} label={t(lang, 'home.see.placeholder')} />
            </div>
          )}
        </div>
      </section>
    ))}
  </div>

  <!-- La prise pour un assistant. Section à part plutôt qu'une ligne de la
       liste ci-dessus : c'est la seule capacité du produit qui n'a aucun
       équivalent chez les supervisions établies, et elle appelle autant de
       garde-fous que de promesses. Tout ce qui est écrit ici est vérifiable
       dans le code, et rien n'anticipe : l'assistant de diagnostic et la
       question en langue naturelle n'existent pas, donc ils ne sont pas
       mentionnés. -->
  <section id="assistant" class="section border-t border-line">
    <div class="wrap">
      <div class="section-head">
        <h2 class="t-page">{t(lang, 'product.assistant.title')}</h2>
        <p class="t-lede">{t(lang, 'product.assistant.lede')}</p>
      </div>

      <dl class="facts">
        {assistantFacts.map((f) => (
          <div class="fact">
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>

      <!-- Dire ce que ce n'est pas vaut mieux que de laisser le visiteur
           l'imaginer, puis être déçu devant la démonstration. -->
      <p class="nope">{t(lang, 'product.assistant.not')}</p>

      <a href={`${href(lang, 'guides')}brancher-une-ia-sur-sa-supervision/`} class="link mt-6 inline-block">
        {t(lang, 'product.assistant.cta')}
      </a>
    </div>
  </section>

  <FinalCTA lang={lang} />
</Base>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;
    margin: 0;
  }
  .fact dt {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .fact dd {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-2);
  }
  /* Le filet accent marque la mise au point sans en faire un avertissement :
     ce n'est pas une réserve, c'est une définition. */
  .nope {
    margin: 2.75rem 0 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-accent);
    max-width: 68ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  @media (max-width: 780px) {
    .facts { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
