---
/**
 * La seule séquence numérotée du site : quatre étapes dans l'ordre.
 */
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const steps = ['install', 'connect', 'organize', 'watch'] as const;
---

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 class="t-page">{t(lang, 'home.how.title')}</h2>
      <p class="t-lede">{t(lang, 'home.how.subtitle')}</p>
    </div>
    <ol class="grid md:grid-cols-4 border-t border-line">
      {steps.map((s, i) => (
        <li class={`py-6 pr-6 border-b md:border-b-0 border-line ${i > 0 ? 'md:pl-6 md:border-l' : ''}`}>
          <span class="mono text-[13px] text-muted">{i + 1}</span>
          <h3 class="mt-2 text-[17px] font-medium text-ink">{t(lang, `home.how.${s}.title`)}</h3>
          <p class="t-body mt-2 text-[14px]">{t(lang, `home.how.${s}.body`)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
