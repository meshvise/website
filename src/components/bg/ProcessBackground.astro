---
/**
 * Fond de la page produit : un schéma de procédé (tuyauterie et
 * instrumentation) en filigrane. Deux cuves, une pompe, une vanne, un
 * échangeur, une chaudière, et les bulles d'instrumentation normalisées
 * TI, PI, FI, LI. C'est le vernaculaire du client, dessiné dans l'encre
 * des figures du dossier.
 */
const ink = 'var(--color-n-400)';
const bubble = (x: number, y: number, tag: string, num: string) => ({ x, y, tag, num });
const bubbles = [
  bubble(70, 96, 'LI', '101'),
  bubble(258, 196, 'PI', '102'),
  bubble(560, 150, 'TI', '103'),
  bubble(700, 296, 'FI', '104'),
  bubble(870, 96, 'LI', '105'),
  bubble(1090, 92, 'TI', '106'),
  bubble(1150, 300, 'PI', '107'),
];
---

<svg class="process-bg" viewBox="0 0 1240 400" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
  <g fill="none" stroke={ink} stroke-width="1.3" stroke-linejoin="round" stroke-linecap="round">
    <!-- Cuve T1 -->
    <path d="M90 130 V300 a15 15 0 0 0 15 15 h90 a15 15 0 0 0 15 -15 V130 a60 12 0 0 0 -120 0 Z"/>
    <ellipse cx="150" cy="130" rx="60" ry="12"/>
    <path d="M92 210 H208" stroke-dasharray="4 4"/>
    <text x="150" y="340" font-family="var(--font-mono)" font-size="11" fill={ink} stroke="none" text-anchor="middle">T1</text>
    <!-- Sortie T1 → pompe -->
    <path d="M210 260 H290"/>
    <!-- Pompe P1 -->
    <circle cx="315" cy="260" r="24"/>
    <path d="M305 250 L327 260 L305 270 Z"/>
    <path d="M315 284 V300 H295 M315 300 H335"/>
    <text x="315" y="325" font-family="var(--font-mono)" font-size="11" fill={ink} stroke="none" text-anchor="middle">P1</text>
    <!-- Pompe → vanne -->
    <path d="M339 260 H410"/>
    <!-- Vanne V1 (papillon) -->
    <path d="M410 248 L434 260 L410 272 Z M458 248 L434 260 L458 272 Z"/>
    <path d="M434 260 V236 M424 236 H444"/>
    <!-- Vanne → échangeur -->
    <path d="M458 260 H520"/>
    <!-- Échangeur E1 -->
    <rect x="520" y="200" width="170" height="110" rx="6"/>
    <path d="M520 255 H540 l14 -22 l14 44 l14 -44 l14 44 l14 -44 l14 44 l14 -44 l14 44 l14 -22 H690"/>
    <path d="M605 200 V178 M605 310 V332"/>
    <text x="605" y="352" font-family="var(--font-mono)" font-size="11" fill={ink} stroke="none" text-anchor="middle">E1</text>
    <!-- Échangeur → T2 -->
    <path d="M690 260 H760 V214 H830"/>
    <!-- Cuve T2 -->
    <path d="M830 130 V300 a15 15 0 0 0 15 15 h90 a15 15 0 0 0 15 -15 V130 a60 12 0 0 0 -120 0 Z"/>
    <ellipse cx="890" cy="130" rx="60" ry="12"/>
    <path d="M832 176 H948" stroke-dasharray="4 4"/>
    <text x="890" y="340" font-family="var(--font-mono)" font-size="11" fill={ink} stroke="none" text-anchor="middle">T2</text>
    <!-- T2 → chaudière -->
    <path d="M950 260 H1010"/>
    <!-- Chaudière B1 -->
    <rect x="1010" y="150" width="170" height="160" rx="8"/>
    <path d="M1060 290 c0 -30 20 -34 20 -58 c14 18 8 30 8 40 c10 -6 14 -14 14 -26 c22 22 18 44 -6 58 Z"/>
    <path d="M1095 150 V120 M1085 120 H1105"/>
    <text x="1095" y="335" font-family="var(--font-mono)" font-size="11" fill={ink} stroke="none" text-anchor="middle">B1</text>
    <!-- Retour chaudière → T1 (boucle haute) -->
    <path d="M1180 230 H1215 V60 H40 V190 H90"/>
    <!-- Liaisons instrumentation -->
    <path d="M70 114 V126 M258 214 V260 M560 168 V200 M700 278 V260 M870 114 V126 M1090 110 V150 M1150 282 V260" stroke-dasharray="3 3"/>
  </g>
  <!-- Bulles d'instrumentation ISA -->
  <g font-family="var(--font-mono)" font-size="9.5" fill={ink} text-anchor="middle">
    {bubbles.map((b) => (
      <>
        <circle cx={b.x} cy={b.y} r="18" fill="var(--color-surface)" stroke={ink} stroke-width="1.3"/>
        <line x1={b.x - 18} y1={b.y} x2={b.x + 18} y2={b.y} stroke={ink} stroke-width="1"/>
        <text x={b.x} y={b.y - 4}>{b.tag}</text>
        <text x={b.x} y={b.y + 12}>{b.num}</text>
      </>
    ))}
  </g>
</svg>

<style>
  /* Ancré à droite : la colonne de texte du hero occupe la gauche. */
  .process-bg { position: absolute; right: 0; bottom: 0; width: 62%; height: auto; opacity: 0.34; pointer-events: none; }
</style>
