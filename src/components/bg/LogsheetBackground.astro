---
/**
 * Fond du calculateur : une feuille de relevé de ronde, le statu quo
 * que la page combat, sous l'outil qui le remplace. Tableau horaire,
 * colonnes de paramètres, colonne visa, quelques valeurs saisies.
 */
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';

const cols = fr
  ? ['Heure', 'T° fumées °C', 'Pression bar', 'Niveau T1 %', 'Compteur kWh', 'Visa']
  : ['Time', 'Flue temp °C', 'Pressure bar', 'Level T1 %', 'Meter kWh', 'Initials'];
const hours = ['06:00', '08:00', '10:00', '12:00', '14:00', '16:00', '18:00', '20:00', '22:00', '00:00', '02:00', '04:00'];
const filled: Record<number, string[]> = {
  0: ['118', '7,0', '64', '14 021', 'JD'],
  1: ['121', '7,1', '62', '14 083', 'JD'],
  2: ['123', '7,1', '61', '14 140', 'JD'],
  3: ['', '', '', '', ''],
  4: ['119', '7,0', '58', '14 208', 'MR'],
};
const colX = [40, 140, 290, 440, 590, 760];
const ink = 'var(--color-n-400)';
---

<svg class="logsheet-bg" viewBox="0 0 880 640" preserveAspectRatio="xMaxYMid meet" aria-hidden="true" focusable="false">
  <g font-family="var(--font-mono)" fill={ink}>
    <text x="40" y="48" font-size="15" font-weight="500" letter-spacing="0.06em">{fr ? 'RELEVÉ DE RONDE · CHAUFFERIE NORD' : 'ROUND LOG SHEET · NORTH BOILER ROOM'}</text>
    <text x="40" y="72" font-size="11">{fr ? 'Semaine du ______ au ______' : 'Week from ______ to ______'}</text>
    <text x="620" y="72" font-size="11">{fr ? 'Feuille n° ____' : 'Sheet no. ____'}</text>
  </g>
  <g stroke={ink} stroke-width="1" fill="none">
    <rect x="40" y="96" width="800" height="492"/>
    <line x1="40" y1="128" x2="840" y2="128" stroke-width="1.5"/>
    {colX.slice(1).map((x) => <line x1={x - 10} y1="96" x2={x - 10} y2="588"/>)}
    {hours.map((_, i) => <line x1="40" y1={128 + (i + 1) * 38.3} x2="840" y2={128 + (i + 1) * 38.3} opacity="0.7"/>)}
  </g>
  <g font-family="var(--font-mono)" font-size="11" fill={ink}>
    {cols.map((c, i) => <text x={colX[i]} y="118" font-weight="500">{c}</text>)}
    {hours.map((h, i) => (
      <>
        <text x="40" y={128 + i * 38.3 + 24}>{h}</text>
        {(filled[i] ?? []).map((v, j) => <text x={colX[j + 1]} y={128 + i * 38.3 + 24}>{v}</text>)}
      </>
    ))}
  </g>
  <g font-family="var(--font-mono)" font-size="11" fill={ink}>
    <text x="40" y="616">{fr ? 'Observations : ' : 'Remarks: '}<tspan x="150" text-decoration="underline">{fr ? 'compresseur 2 bruyant, à voir' : 'compressor 2 noisy, to check'}</tspan></text>
  </g>
</svg>

<style>
  .logsheet-bg { position: absolute; right: 0; top: 50%; transform: translateY(-50%); height: 118%; width: auto; max-width: 100%; opacity: 0.3; pointer-events: none; }
</style>
