---
import Logo from './Logo.astro';
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div class="wrap py-14">
    <div class="grid grid-cols-2 md:grid-cols-12 gap-10 md:gap-8">
      <div class="col-span-2 md:col-span-5">
        <a href={href(lang, 'home')} class="inline-flex items-center gap-2 text-ink">
          <Logo class="w-[26px] h-[26px] text-ink" />
          <span class="font-medium tracking-tight">Meshvise</span>
        </a>
        <p class="mt-4 t-body max-w-sm">{t(lang, 'footer.tagline')}</p>
        <p class="mt-4 text-[14px]"><a href={href(lang, 'pricing', 'continuity')} class="link">{t(lang, 'footer.continuity')}</a></p>
      </div>

      <div class="col-span-1 md:col-span-2 md:col-start-7">
        <h4 class="text-[13px] font-medium text-ink mb-3">{t(lang, 'footer.product')}</h4>
        <ul class="space-y-2.5 text-[14px]">
          <li><a href={href(lang, 'why')} class="text-ink-2 hover:text-ink">{t(lang, 'nav.why')}</a></li>
          <li><a href={href(lang, 'product')} class="text-ink-2 hover:text-ink">{t(lang, 'nav.product')}</a></li>
          <li><a href={href(lang, 'protocols')} class="text-ink-2 hover:text-ink">{t(lang, 'nav.protocols')}</a></li>
          <li><a href={href(lang, 'pricing')} class="text-ink-2 hover:text-ink">{t(lang, 'nav.pricing')}</a></li>
          <li><a href={href(lang, 'demo')} class="text-ink-2 hover:text-ink">{t(lang, 'nav.demo')}</a></li>
        </ul>
      </div>

      <div class="col-span-1 md:col-span-2">
        <h4 class="text-[13px] font-medium text-ink mb-3">{t(lang, 'footer.resources')}</h4>
        <ul class="space-y-2.5 text-[14px]">
          <li><a href={href(lang, 'integrators')} class="text-ink-2 hover:text-ink">{t(lang, 'nav.integrators')}</a></li>
          <li><a href={href(lang, 'guides')} class="text-ink-2 hover:text-ink">{t(lang, 'nav.guides')}</a></li>
          <li><a href={href(lang, 'faq')} class="text-ink-2 hover:text-ink">{t(lang, 'nav.faq')}</a></li>
          <li><a href={href(lang, 'about')} class="text-ink-2 hover:text-ink">{t(lang, 'nav.about')}</a></li>
        </ul>
      </div>

      <div class="col-span-2 md:col-span-3">
        <h4 class="text-[13px] font-medium text-ink mb-3">{t(lang, 'footer.contact')}</h4>
        <ul class="space-y-2.5 text-[14px]">
          <li><a href="mailto:contact@meshvise.com" class="mono text-ink-2 hover:text-ink">contact@meshvise.com</a></li>
          <li><a href={href(lang, 'trial')} class="text-ink-2 hover:text-ink">{t(lang, 'nav.trial')}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-line flex flex-col md:flex-row justify-between gap-2 t-small">
      <p>© {year} Meshvise. {t(lang, 'footer.rights')}</p>
      <p>{t(lang, 'footer.tech_line')}</p>
    </div>
  </div>
</footer>
