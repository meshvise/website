---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Four claims, all grounded in existing copy elsewhere on the site:
// - price_*    → personas.p4.pain (10-50k€/an), pricing.standard.price (990€)
// - ttv_*      → pricing.standard_deployment ("30 min", "4h docker")
// - footprint_*→ faq.minimum_hardware (2 vCPU / 500 pts / 30 days)
// - data_*     → sovereignty.hosting (no telemetry, air-gap)
const items = ['price', 'ttv', 'footprint', 'data'] as const;
---

<section class="px-6 py-20 md:py-24 border-t border-border/60" style="background:var(--color-bg-alt);">
  <div class="mx-auto max-w-6xl">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-text">
        {t(lang, 'stats.title')}
      </h2>
      <p class="mt-3 text-[15px] text-muted-strong leading-relaxed">
        {t(lang, 'stats.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {items.map((id) => (
        <div class="bg-surface rounded-lg border border-border p-6 flex flex-col">
          <div class="text-[36px] md:text-[40px] font-semibold tracking-tight text-brand leading-none">
            {t(lang, `stats.${id}_value`)}
          </div>
          <div class="mt-3 text-[15px] font-medium text-text leading-snug">
            {t(lang, `stats.${id}_label`)}
          </div>
          <div class="mt-2 text-[13px] text-muted leading-relaxed">
            {t(lang, `stats.${id}_note`)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
