---
/**
 * La capture du produit sur l'accueil, juste sous l'accroche : le visiteur
 * voit à quoi ressemble Meshvise avant de lire quoi que ce soit d'autre.
 *
 * Aucune capture n'est prête au 2026-09-23 : la section réserve la place,
 * dans son cadre définitif (une fenêtre d'application, en 16:10), avec un
 * emplacement neutre qui dit ce qui viendra. Pour poser la capture, importer
 * les deux images (une par langue) et les passer en `shot` depuis la page
 * d'accueil : le cadre, les ombres et les marges ne bougent pas.
 *
 * Le cadre est volontairement nu, sans barre d'adresse ni onglets : c'est
 * l'écran qui doit se voir, pas le navigateur.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  shot?: ImageMetadata;
}

const { lang, shot } = Astro.props;
---

<section class="ecran-section bg-surface border-b border-line" aria-label={t(lang, 'home.screen.label')}>
  <div class="wrap">
    <figure class="fenetre">
      <div class="barre" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      {shot ? (
        <Image src={shot} alt={t(lang, 'home.screen.alt')} class="capture" widths={[800, 1280, 1920]} sizes="(min-width: 1184px) 1104px, 100vw" loading="eager" />
      ) : (
        <div class="attente">
          <svg class="icone" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <rect x="5" y="9" width="38" height="30" rx="4" />
            <path d="M5 16 H43" />
            <path d="M13 32 L20 24 L26 29 L35 20" />
          </svg>
          <p>{t(lang, 'home.screen.placeholder')}</p>
        </div>
      )}
    </figure>
  </div>
</section>

<style>
  .ecran-section { padding: 3.5rem 0 4.5rem; }
  @media (min-width: 768px) { .ecran-section { padding: 4.5rem 0 6rem; } }

  .fenetre {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    box-shadow:
      0 2px 4px rgb(22 27 35 / 0.06),
      0 30px 60px -30px rgb(22 27 35 / 0.35);
  }
  .barre {
    display: flex;
    gap: 7px;
    align-items: center;
    height: 2.25rem;
    padding-inline: 1rem;
    background: var(--color-n-100);
    border-bottom: 1px solid var(--color-line);
  }
  .barre span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-n-300);
  }
  .capture { display: block; width: 100%; height: auto; }

  /* L'emplacement réservé : même proportion que la capture à venir, pour
     que la page ne bouge pas le jour où elle arrive. */
  .attente {
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 1rem;
    border: 2px dashed var(--color-n-200);
    border-radius: 8px;
    color: var(--color-n-500);
  }
  .attente p { margin: 0; font-size: 1rem; font-weight: 500; }
  .icone {
    width: 3rem;
    height: 3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
