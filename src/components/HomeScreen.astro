---
/**
 * La capture du produit sur l'accueil, juste sous l'accroche : le visiteur
 * voit à quoi ressemble Meshvise avant de lire quoi que ce soit d'autre.
 *
 * Aucune capture n'est prête au 2026-09-23 : la section réserve la place
 * dans son cadre définitif (ProductShot, le même que sur la page Produit).
 * Pour poser la capture, importer les deux images (une par langue) et les
 * passer en `shot` depuis la page d'accueil : le cadre, les ombres et les
 * marges ne bougent pas.
 */
import type { ImageMetadata } from 'astro';
import ProductShot from './ProductShot.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  shot?: ImageMetadata;
}

const { lang, shot } = Astro.props;
---

<section class="ecran-section bg-surface border-b border-line" aria-label={t(lang, 'home.screen.label')}>
  <div class="wrap">
    <ProductShot
      shot={shot}
      alt={t(lang, 'home.screen.alt')}
      pending={t(lang, 'home.screen.placeholder')}
      sizes="(min-width: 1184px) 1104px, 100vw"
      eager
    />
  </div>
</section>

<style>
  .ecran-section { padding: 3.5rem 0 4.5rem; }
  @media (min-width: 768px) { .ecran-section { padding: 4.5rem 0 6rem; } }
</style>
