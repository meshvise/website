---
/**
 * Les tarifs, en tableau : une colonne par offre, une ligne par contenu.
 * Tout est visible, rien n'est mis en scène.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = (lang === 'fr' ? fr : en).pricing;
const cols = [
  { id: 'demo',   href: href(lang, 'demo'),  cta: t(lang, 'common.cta_demo') },
  { id: 'trial',  href: href(lang, 'trial'), cta: t(lang, 'common.cta_trial') },
  { id: 'onprem', href: '#devis', cta: t(lang, 'pricing.cta_quote') },
] as const;
const get = (id: string) => (d as any)[id] as { name: string; price: string; period?: string; setup?: string; tagline: string; items: string[] };
---

<section class="wrap py-16 md:py-24">
  <div class="grid md:grid-cols-3 panel">
    {cols.map((c, i) => {
      const o = get(c.id);
      return (
        <div class={`flex flex-col p-6 md:p-7 ${i > 0 ? 'border-t md:border-t-0 md:border-l border-line' : ''}`}>
          <h3 class="text-[16px] font-medium text-ink">{o.name}</h3>
          <div class="mt-4 flex items-baseline gap-2">
            <span class="mono text-[30px] font-medium text-ink leading-none">{o.price}</span>
            {o.period && <span class="t-small">{o.period}</span>}
          </div>
          {o.setup && <div class="t-small mt-1.5">{o.setup}</div>}
          <p class="t-body mt-4">{o.tagline}</p>
          <ul class="mt-5 space-y-2.5 text-[14px] text-ink-2 flex-1 border-t border-line pt-5">
            {o.items.map((it) => <li class="flex gap-2.5"><span class="mt-[9px] w-1 h-1 rounded-full bg-n-400 shrink-0" aria-hidden="true"></span><span>{it}</span></li>)}
          </ul>
          <a href={c.href} class={`mt-7 btn justify-center ${c.id === 'onprem' ? 'btn-primary' : 'btn-outline'}`}>{c.cta}</a>
        </div>
      );
    })}
  </div>

  <div class="mt-4 border border-dashed border-n-300 rounded-lg p-7 md:p-8 flex flex-col md:flex-row md:items-center gap-4 md:gap-8 bg-surface">
    <div class="md:flex-1">
      <h3 class="text-[16px] font-medium text-ink">{d.managed.name}</h3>
      <div class="mono text-[20px] font-medium text-ink mt-2">{d.managed.price}</div>
      <p class="t-body mt-2">{d.managed.tagline} {d.managed.body}</p>
    </div>
    <a href="#devis" class="btn btn-outline">{t(lang, 'common.cta_contact')}</a>
  </div>

  <div class="mt-10 grid md:grid-cols-2 gap-8">
    <div>
      <h3 class="text-[16px] font-medium text-ink">{d.setup_note_title}</h3>
      <p class="t-body mt-2">{d.setup_note}</p>
    </div>
    <p class="md:text-right md:self-end text-[15px]"><a href={href(lang, 'home', 'continuity')} class="link">{d.continuity_link}</a></p>
  </div>
</section>
