---
/**
 * Les deux offres commerciales, côte à côte. La démonstration et l'essai
 * n'y figurent pas : ce ne sont pas des tarifs, ils vivent dans la
 * navigation et sur l'accueil. La colonne de droite est volontairement
 * plus courte : l'exploitation déléguée n'est pas livrable, et rien n'y
 * est promis. Le texte le dit, aucun badge n'a à le signaler.
 */
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = (lang === 'fr' ? fr : en).pricing;
---

<section class="wrap py-16 md:py-24">
  <div class="grid md:grid-cols-3 panel">
    <div class="md:col-span-2 flex flex-col p-6 md:p-8">
      <h3 class="text-[16px] font-medium text-ink">{d.onprem.name}</h3>
      <div class="mt-4 flex items-baseline gap-2">
        <span class="mono text-[30px] font-medium text-ink leading-none">{d.onprem.price}</span>
        <span class="t-small">{d.onprem.period}</span>
      </div>
      <div class="t-small mt-1.5">{d.onprem.setup}</div>
      <p class="t-body mt-4">{d.onprem.tagline}</p>
      <ul class="mt-5 space-y-2.5 text-[14px] text-ink-2 flex-1 border-t border-line pt-5">
        {d.onprem.items.map((it) => (
          <li class="flex gap-2.5">
            <span class="mt-[9px] w-1 h-1 rounded-full bg-n-400 shrink-0" aria-hidden="true"></span>
            <span>{it}</span>
          </li>
        ))}
      </ul>
      <a href="#devis" class="mt-7 btn btn-primary justify-center sm:self-start sm:px-8">{t(lang, 'pricing.cta_quote')}</a>
    </div>

    <div class="flex flex-col p-6 md:p-8 border-t md:border-t-0 md:border-l border-line bg-surface">
      <h3 class="text-[16px] font-medium text-ink">{d.managed.name}</h3>
      <div class="mt-4 mono text-[20px] font-medium text-ink leading-none">{d.managed.price}</div>
      <p class="t-body mt-4 flex-1">{d.managed.tagline} {d.managed.body}</p>
      <a href="#devis" class="mt-7 btn btn-outline justify-center">{t(lang, 'common.cta_contact')}</a>
    </div>
  </div>

  <div class="mt-10 grid md:grid-cols-2 gap-8">
    <div>
      <h3 class="text-[16px] font-medium text-ink">{d.setup_note_title}</h3>
      <p class="t-body mt-2">{d.setup_note}</p>
    </div>
    <p class="md:text-right md:self-end text-[15px]"><a href={href(lang, 'home', 'continuity')} class="link">{d.continuity_link}</a></p>
  </div>
</section>
