---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { FAQ_KEYS } from '../i18n/faq-keys';
import { t, type Lang } from '../i18n';
import { alternateHref, href } from '../i18n/routes';

interface Props {
  /** `article` sur un guide, `website` partout ailleurs. */
  ogType?: 'website' | 'article';
  /** Balisage propre à la page, ajouté à celui du site. */
  extraLd?: Record<string, unknown> | null;
  /** La page affiche la FAQ : son balisage FAQPage n'est émis que là. */
  faq?: boolean;
  title: string;
  description: string;
  lang: Lang;
  ogImage?: string;
}

const { title, description, lang, ogImage = '/og-image.svg', ogType = 'website', extraLd = null, faq = false } = Astro.props;

const SITE_ORIGIN = 'https://meshvise.com';
const alternateLang: Lang = lang === 'fr' ? 'en' : 'fr';
const currentPath = Astro.url.pathname;
const alternatePath = alternateHref(currentPath, lang, alternateLang);
const canonicalUrl = `${SITE_ORIGIN}${currentPath}`;
const alternateUrl = `${SITE_ORIGIN}${alternatePath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE_ORIGIN}${ogImage}`;
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';
const ogLocaleAlternate = alternateLang === 'fr' ? 'fr_FR' : 'en_US';

// Données structurées : tout ce qui est affirmé ici est livré et
// vérifiable (spec docs/00-vision/vitrine.md, règle « rien qui ne soit livré »).
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Meshvise',
  url: SITE_ORIGIN,
  logo: `${SITE_ORIGIN}/favicon.svg`,
  description: t(lang, 'footer.tagline'),
  email: 'contact@meshvise.com',
};

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Meshvise',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: lang === 'fr' ? 'Supervision industrielle (SCADA)' : 'Industrial supervision (SCADA)',
  operatingSystem: 'Linux, Windows, macOS (Docker)',
  description,
  url: SITE_ORIGIN,
  inLanguage: ['fr', 'en'],
  offers: [
    {
      '@type': 'Offer',
      name: t(lang, 'pricing.onprem.name'),
      price: '2400',
      priceCurrency: 'EUR',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '2400',
        priceCurrency: 'EUR',
        billingDuration: 'P1Y',
        unitText: 'YEAR',
      },
      availability: 'https://schema.org/InStock',
      url: `${SITE_ORIGIN}${href(lang, 'pricing')}`,
      description: t(lang, 'pricing.onprem.tagline'),
    },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_KEYS.map((key) => ({
    '@type': 'Question',
    name: t(lang, `faq.${key}.q`),
    acceptedAnswer: { '@type': 'Answer', text: t(lang, `faq.${key}.a`) },
  })),
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- L'icône .ico d'abord, le SVG ensuite : Chrome retient la dernière
         icône qu'il sait lire. Jusqu'au 2026-09-23, le .ico était encore
         l'icône par défaut d'Astro, et c'est elle que l'onglet montrait. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" content="#2563EB" />
    <meta name="color-scheme" content="light" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_ORIGIN}/`} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Meshvise" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(lang, 'meta.og_image_alt')} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="robots" content="index, follow, max-image-preview:large" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
    {faq && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
    {extraLd && <script type="application/ld+json" set:html={JSON.stringify(extraLd)} />}
  </head>
  <body class="bg-canvas text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-3 focus:py-2 focus:rounded-sm focus:bg-brand focus:text-white focus:font-medium"
    >
      {t(lang, 'a11y.skip_to_content')}
    </a>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
