---
/**
 * Page de jugement des figures animées, hors navigation, anglaise.
 * Le gabarit et le texte sont partagés avec la version anglaise : juger le
 * rendu anglais ne doit pas demander de maintenir une deuxième page.
 * À retirer quand les figures descendront dans les vraies pages.
 */
import Base from '../../layouts/Base.astro';
import PreviewSections from '../../components/motion/PreviewSections.astro';
import { mt as t } from '../../components/motion/text';

const lang = 'en' as const;
---

<Base lang={lang} title={t(lang, 'motion.preview.title')} description={t(lang, 'motion.preview.lede')}>
  <PreviewSections lang={lang} />
</Base>
