const lang = 'en' as const;
---

<Base
  lang={lang}
  title="Meshvise · Sovereign web SCADA, industrial gateway included, data on your premises"
  description="French web SCADA platform that reads your Modbus TCP, OPC-UA and BACnet/IP PLCs. Industrial gateway shipped turnkey with Managed plans. Data in standard PostgreSQL via ODBC for Power BI, Grafana or Excel. From €2,400/year, 7-day trial with no credit card."
>
  <Hero lang={lang} />
  <KpiStrip lang={lang} />
  <Gateway lang={lang} />
  <ValueChain lang={lang} />
  <HowItWorks lang={lang} />
  <Features lang={lang} />
  <BIPreview lang={lang} />
  <Personas lang={lang} />
  <Lifecycle lang={lang} />
  <Sovereignty lang={lang} />
  <Pricing lang={lang} />
  <FAQ lang={lang} />
  <FinalCTA lang={lang} />
</Base>

