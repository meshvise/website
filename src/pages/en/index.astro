---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import KpiStrip from '../../components/KpiStrip.astro';
import Gateway from '../../components/Gateway.astro';
import ValueChain from '../../components/ValueChain.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Features from '../../components/Features.astro';
import BIPreview from '../../components/BIPreview.astro';
import Personas from '../../components/Personas.astro';
import Lifecycle from '../../components/Lifecycle.astro';
import Sovereignty from '../../components/Sovereignty.astro';
import Pricing from '../../components/Pricing.astro';
import FAQ from '../../components/FAQ.astro';
