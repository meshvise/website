---
/*
 * Preview vitrine, variante "mosaique qui respire" : page de validation
 * interne. Hero centre sur une grille d'equipements industriels, chaque
 * tuile a un point cyan qui pulse (effet "live") et une entree en
 * cascade au chargement.
 *
 * Placeholders SVG schematiques en attendant les vrais visuels.
 */
import Base from '../../layouts/Base.astro';
import { equipItems } from '../../components/_preview-grid-data';

const lang = 'fr' as const;
---

<Base
  lang={lang}
  title="Preview vitrine, mosaique d'equipements · Meshvise"
  description="Page de validation interne pour la nouvelle vitrine."
>
  <section class="px-6 pt-12 pb-6">
    <div class="mx-auto max-w-7xl">
      <span class="section-eyebrow">Vitrine : mosaique qui respire</span>
      <h1 class="text-[40px] md:text-[52px] lg:text-[60px] font-semibold tracking-[-0.03em] leading-[1.05] text-text mt-4 max-w-4xl">
        Si ça parle un protocole industriel,<br/><span class="text-brand">Meshvise le lit.</span>
      </h1>
      <p class="mt-6 text-[17px] md:text-lg text-muted-strong leading-[1.55] max-w-2xl">
        Automates, compteurs, capteurs, groupes froids, chaudieres, variateurs : tout votre site dans une seule plateforme, en temps reel, donnees chez vous.
      </p>
    </div>
  </section>

  <section class="px-6 pb-12">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 md:gap-4">
        {equipItems.map((item, i) => (
          <div
            class="equip-tile group relative flex flex-col items-center justify-center text-center bg-surface border border-border rounded-lg px-3 py-5 transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:border-brand hover:shadow-[0_6px_18px_rgb(15_23_42_/_0.07)]"
            style={`--enter-delay: ${i * 35}ms; --pulse-delay: ${(i * 130) % 2400}ms;`}
          >
            <span class="equip-pulse absolute top-2 right-2 inline-flex h-2 w-2" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full rounded-full equip-pulse-ring"></span>
              <span class="relative inline-flex rounded-full h-2 w-2" style="background:#22D3EE;"></span>
            </span>

            <div class="w-12 h-12 md:w-14 md:h-14 text-muted-strong group-hover:text-brand transition-colors duration-200" set:html={item.svg} />

            <div class="mt-3 text-[12px] md:text-[13px] font-medium text-text leading-tight">{item.label}</div>
            <div class="mt-1 text-[10px] font-mono uppercase tracking-wide text-muted">{item.protocol}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 pb-10">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:justify-center">
        <a href={`/${lang}/trial/`} class="btn btn-primary btn-lg">
          Demarrer l'essai 7 jours
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="https://app.meshvise.com" target="_blank" rel="noopener" class="btn btn-outline btn-lg">
          Voir la demo en ligne
        </a>
      </div>

      <p class="mt-12 text-center text-[12px] text-muted">
        Page de validation interne. Les SVG sont des placeholders schematiques, a remplacer par des illustrations coherentes une fois la mise en page validee.
      </p>
    </div>
  </section>
</Base>

<style>
  .equip-tile {
    opacity: 0;
    transform: translateY(8px);
    animation: equip-tile-in 600ms cubic-bezier(0.16, 1, 0.3, 1) var(--enter-delay, 0ms) forwards;
    will-change: opacity, transform;
  }
  @keyframes equip-tile-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .equip-pulse-ring {
    background: #22D3EE;
    opacity: 0.55;
    animation: equip-pulse-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    animation-delay: var(--pulse-delay, 0ms);
  }
  @keyframes equip-pulse-ping {
    0%       { transform: scale(1);   opacity: 0.55; }
    75%, 100% { transform: scale(2.6); opacity: 0;   }
  }

  @media (prefers-reduced-motion: reduce) {
    .equip-tile {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .equip-pulse-ring { animation: none; opacity: 0.45; }
  }
</style>
