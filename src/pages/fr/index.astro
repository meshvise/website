>
  <Hero lang={lang} />
  <KpiStrip lang={lang} />
  <Gateway lang={lang} />
  <ValueChain lang={lang} />
  <HowItWorks lang={lang} />
  <Features lang={lang} />
  <BIPreview lang={lang} />
  <Personas lang={lang} />
  <Lifecycle lang={lang} />
  <Sovereignty lang={lang} />
  <Pricing lang={lang} />
